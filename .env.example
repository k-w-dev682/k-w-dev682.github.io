# PUBLIC values used by browser. No secret or password here.
# Local setup: copy as .env and fill in from Supabase Dashboard -> Project Settings -> API Keys.
# GitHub Pages: add these as GitHub Actions repository Variables, not Secrets.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
