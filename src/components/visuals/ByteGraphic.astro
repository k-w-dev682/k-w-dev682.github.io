---
import StudyFigure from './StudyFigure.astro';
---
<StudyFigure title="Bajt jako osiem bitów" eyebrow="ARCHITEKTURA KOMPUTERÓW · BITY" caption="Każde pole może być 0 albo 1. Osiem bitów daje 2⁸ = 256 możliwych kombinacji.">
  <svg viewBox="0 0 960 250" class="sl-svg" role="img" aria-label="Bajt z ośmioma bitami i wagami">
    <rect x="24" y="24" width="912" height="202" rx="22" class="sl-svg__panel" />
    <text x="48" y="60" class="sl-svg__overline">Przykładowy bajt: 01001101</text>
    <g>
      <rect x="52" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="98" y="118" text-anchor="middle" class="sl-svg__label">2⁷</text><text x="98" y="146" text-anchor="middle" class="sl-svg__value">0</text>
      <rect x="160" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="206" y="118" text-anchor="middle" class="sl-svg__label">2⁶</text><text x="206" y="146" text-anchor="middle" class="sl-svg__value">1</text>
      <rect x="268" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="314" y="118" text-anchor="middle" class="sl-svg__label">2⁵</text><text x="314" y="146" text-anchor="middle" class="sl-svg__value">0</text>
      <rect x="376" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="422" y="118" text-anchor="middle" class="sl-svg__label">2⁴</text><text x="422" y="146" text-anchor="middle" class="sl-svg__value">0</text>
      <rect x="484" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="530" y="118" text-anchor="middle" class="sl-svg__label">2³</text><text x="530" y="146" text-anchor="middle" class="sl-svg__value">1</text>
      <rect x="592" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="638" y="118" text-anchor="middle" class="sl-svg__label">2²</text><text x="638" y="146" text-anchor="middle" class="sl-svg__value">1</text>
      <rect x="700" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="746" y="118" text-anchor="middle" class="sl-svg__label">2¹</text><text x="746" y="146" text-anchor="middle" class="sl-svg__value">0</text>
      <rect x="808" y="90" width="92" height="72" rx="16" class="sl-svg__chip" /><text x="854" y="118" text-anchor="middle" class="sl-svg__label">2⁰</text><text x="854" y="146" text-anchor="middle" class="sl-svg__value">1</text>
    </g>
    <text x="50" y="198" class="sl-svg__note">Wartość dziesiętna tego bajtu: 64 + 8 + 4 + 1 = 77.</text>
  </svg>
</StudyFigure>
