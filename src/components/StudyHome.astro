---
import StudyCenterLink from './studycenter/StudyCenterLink.astro';
// StudyLab — minimalistyczna strona główna.
// Adresy uwzględniają `base` w astro.config.mjs (np. GitHub Pages /studylab/).
const base = import.meta.env.BASE_URL || '/';
const url = (route) => `${base.replace(/\/?$/, '/')}${route.replace(/^\/+/, '')}`;

const courses = [
  {
    number: '01',
    symbol: '</>',
    title: 'Programowanie C++',
    description: 'Podstawy języka, algorytmy, debugowanie i symulatory.',
    accent: '#76E2D1',
    href: 'programowanie/spis-tresci/',
  },
  {
    number: '02',
    symbol: '∑',
    title: 'Matematyka I',
    description: 'Logika, zbiory, relacje, funkcje i dziedziny.',
    accent: '#BEADFF',
    href: 'matematyka/matematyka-i/spis-tresci/',
  },
  {
    number: '03',
    symbol: '∫',
    title: 'Matematyka II',
    description: 'Ciągi, indukcja, kombinatoryka i dowody.',
    accent: '#D9B3F7',
    href: 'matematyka/matematyka-ii/spis-tresci/',
  },
  {
    number: '04',
    symbol: '▤',
    title: 'Architektura systemów komputerowych',
    description: 'Systemy liczbowe, pamięć, procesor i podstawy asemblera.',
    accent: '#A1DDB3',
    href: 'ask/spis-tresci/',
  },
  {
    number: '05',
    symbol: '↗',
    title: 'Fizyka dla informatyków',
    description: 'Kinematyka, siły, dynamika, pęd i tarcie.',
    accent: '#98CFFF',
    href: 'fizyka/spis-tresci/',
  },
  {
    number: '06',
    symbol: 'ϟ',
    title: 'Podstawy elektroniki',
    description: 'Ładunki, pole elektryczne, napięcie i kondensatory.',
    accent: '#F5C891',
    href: 'elektronika/spis-tresci/',
  },
];
---

<div class="not-content sm-home">
  <header class="sm-header">
    <p class="sm-eyebrow"><span class="sm-status" aria-hidden="true"></span> NOTATKI / SEMESTR 01</p>
    <h1>StudyLab<span aria-hidden="true">.</span></h1>
    <p class="sm-description">
      Wykłady, ćwiczenia i interaktywne laboratoria — uporządkowane w jednym miejscu.
    </p>
    <a class="sm-jump" href="#przedmioty">Przejdź do przedmiotów <span aria-hidden="true">↓</span></a>
  </header>

  <StudyCenterLink />
  <section class="sm-subjects" id="przedmioty" aria-labelledby="sm-subjects-heading">
    <div class="sm-section-heading">
      <h2 id="sm-subjects-heading">Przedmioty</h2>
      <span>{courses.length} działów</span>
    </div>
    <div class="sm-grid">
      {courses.map((course) => (
        <a
          class="sm-course"
          href={url(course.href)}
          style={`--course-accent:${course.accent}`}
          aria-label={`Otwórz: ${course.title}`}
        >
          <div class="sm-course-top">
            <span class="sm-symbol" aria-hidden="true">{course.symbol}</span>
            <span class="sm-number">{course.number}</span>
          </div>
          <h3>{course.title}</h3>
          <p>{course.description}</p>
          <div class="sm-course-bottom"><span>Otwórz dział</span><span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
  </section>
</div>

<style>
  .sm-home, .sm-home * { box-sizing: border-box; }
  .sm-home {
    color: #F4F5F6;
    background: #000;
    font-family: 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sm-header {
    padding: clamp(34px, 6vw, 68px) clamp(24px, 5vw, 56px);
    border: 1px solid #262626;
    border-radius: 20px;
    background: #070707;
  }
  .sm-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 26px;
    color: #9AA7AC;
    font: 700 .70rem/1.3 'Segoe UI', system-ui, sans-serif;
    letter-spacing: .14em;
  }
  .sm-status { width: 6px; height: 6px; background: #76E2D1; border-radius: 50%; }
  .sm-header h1 {
    color: #FDFDFD;
    font-size: clamp(2.55rem, 5.6vw, 4.2rem);
    font-weight: 760;
    letter-spacing: -.075em;
    line-height: 1.08;
    margin: 0 0 19px;
  }
  .sm-header h1 span { color: #76E2D1; }
  .sm-description {
    color: #A5ADB3;
    max-width: 590px;
    font-size: clamp(.94rem, 1.6vw, 1.06rem);
    line-height: 1.7;
    margin: 0;
  }
  .sm-jump {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    margin-top: 26px;
    padding: 11px 16px;
    border: 1px solid #3A4645;
    border-radius: 10px;
    background: #121C1B;
    color: #DAF7F2 !important;
    font-size: .86rem;
    font-weight: 650;
    text-decoration: none !important;
    transition: border-color .18s, background .18s;
  }
  .sm-jump:hover { border-color: #76E2D1; background: #1A2927; }
  .sm-subjects { padding-top: 38px; scroll-margin-top: 84px; }
  .sm-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .sm-section-heading h2 { color: #F4F4F5; margin: 0; font-size: 1.35rem; letter-spacing: -.035em; }
  .sm-section-heading span { color: #81878D; font-size: .80rem; }
  .sm-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .sm-course {
    background: #0B0B0B;
    color: #F3F4F6 !important;
    text-decoration: none !important;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 228px;
    padding: 23px;
    border-radius: 14px;
    border: 1px solid #292929;
    transition: border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .sm-course:hover { background: #101010; border-color: var(--course-accent, #76E2D1); transform: translateY(-2px); }
  .sm-course:focus-visible, .sm-jump:focus-visible { outline: 2px solid #76E2D1; outline-offset: 3px; }
  .sm-course-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .sm-symbol { color: var(--course-accent, #76E2D1); font-size: 1.4rem; line-height: 1; font-weight: 600; }
  .sm-number { color: #777C82; font: 600 .76rem/1.2 'Cascadia Code', Consolas, monospace; }
  .sm-course h3 { font-size: 1.08rem; font-weight: 680; letter-spacing: -.027em; line-height: 1.35; margin: 0 0 9px; }
  .sm-course p { color: #9FA6AC; font-size: .85rem; line-height: 1.65; margin: 0 0 19px; }
  .sm-course-bottom { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 13px; border-top: 1px solid #272727; color: var(--course-accent, #76E2D1); font-size: .77rem; font-weight: 650; }
  @media (max-width: 940px) { .sm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 590px) {
    .sm-header { padding: 29px 23px; border-radius: 15px; }
    .sm-eyebrow { margin-bottom: 20px; }
    .sm-grid { grid-template-columns: 1fr; }
    .sm-course { min-height: 174px; padding: 20px; }
    .sm-course-top { margin-bottom: 12px; }
    .sm-section-heading h2 { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-course, .sm-jump { transition: none; }
    .sm-course:hover { transform: none; }
  }
</style>
