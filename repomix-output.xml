import React, { useMemo, useState } from 'react';
import '../styles/math.css';
const range = (n, start=1) => Array.from({length:n},(_,i)=>i+start);
const choose = (n,k) => { if(k<0||k>n)return 0;let v=1;for(let i=1;i<=k;i++)v=v*(n-i+1)/i;return Math.round(v);};
const fmt = x => Number.isFinite(x) ? (Math.abs(x)<1e-12?'0':Number.parseFloat(x.toPrecision(8)).toLocaleString('pl-PL')) : '—';
function Shell({title,desc,children}){return <section className="math-lab not-content"><header className="math-lab__head"><div className="math-lab__eyebrow">◉ STUDYLAB / INTERAKTYWNA MATEMATYKA</div><h3>{title}</h3><p>{desc}</p></header><div className="math-lab__body">{children}</div></section>;}
function Stat({label,value}){return <div className="math-lab__stat"><small>{label}</small><strong>{value}</strong></div>}
function Range({label,value,min,max,step=1,onChange}){return <label>{label}: <strong>{value}</strong><input type="range" min={min} max={max} step={step} value={value} onChange={e=>onChange(Number(e.target.value))}/></label>}
function Button({children,...rest}){return <button type="button" className="math-lab__btn" {...rest}>{children}</button>}
export function SigmaLab(){const[n,setN]=useState(5);const[mode,setMode]=useState('k');const items=range(n).map(k=>mode==='sq'?k*k:mode==='const'?7:k);const sum=items.reduce((a,b)=>a+b,0);const formula=mode==='k'?`${n} · (${n} + 1) / 2 = ${sum}`:mode==='sq'?`${n} · (${n} + 1) · (2 · ${n} + 1) / 6 = ${sum}`:`7 · ${n} = ${sum}`;return <Shell title="Sigma — rozwiń sumę" desc="Przesuń suwak: zobacz, ile składników jest pod znakiem sumowania, a potem porównaj z wzorem."><div className="math-lab__inputs"><Range label="Górna granica n" min={1} max={12} value={n} onChange={setN}/><label>Co dodajemy?<select value={mode} onChange={e=>setMode(e.target.value)}><option value="k">k</option><option value="sq">k²</option><option value="const">stałą 7</option></select></label></div><div className="math-lab__numbers">{items.map((v,i)=><React.Fragment key={i}>{i>0?<span aria-hidden="true" style={{alignSelf:'center'}}>+</span>:null}<span className="math-lab__token">{v}</span></React.Fragment>)}</div><div className="math-lab__summary"><Stat label="Liczba składników" value={n}/><Stat label="Suma" value={sum}/></div><div className="math-lab__formula">{formula}</div><p className="math-lab__note">Indeks k przyjmuje kolejno wartości od 1 do n. Gdy sumujemy od 0 do n, składników jest n + 1.</p></Shell>}
export function FactorialLab(){const[n,setN]=useState(5);const values=range(n);const fact=values.reduce((a,b)=>a*b,1);return <Shell title="Silnia bez zgadywania" desc="Silnia n! to iloczyn liczb naturalnych od 1 do n. Zobacz, co dzieje się przy n = 0."><div className="math-lab__inputs"><Range label="Liczba n" min={0} max={10} value={n} onChange={setN}/></div><div className="math-lab__numbers">{n===0?<span className="math-lab__token">pusty iloczyn → 1</span>:values.map((v,i)=><React.Fragment key={v}>{i>0?' × ':''}<span className="math-lab__token">{v}</span></React.Fragment>)}</div><div className="math-lab__summary"><Stat label={`${n}!`} value={fact}/><Stat label="Liczba czynników" value={n}/></div><p className="math-lab__note">Definicja specjalna: 0! = 1. Rekurencja n! = n·(n−1)! obowiązuje dla n ≥ 1.</p></Shell>}
export function RecurrenceLab(){const[a,setA]=useState(1);const[b,setB]=useState(2);const[count,setCount]=useState(7);const seq=[a,b];for(let i=2;i<count;i++)seq.push(2*seq[i-1]+3*seq[i-2]);return <Shell title="Rekurencja: nowe wyrazy z poprzednich" desc="Wzór aₙ = 2aₙ₋₁ + 3aₙ₋₂. Zmieniaj dwa warunki początkowe i zobacz, jak zmienia się cały ciąg."><div className="math-lab__inputs"><label>a₁<input type="number" min="-9" max="9" value={a} onChange={e=>setA(Math.max(-9,Math.min(9,Number(e.target.value)||0)))}/></label><label>a₂<input type="number" min="-9" max="9" value={b} onChange={e=>setB(Math.max(-9,Math.min(9,Number(e.target.value)||0)))}/></label><Range label="Liczba wyrazów" min={3} max={9} value={count} onChange={setCount}/></div><div className="math-lab__numbers">{seq.map((v,i)=><span className="math-lab__token" key={i} title={`a${i+1}`}>{i+1}: {v}</span>)}</div><div className="math-lab__formula">a₃ = 2 · ({b}) + 3 · ({a}) = {seq[2]}</div><p className="math-lab__note">Sam wzór rekurencyjny nie wystarcza do obliczenia konkretnych wartości. Potrzebne są dwa warunki początkowe — wpisane tutaj są wyłącznie przykładem.</p></Shell>}
const toSet = xs => `{${xs.length?xs.join(', '):' '}}`;
export function SetLab(){const[a,setA]=useState([1,2,3]);const[b,setB]=useState([3,4]);const toggle=(side,v)=>{const old=side==='a'?a:b, setter=side==='a'?setA:setB;setter(old.includes(v)?old.filter(x=>x!==v):[...old,v].sort((x,y)=>x-y));};const union=[...new Set([...a,...b])].sort((x,y)=>x-y),inter=a.filter(x=>b.includes(x)),diff=a.filter(x=>!b.includes(x));return <Shell title="Zbiory — przesuwaj elementy między A i B" desc="Kliknij cyfry w zbiorach i sprawdź, jak zmieniają się suma, część wspólna i różnica."><div className="math-lab__inputs"><div style={{flex:'1 1 200px'}}><div className="math-lab__step-label">Zbiór A</div><div className="math-lab__numbers">{range(6).map(v=><button key={v} type="button" aria-pressed={a.includes(v)} className="math-lab__switch" onClick={()=>toggle('a',v)}>{v}</button>)}</div></div><div style={{flex:'1 1 200px'}}><div className="math-lab__step-label">Zbiór B</div><div className="math-lab__numbers">{range(6).map(v=><button key={v} type="button" aria-pressed={b.includes(v)} className="math-lab__switch" onClick={()=>toggle('b',v)}>{v}</button>)}</div></div></div><div className="math-lab__summary"><Stat label="A ∪ B — suma" value={toSet(union)}/><Stat label="A ∩ B — część wspólna" value={toSet(inter)}/><Stat label="A ∖ B — różnica" value={toSet(diff)}/></div><svg className="math-lab__venn" viewBox="0 0 440 190" role="img" aria-label="Diagram dwóch zbiorów A i B"><circle cx="155" cy="95" r="83" fill="#4d2a8880" stroke="#bba7ff" strokeWidth="2"/><circle cx="280" cy="95" r="83" fill="#15574c75" stroke="#6ce7d6" strokeWidth="2"/><text x="115" y="25" fill="#d9ceff" fontSize="16">A</text><text x="313" y="25" fill="#8aeade" fontSize="16">B</text><text x="111" y="102" fill="white" textAnchor="middle" fontSize="14">{a.filter(x=>!b.includes(x)).join(', ')||'∅'}</text><text x="218" y="102" fill="white" textAnchor="middle" fontSize="14">{inter.join(', ')||'∅'}</text><text x="325" y="102" fill="white" textAnchor="middle" fontSize="14">{b.filter(x=>!a.includes(x)).join(', ')||'∅'}</text></svg></Shell>}
export function PowerSetLab(){const[n,setN]=useState(3);const[active,setActive]=useState(0);const count=2**n;const safeActive=active%count;const subsets=range(count,0).map(mask=>range(n).filter((_,i)=>mask&(1<<i)));return <Shell title="Zbiór potęgowy — każda decyzja podwaja liczbę możliwości" desc="Każdy element możesz wziąć lub pominąć. Zobacz wszystkie podzbiory i wybierz jeden z nich."><div className="math-lab__inputs"><Range label="Liczba elementów n" min={1} max={4} value={n} onChange={v=>{setN(v);setActive(0)}}/></div><div className="math-lab__summary"><Stat label="Liczba wszystkich podzbiorów" value={`2^${n} = ${count}`}/><Stat label="Wybrany podzbiór" value={toSet(subsets[safeActive])}/></div><div className="math-lab__numbers">{subsets.map((s,i)=><button type="button" key={i} className="math-lab__switch" aria-pressed={safeActive===i} onClick={()=>setActive(i)}>{s.length?`{${s.join(',')}}`:'∅'}</button>)}</div><p className="math-lab__note">Pamiętaj: ∅ jest pustym zbiorem, a {'{∅}'} to zbiór zawierający jeden element — zbiór pusty.</p></Shell>}
export function CartesianLab(){const[n,setN]=useState(2);const[m,setM]=useState(3);const[pair,setPair]=useState([1,1]);return <Shell title="Iloczyn kartezjański: wybierz parę" desc="Każdy punkt to para uporządkowana. Pierwszy element pochodzi z A, drugi z B."><div className="math-lab__inputs"><Range label="|A|" min={1} max={4} value={n} onChange={setN}/><Range label="|B|" min={1} max={4} value={m} onChange={setM}/></div><div className="math-lab__grid" style={{'--cols':m}}>{range(n).flatMap(i=>range(m).map(j=><button type="button" key={`${i},${j}`} className={`math-lab__cell ${pair[0]===i&&pair[1]===j?'is-selected':''}`} onClick={()=>setPair([i,j])}>({i},{String.fromCharCode(96+j)})</button>))}</div><div className="math-lab__summary"><Stat label="Liczba uporządkowanych par" value={`${n} × ${m} = ${n*m}`}/><Stat label="Kliknięta para" value={`(${Math.min(pair[0],n)},${String.fromCharCode(96+Math.min(pair[1],m))})`}/></div><p className="math-lab__note">A × B zwykle nie jest tym samym co B × A, bo zamiana współrzędnych zmienia pary.</p></Shell>}
export function InductionLab(){const[n,setN]=useState(4);const sum=n*(n+1)/2,next=(n+1)*(n+2)/2;const[stage,setStage]=useState(0);return <Shell title="Indukcja jako domino — krok po kroku" desc="Zobacz, jak z prawdziwości wzoru dla n uzasadnia się prawdziwość dla n + 1."><div className="math-lab__inputs"><Range label="Krok n" min={1} max={15} value={n} onChange={v=>{setN(v);setStage(0)}}/></div><div className="math-lab__controls"><Button disabled={stage===0} onClick={()=>setStage(v=>Math.max(0,v-1))}>← Wstecz</Button><button type="button" className="math-lab__btn math-lab__btn--primary" disabled={stage===3} onClick={()=>setStage(v=>Math.min(3,v+1))}>Następny krok →</button><Button onClick={()=>setStage(0)}>Reset</Button></div><div className="math-lab__summary"><Stat label="Stara suma 1+…+n" value={sum}/><Stat label="Nowa suma 1+…+(n+1)" value={next}/></div><div className="math-lab__formula">{[
`BAZA: n = 1 → 1 = 1 · 2 / 2`,
`ZAŁOŻENIE: 1 + ... + ${n} = ${n} · (${n}+1) / 2 = ${sum}`,
`DODAJEMY OSTATNI WYRAZ: ${sum} + (${n}+1) = ${next}`,
`UPROSZCZENIE: (${n}+1) · (${n}+2) / 2 = ${next}`
][stage]}</div><p className="math-lab__note">To wizualizacja struktury dowodu, a nie dowód poprzez sprawdzenie kilku liczb. W rzeczywistym kroku indukcyjnym używamy symbolicznego n.</p></Shell>}
export function CombinationLab(){const[n,setN]=useState(5);const[k,setK]=useState(2);const total=choose(n,k),row=range(n+1,0).map(j=>choose(n,j));return <Shell title="Symbol Newtona i trójkąt Pascala" desc="Wybierasz k elementów spośród n bez uwzględniania kolejności. Zmieniaj parametry i sprawdzaj współczynniki."><div className="math-lab__inputs"><Range label="Elementów n" min={1} max={12} value={n} onChange={v=>{setN(v);setK(Math.min(k,v))}}/><Range label="Wybieramy k" min={0} max={n} value={k} onChange={setK}/></div><div className="math-lab__numbers">{row.map((c,i)=><button className="math-lab__switch" aria-pressed={i===k} key={i} type="button" onClick={()=>setK(i)}>{c}</button>)}</div><div className="math-lab__summary"><Stat label={`Symbol Newtona (${n} nad ${k})`} value={total}/><Stat label="Sprawdzenie symetrii" value={choose(n,n-k)}/></div><div className="math-lab__formula">{n}! / ({k}! · {n-k}!) = {total}</div><p className="math-lab__note">To nie jest zwykły ułamek z n na górze i k na dole. Wybór {k} osób z {n} da {total} różnych grup.</p></Shell>}
export function PascalLab(){const[n,setN]=useState(5);const[k,setK]=useState(2);const lines=range(n+1,0).map(i=>range(i+1,0).map(j=>choose(i,j)));return <Shell title="Trójkąt Pascala — skąd biorą się liczby?" desc="Klikaj współczynniki w ostatnim wierszu. Każda liczba wewnętrzna to suma dwóch stojących nad nią."><div className="math-lab__inputs"><Range label="Ostatni wiersz n" min={2} max={9} value={n} onChange={v=>{setN(v);setK(Math.min(k,v))}}/></div><div style={{display:'grid',gap:5}}>{lines.map((line,i)=><div key={i} className="math-lab__numbers" style={{justifyContent:'center'}}>{line.map((v,j)=><button type="button" className="math-lab__switch" key={j} aria-pressed={i===n&&j===k} onClick={()=>{setN(i<2?2:i);setK(j)}}>{v}</button>)}</div>)}</div><div className="math-lab__formula">C({n},{k}) = {choose(n,k)}{k>0&&k<n?` = ${choose(n-1,k-1)} + ${choose(n-1,k)}`:''}</div></Shell>}
export function BinomialLab(){const[n,setN]=useState(3);const[a,setA]=useState(2);const[b,setB]=useState(1);const terms=range(n+1,0).map(k=>({k,c:choose(n,k),term:choose(n,k)*(a**(n-k))*(b**k)}));const sum=terms.reduce((s,t)=>s+t.term,0);return <Shell title="Dwumian Newtona — rozwiń potęgę" desc="Zmieniaj a, b i n. Każdy składnik wykorzystuje współczynnik z trójkąta Pascala."><div className="math-lab__inputs"><Range label="Potęga n" min={1} max={6} value={n} onChange={setN}/><label>Liczba a<input type="number" min="-5" max="5" value={a} onChange={e=>setA(Math.max(-5,Math.min(5,Number(e.target.value)||0)))}/></label><label>Liczba b<input type="number" min="-5" max="5" value={b} onChange={e=>setB(Math.max(-5,Math.min(5,Number(e.target.value)||0)))}/></label></div><div className="math-lab__scroll"><table className="math-lab__table"><thead><tr><th>k</th><th>Współczynnik C(n,k)</th><th>a^(n−k) · b^k</th><th>Wartość</th></tr></thead><tbody>{terms.map(t=><tr key={t.k}><td>{t.k}</td><td>{t.c}</td><td>{a}^{n-t.k} · {b}^{t.k}</td><td>{t.term}</td></tr>)}</tbody></table></div><div className="math-lab__summary"><Stat label="Suma wyrazów" value={sum}/><Stat label={`(${a} + ${b})^${n}`} value={(a+b)**n}/></div><p className="math-lab__note">W rozwinięciu wykładnik a maleje od n do 0, a wykładnik b rośnie od 0 do n.</p></Shell>}
export function GeometricLab(){const[q,setQ]=useState(2);const[n,setN]=useState(5);const terms=range(n,0).map(k=>q**k);const sum=terms.reduce((a,b)=>a+b,0),fraction=q===1?n:(1-q**n)/(1-q);return <Shell title="Szereg geometryczny — suma na żywo" desc="Kolejny wyraz uzyskujesz, mnożąc poprzedni przez q. Przy q = 1 używamy innego wzoru."><div className="math-lab__inputs"><Range label="Iloraz q" min={-2} max={3} step={.5} value={q} onChange={setQ}/><Range label="Liczba wyrazów n" min={1} max={10} value={n} onChange={setN}/></div><div className="math-lab__numbers">{terms.map((x,i)=><React.Fragment key={i}>{i>0?' + ':null}<span className={`math-lab__token ${x<0?'is-negative':''}`}>{fmt(x)}</span></React.Fragment>)}</div><div className="math-lab__summary"><Stat label="Suma obliczona składnik po składniku" value={fmt(sum)}/><Stat label="Wynik ze wzoru" value={fmt(fraction)}/></div><div className="math-lab__formula">{q===1?`q = 1 ⇒ 1 + ... + 1 (${n} razy) = ${n}`:`(1 − (${q})^${n}) / (1 − (${q})) = ${fmt(fraction)}`}</div></Shell>}
export function AlternatingLab(){const[n,setN]=useState(6);const parts=range(n).map(k=>({k,term:(k%2?1:-1)*k*k}));const cumul=parts.map((_,i)=>parts.slice(0,i+1).reduce((a,x)=>a+x.term,0));const val=cumul[n-1],theory=(n%2?1:-1)*n*(n+1)/2;return <Shell title="Naprzemienna suma kwadratów" desc="Znaki przeplatają się: plus, minus, plus, minus. Zobacz, jak zmienia się suma po dodaniu kolejnego wyrazu."><div className="math-lab__inputs"><Range label="Ostatni wyraz n" min={1} max={12} value={n} onChange={setN}/></div><div className="math-lab__scroll"><table className="math-lab__table"><thead><tr><th>k</th><th>Dodany wyraz</th><th>Suma częściowa</th></tr></thead><tbody>{parts.map((r,i)=><tr key={r.k} className={i===n-1?'is-active':''}><td>{r.k}</td><td>{r.term>0?'+':''}{r.term}</td><td>{cumul[i]}</td></tr>)}</tbody></table></div><div className="math-lab__summary"><Stat label="Obliczona suma" value={val}/><Stat label="Wartość ze wzoru" value={theory}/></div><p className="math-lab__note">Minus pochodzi z czynnika (−1)^(k−1). Przy n parzystym wynik jest ujemny.</p></Shell>}
const angleOptions=[['π/6',Math.PI/6],['π/4',Math.PI/4],['π/3',Math.PI/3],['π/2',Math.PI/2],['π',Math.PI],['2π',2*Math.PI]];
export function SineLab(){const[n,setN]=useState(4);const[idx,setIdx]=useState(1);const alpha=angleOptions[idx][1], terms=range(n).map(k=>Math.sin(k*alpha)),sum=terms.reduce((a,b)=>a+b,0),den=2*Math.sin(alpha/2),closed=Math.abs(den)<1e-10?0:(Math.cos(alpha/2)-Math.cos((n+.5)*alpha))/den;return <Shell title="Suma sinusów — sprawdź wzór" desc="Zmieniaj kąt i liczbę składników. Porównaj dodawanie sinusów ze wzorem wykorzystującym cosinus."><div className="math-lab__inputs"><Range label="Liczba składników n" min={1} max={12} value={n} onChange={setN}/><label>Kąt α<select value={idx} onChange={e=>setIdx(Number(e.target.value))}>{angleOptions.map(([name],i)=><option key={name} value={i}>{name}</option>)}</select></label></div><div className="math-lab__numbers">{terms.map((x,i)=><span className={`math-lab__token ${x<-1e-10?'is-negative':''}`} key={i}>sin({i+1}α) ≈ {fmt(x)}</span>)}</div><div className="math-lab__summary"><Stat label="Suma składników" value={fmt(sum)}/><Stat label="Wynik ze wzoru" value={fmt(closed)}/></div><p className="math-lab__note">Kąty są w radianach. Dla α = 2π mianownik wzoru jest zerowy, ale każdy składnik sin(kα) = 0, więc suma także wynosi zero. Minimalne różnice rzędu 10⁻¹⁵ wynikają z arytmetyki zmiennoprzecinkowej przeglądarki.</p></Shell>}
</file>

<file path="src/components/MathPdf.jsx">
import React, {useMemo,useState} from 'react';
import {MATH_LESSONS} from '../data/mathLessons.js';
import 'katex/dist/katex.min.css';
import '../styles/math.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const lessonUrl = slug => base+'matematyka/'+slug+'/';
const esc = s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

async function makeMathPdf(list,theme,setStatus) {
  if(!list.length)throw Error('Wybierz co najmniej jeden temat.');
  document.querySelector('#study-print-root')?.remove();
  const snippets=[];
  for (let i=0;i<list.length;i++){
    const lesson=list[i];
    setStatus(`Przygotowanie ${i+1}/${list.length}: ${lesson.title}`);
    const response=await fetch(lessonUrl(lesson.slug));
    if(!response.ok)throw Error(`Brak tematu „${lesson.title}” (${response.status}).`);
    const doc=new DOMParser().parseFromString(await response.text(),'text/html');
    const article=doc.querySelector('.sl-markdown-content');
    if(!article)throw Error(`Nie znalazłem zawartości lekcji „${lesson.title}”.`);
    const clone=article.cloneNode(true);
    clone.querySelectorAll('script, iframe, button, input, select, textarea, .study-print-toolbar, .math-export-toolbar, .math-lab__controls, .math-lab__inputs, .math-lab__switch').forEach(el=>el.remove());
    snippets.push(`<article class="study-print-article"><div class="study-print-lesson-number">${esc(lesson.section)} · ${i+1}/${list.length}</div><h1>${esc(lesson.title)}</h1><div class="study-print-prose sl-markdown-content">${clone.innerHTML}</div></article>`);
  }
  const el=document.createElement('div');
  el.id='study-print-root';
  el.className=theme==='light'?'study-print-light':'study-print-dark';
  const toc=list.map((lesson,i)=>`<li><span>${String(i+1).padStart(2,'0')}</span>${esc(lesson.title)}</li>`).join('');
  el.innerHTML=`<div class="study-print-cover"><div class="study-print-kicker">STUDYLAB / MATEMATYKA</div><h1>Matematyka<br/><em>BLACK Edition</em></h1><p>Wykłady i ćwiczenia · rozwiązania od podstaw<br/>${list.length} ${list.length===1?'temat':'tematów'} w wybranym zestawie</p><div class="study-print-toc"><h2>Spis treści</h2><ol>${toc}</ol></div><div class="study-print-cover-foot">DOKUMENT WYGENEROWANY LOKALNIE · STUDYLAB</div></div>${snippets.join('')}`;
  document.body.appendChild(el);
  document.body.classList.add('study-pdf-print');
  const cleanup=()=>{el.remove();document.body.classList.remove('study-pdf-print');window.removeEventListener('afterprint',cleanup);};
  window.addEventListener('afterprint',cleanup,{once:true});
  setStatus('Gotowe! W oknie drukowania wybierz „Zapisz jako PDF”.');
  await document.fonts.ready;
  await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
  try{window.print();}catch(error){cleanup();throw error;}
}

export default function MathPdfButton({slug,title,section='Matematyka'}) {
 const [theme,setTheme]=useState('dark');const [working,setWorking]=useState(false);const [status,setStatus]=useState('');
 const run=async()=>{setWorking(true);try{await makeMathPdf([{slug,title,section}],theme,setStatus);}catch(e){setStatus('Błąd: '+e.message);}finally{setWorking(false)}};
 return <div className="not-content study-print-toolbar math-export-toolbar" aria-label="Zapisz temat jako PDF"><div className="study-export-mini"><div><strong>↓ Zapisz ten temat jako PDF</strong><span>Wykład lub ćwiczenie · tekst i wzory w jednym pliku</span></div><div className="study-export-mini-actions"><label className="study-export-theme">Motyw<select value={theme} onChange={e=>setTheme(e.target.value)}><option value="dark">Czarny</option><option value="light">Jasny</option></select></label><button type="button" disabled={working} onClick={run}>{working?'Przygotowuję…':'Eksportuj temat'}</button><a href={lessonUrl('eksport')}>Wybierz kilka →</a></div></div>{status?<p role="status" className="study-export-status">{status}</p>:null}</div>
}

export function MathPdfCollection(){
 const all=MATH_LESSONS;
 const groups=useMemo(()=>[...new Set(all.map(l=>l.section))],[]);
 const [selected,setSelected]=useState(()=>all.filter(l=>l.slug!=='wstep').map(l=>l.slug));
 const [theme,setTheme]=useState('dark'),[working,setWorking]=useState(false),[status,setStatus]=useState('');
 const toggle=slug=>setSelected(s=>s.includes(slug)?s.filter(x=>x!==slug):[...s,slug]);
 const run=async()=>{setWorking(true);try{await makeMathPdf(all.filter(l=>selected.includes(l.slug)),theme,setStatus);}catch(e){setStatus('Błąd: '+e.message);}finally{setWorking(false);}};
 return <div className="not-content study-export-app" aria-label="Eksport matematyki do PDF"><div className="study-export-head"><div><span>BLACK EDITION / MATHEMATICS</span><h2>Stwórz własny PDF</h2><p>Wybierz wykłady, podpunkty ćwiczeń lub pojedyncze lekcje. Powstanie jedna całość z okładką, spisem treści oraz czytelnymi wzorami. Bez wysyłania materiałów na serwer.</p></div><div className="study-export-meter"><strong>{selected.length}</strong><span>wybranych<br/>tematów</span></div></div>
 <div className="study-export-controls"><button type="button" onClick={()=>setSelected(all.map(l=>l.slug))}>Zaznacz wszystkie</button><button type="button" onClick={()=>setSelected([])}>Wyczyść wybór</button><label>Motyw PDF <select value={theme} onChange={e=>setTheme(e.target.value)}><option value="dark">Czarny</option><option value="light">Jasny</option></select></label></div>
 {groups.map(section=>{const lessons=all.filter(l=>l.section===section),complete=lessons.every(l=>selected.includes(l.slug));return <div className="study-export-group" key={section}><div className="study-export-group-head"><h3>{section}</h3><button type="button" onClick={()=>setSelected(old=>complete?old.filter(x=>!lessons.some(y=>y.slug===x)):Array.from(new Set([...old,...lessons.map(x=>x.slug)])))}>{complete?'Odznacz dział':'Zaznacz dział'}</button></div><div className="study-export-checkboxes">{lessons.map(l=><label key={l.slug}><input type="checkbox" checked={selected.includes(l.slug)} onChange={()=>toggle(l.slug)}/><span>{l.title}</span></label>)}</div></div>})}
 <div className="study-export-bottom"><button type="button" disabled={working||!selected.length} onClick={run}>{working?'Składam dokument…':`↓ Zapisz ${selected.length} ${selected.length===1?'temat':'tematów'} w jednym PDF`}</button><p>W oknie drukowania wybierz <strong>„Zapisz jako PDF”</strong>. Aby zachować czarne tło, zaznacz drukowanie kolorów i grafiki tła. Symulatory są aktywne tylko na stronie — w PDF-ie zostają jako statyczne ilustracje.</p></div><p className="study-export-status" aria-live="polite">{status}</p></div>;
}
