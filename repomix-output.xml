 {key:'v4-cpp-loop',subject:'cpp',topic:'flow',create(){const n=ri(3,10),step=ri(2,4),count=Math.ceil(n/step);return mk(this.key,this.subject,this.topic,'Liczenie iteracji',`Ile razy wykona się pętla for(int i=0; i<${n}; i+=${step})?`,`Zaczynasz od i=0 i dodajesz ${step} po każdym obiegu. Pętla działa tylko gdy i<${n}. Ile obiegów wykona?`,count,'',`Kolejne wartości i na początku obiegów: ${Array.from({length:count},(_,k)=>k*step).join(', ')}. Razem ${count}.`,['Zacznij od zera.','Wypisz tylko i mniejsze niż granica.'],'petla-for');}},
 {key:'v4-m1-abs',subject:'math1',topic:'sets',create(){const x=ri(2,12);return mk(this.key,this.subject,this.topic,'Wartość bezwzględna',`Oblicz |−${x}|.`,`Wartość bezwzględna to odległość od zera. Jak daleko od zera leży liczba −${x}?`,x,'',`|−${x}|=${x}, ponieważ liczba −${x} leży ${x} jednostek od zera.`,['Wartość bezwzględna nie jest ujemna.','Odległość od zera.'],'wartosc-bezwzgledna');}},
