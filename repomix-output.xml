ding:26px;background:#0a1318}.study-export-bottom>button{font-size:.99rem;padding:14px 22px}.study-export-bottom>button:disabled,.study-export-mini-actions button:disabled{opacity:.5;cursor:not-allowed}.study-export-bottom p{font-size:.81rem;color:#b2c5c8;line-height:1.7;margin:12px 0 0}
