center;gap:12px;border:1px solid #3e3452;border-radius:12px;background:#0f1018;padding:9px 12px;font-size:.88rem}.mi-chip{background:#4b286c!important;color:#fff!important;border:1px solid #af80ec!important;border-radius:9px;min-width:44px;min-height:38px;font-size:1.1rem;font-weight:800;cursor:pointer}.mi-chip[aria-pressed="false"]{background:#262538!important;border-color:#5c566b!important}.mi-grid{display:grid;gap:10px;margin:14px 0}.mi-grid-5{grid-template-columns:repeat(5,minmax(0,1fr))}.mi-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.mi-value{border:1px solid #332b42;background:#100e17;border-radius:13px;padding:13px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:84px;gap:5px;text-align:center;overflow-wrap:anywhere}.mi-value small{font-size:.74rem;color:#b9acd2}.mi-value strong{font-size:1.25rem;color:#eadfff;font-weight:750}.mi-hint{font-size:.85rem;line-height:1.65;color:#c3bed0;margin:18px 0 0}.mi-controls{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:18px}.mi-controls label{display:flex;flex:1 1 180px;flex-direction:column;gap:7px;font-size:.8rem;color:#cbbddd}.mi-controls input:not([type=range]),.mi-controls select,.mi-controls button{background:#14101f;color:#f5f1ff;border:1px solid #6a558a;padding:.7rem;border-radius:10px;font:inherit;max-width:100%}.mi-controls input[type=range]{accent-color:#b19aff;cursor:pointer}.mi-controls button{cursor:pointer;flex:0 0 auto}.mi-venn{border:1px solid #332a46;background:#0c0b12;border-radius:14px;padding:8px;max-width:560px;margin:0 auto 16px}.mi-venn svg{display:block;width:100%;height:auto}.mi-scroll{overflow-x:auto}.mi-table{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;margin:0!important}.mi-table th,.mi-table td{padding:10px 12px;text-align:center;border-bottom:1px solid #332a42}.mi-table th{color:#bcb0d4;background:#171326}.mi-table td{color:#e8e1fa}.mi-result-cell{background:#251a38;color:#d9bcff!important;font-weight:800}.mi-flow{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap}.mi-flow>div{border:1px solid #57436e;background:#171122;border-radius:12px;padding:14px 22px;text-align:center;min-width:93px}.mi-flow small{display:block;color:#aa9cbe}.mi-flow strong{display:block;font-size:1.65rem;color:#ecdbff}.mi-flow>span{color:#b6a1de;font-weight:700}.mi-verdict{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;border-radius:12px;padding:16px;border:1px solid}.mi-verdict-ok{background:#0c2018;border-color:#316c4a;color:#a5edc0}.mi-verdict-bad{background:#271318;border-color:#8e4255;color:#ffa6b5}.mi-verdict span{font-size:.85rem}.mi-export-app{background:#06060a;border:1px solid #4d3d65;border-radius:18px;padding:1.2rem;margin:2rem 0;color:#f2eeff}.mi-export-app button{border:1px solid #74608c;border-radius:9px;background:#251a37;color:#f3eaff;padding:9px 13px;cursor:pointer}.mi-export-app button:disabled{opacity:.45;cursor:not-allowed}.mi-export-app .mi-export-primary{background:#a78bfa;color:#0b0611;font-weight:800;margin-top:20px;padding:14px}.mi-export-toolbar{border:1px solid #433258;border-radius:12px;margin:20px 0;padding:14px;background:#0b0813;display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}.mi-export-toolbar strong{color:#ded0fb}.mi-export-toolbar button,.mi-export-toolbar a{background:#332347;border:1px solid #70559d;border-radius:9px;padding:8px 12px;color:#f6edff;cursor:pointer;text-decoration:none}.mi-export-toolbar select,.mi-export-app select{background:#1e1729;color:#fff;border:1px solid #65537a;border-radius:8px;padding:7px}.mi-export-app .mi-export-row{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid #292038;font-size:.87rem}.mi-export-app .mi-export-row input{accent-color:#bb9df8}.mi-export-app .mi-export-group{margin:20px 0}.mi-export-app .mi-export-group h3{font-size:1.05rem;color:#ddc8ff;margin:12px 0}.mi-export-app .mi-export-group button{padding:5px 9px;font-size:.8rem}.mi-export-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:12px 0}.mi-export-app .mi-export-status,.mi-export-toolbar .mi-export-status{color:#dbbcff;font-size:.82rem;width:100%;margin:8px 0 0}.mi-pdf-root{display:none}.mi-export-app .mi-print-help{color:#aaa0b7;font-size:.8rem;line-height:1.6}.mi-print-root:not(.mi-print-root-active){display:none}
