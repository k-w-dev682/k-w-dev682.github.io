/* StudyLab figures / inline educational graphics */
.sl-figure{margin:1.5rem 0 2rem;border:1px solid #22323d;border-radius:22px;background:linear-gradient(155deg,#0d131b,#05070b 78%);overflow:hidden;box-shadow:0 18px 42px #0005}
