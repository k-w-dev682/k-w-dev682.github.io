<file path="src/styles/physics.css">
:root[data-theme='dark']{--ph-ice:#9edbff}
.ph-eyebrow{display:inline-flex;background:#071928;border:1px solid #1f5470;border-radius:999px;padding:.45rem .8rem;font:bold .68rem/1.4 system-ui;color:#98dcff;letter-spacing:.08em;margin:1rem 0}
