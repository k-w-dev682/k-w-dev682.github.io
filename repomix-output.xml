import AskPdfButton from '../../../components/AskPdf.jsx';
import { AssemblerLab } from '../../../components/AskLabs.jsx';

<div className="ask-eyebrow">ARCHITEKTURA SYSTEMÓW KOMPUTEROWYCH · 04 · Asembler od zera · Uzupełnienie dydaktyczne · niepotwierdzone notatkami z wykładu</div>

