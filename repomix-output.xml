import React,{useMemo,useState} from 'react';
import {PHYSICS_LESSONS} from '../data/physicsLessons.js';
import '../styles/physics.css';
import 'katex/dist/katex.min.css';
const enc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function pageRoot(){const m=window.location.pathname.match(/^(.*?\/fizyka\/)/);if(m)return window.location.origin+m[1];const base=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');return window.location.origin+base+'fizyka/'}
const pageUrl=slug=>pageRoot()+encodeURIComponent(slug)+'/';
let style=null;
function dispose(){document.getElementById('ph-print-root')?.remove();style?.remove();style=null;}
async function exportPdf(pages,theme,status){if(!pages.length)throw Error('Wybierz przynajmniej jeden temat.');dispose();const chunks=[];
 for(let i=0;i<pages.length;i++){const l=pages[i],url=l.sourceUrl||pageUrl(l.slug);status(`Pobieranie ${i+1}/${pages.length}: ${l.title}`);const res=await fetch(url,{credentials:'same-origin'});if(!res.ok)throw Error(`Lekcja „${l.title}” ma błąd ${res.status}. Adres: ${url}`);const doc=new DOMParser().parseFromString(await res.text(),'text/html');const source=doc.querySelector('.sl-markdown-content');if(!source)throw Error(`Nie znaleziono treści dla „${l.title}”. Adres: ${url}`);const node=source.cloneNode(true);node.querySelectorAll('script,button,input,select,textarea,iframe,.ph-lab,.ph-links,.ph-export-mini,.ph-export-app,.sl-anchor-link').forEach(x=>x.remove());chunks.push(`<article class="ph-print-chapter"><p class="ph-print-kicker">${enc(l.section)}</p><h1>${enc(l.title)}</h1><div class="sl-markdown-content">${node.innerHTML}</div></article>`)}
