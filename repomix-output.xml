<file path="src/styles/ask.css">
/* ASK — isolated BLACK Edition UI. Scope to .ask-* to avoid other subjects. */
.ask-eyebrow{letter-spacing:.12em;font-weight:800;font-size:.66rem;color:#94dca9;margin:1.2rem 0 1.5rem}
.ask-nav{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2.4rem;padding-top:1.3rem;border-top:1px solid #303c34}
.ask-nav a{border:1px solid #31513d;padding:.6rem .9rem;border-radius:10px;color:#a9f4c2!important;text-decoration:none!important;font-size:.86rem;font-weight:650}
.ask-equation--inline{white-space:nowrap}.ask-equation--block{max-width:100%;overflow-x:auto;margin:1.35rem 0;padding:17px;background:#101b15;border:1px solid #254633;border-left:3px solid #77dda0;border-radius:12px;color:#edf8f1}
.ask-eq-error{color:#ffb0b0}
.ask-chain{display:flex;align-items:center;gap:9px;flex-wrap:wrap;border:1px solid #2a4335;border-radius:13px;background:#0d1510;padding:13px;color:#caefd5}.ask-chain span{border:1px solid #294333;background:#172b1e;border-radius:10px;padding:10px;font-weight:650}.ask-chain b{color:#8ee8ac}
.ask-bit-groups{display:flex;gap:8px;align-items:center;flex-wrap:wrap;background:#0a1510;padding:18px;border-radius:14px;border:1px solid #264333}.ask-bit-groups span{display:grid;gap:8px;text-align:center;padding:14px 17px;color:#a0edb5;border-radius:10px;background:#173322;font-size:1.2rem;font-weight:800}.ask-bit-groups small{font-size:1rem;color:#f7d5a1}
.ask-lab{margin:25px 0;border:1px solid #345443;border-radius:19px;overflow:hidden;color:#edf8f0!important;background:linear-gradient(140deg,#101b14,#070d0a 65%);font-family:Inter,system-ui,sans-serif;box-shadow:0 15px 50px rgba(0,0,0,.18)}
.ask-lab *{box-sizing:border-box}.ask-lab-head{display:flex;align-items:center;gap:12px;padding:20px;border-bottom:1px solid #284032;background:linear-gradient(100deg,#16291d,#0b120e)}.ask-lab-dot{width:9px;height:9px;background:#8feab1;box-shadow:0 0 16px rgba(135,255,168,.55);border-radius:50%;flex:none}.ask-lab-head div{flex:1;min-width:0}.ask-lab-head h3{color:#f8fff9;font-size:1.03rem;margin:0;line-height:1.35}.ask-lab-head p{color:#afc4b7;font-size:.81rem;margin:4px 0 0}.ask-live-label{font-size:.6rem;font-weight:800;letter-spacing:.1em;color:#a2e6b7;background:#183c26;border:1px solid #2d5a3d;border-radius:7px;padding:6px 9px;white-space:nowrap}.ask-lab-body{padding:21px}
.ask-controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:14px;margin-bottom:20px}.ask-input{display:flex;flex-direction:column;gap:7px;color:#adbfaf;font-size:.79rem;font-weight:700;margin:0 0 14px}.ask-input div{display:flex;align-items:center;gap:6px}.ask-input input,.ask-input select{width:100%;min-width:0;display:block;background:#0c1610;border:1px solid #42624b;color:#f4fff5;border-radius:10px;padding:10px 12px;font:600 .97rem Inter,system-ui,sans-serif}.ask-input input:focus,.ask-input select:focus{outline:2px solid #8addae;outline-offset:2px}.ask-input small{color:#a3c1af}
.ask-bits{display:flex;gap:5px;overflow-x:auto;padding:6px 0 14px}.ask-bit{border:1px solid #3c6248;border-radius:8px;background:#193625;min-width:37px;min-height:55px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3px;color:#adf9c8;padding:7px 4px;flex:1}.ask-bit b{font-size:1.15rem}.ask-bit small{color:#8fad9b;font-size:.63rem}.ask-bit:disabled{cursor:default;opacity:1}.ask-bit:not(:disabled){cursor:pointer}.ask-bit:not(:disabled):hover{background:#235e38}.ask-bit-sign{background:#472d1a;border-color:#ad7844;color:#ffc78d}.ask-bit-sign small{color:#e4ba96}
.ask-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:12px 0}.ask-result{display:flex;flex-direction:column;justify-content:center;gap:6px;border:1px solid #2a4936;border-radius:10px;background:#122117;padding:12px;min-width:0}.ask-result span{font-size:.72rem;color:#aec7b7}.ask-result strong{font-size:1.06rem;color:#a7f2bd;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.ask-result small{font-size:.69rem;color:#a6b4aa}.ask-note{line-height:1.65;margin:14px 0 0;color:#bdd7c5;font-size:.82rem}
.ask-weights{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px;margin-bottom:12px}.ask-weights div{padding:8px 2px;border:1px solid #33473b;background:#131e17;border-radius:7px;display:flex;flex-direction:column;gap:6px;align-items:center;min-width:0}.ask-weights .active{border-color:#66a17d;background:#193928}.ask-weights span{font-size:.63rem;color:#9eb9a7}.ask-weights b{font-size:.82rem;color:#d8f8df}.ask-mini-table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums;font-size:.85rem}.ask-mini-table td,.ask-mini-table th{border-bottom:1px solid #294334;padding:9px 7px;text-align:center}.ask-mini-table th{color:#a5d3b5}.ask-mini-table td{color:#e1f2e5}.ask-accent{color:#b2f5c4!important;font-weight:800}
.ask-hex-groups{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:14px}.ask-hex-groups div{min-width:73px;border-radius:10px;border:1px solid #3a5c46;background:#162c1c;display:flex;flex-direction:column;align-items:center;padding:11px}.ask-hex-groups strong{font-size:1.5rem;color:#d7fdde}.ask-hex-groups code{font-size:.91rem;color:#a4f6bd}
.ask-signed-row{border:1px solid #2c4836;border-radius:12px;padding:12px;margin:12px 0;background:#101b14}.ask-signed-title{display:flex;gap:12px;justify-content:space-between;align-items:center;color:#def9e5}.ask-signed-title small{font-size:.76rem;color:#b9cbbc}.ask-signed-row .ask-bits{margin-top:12px;padding-bottom:0}.ask-out-of-range{margin-top:10px;padding:9px;background:#3b251b;border-radius:9px;color:#ffd6ae}
.ask-code-diagram{font:600 1.14rem ui-monospace,Consolas,monospace;margin:14px auto;max-width:360px;border:1px solid #315640;border-radius:12px;padding:16px;background:#0b160f}.ask-code-diagram div{display:flex;justify-content:space-between;gap:10px;margin:6px 0}.ask-code-diagram code{color:#adf2c4}.ask-code-diagram hr{border:0;border-top:1px solid #49624e;margin:7px 0}.ask-stage-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:8px 0 18px}.ask-stage-flow div{padding:13px 5px;border-radius:9px;border:1px solid #2c4734;background:#0e1912;text-align:center;display:flex;gap:5px;flex-direction:column}.ask-stage-flow div.current{border-color:#a3f3bb;background:#1b4530}.ask-stage-flow div.done{background:#193324}.ask-stage-flow span{font-size:.68rem;color:#94bca2}.ask-stage-flow strong{font-size:.8rem;color:#ddffe8}.ask-stage-flow small{font-size:.68rem;color:#bbd5c3}
.ask-memory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.ask-memory-grid div{display:flex;flex-direction:column;gap:8px;padding:11px;border-radius:12px;border:1px solid #315641;background:#112016}.ask-memory-grid span{font-size:.75rem;color:#acd1b7}.ask-memory-grid input{min-width:0;width:100%;background:#0a130d;border:1px solid #4a7559;border-radius:7px;padding:9px;color:#e9ffec;font-weight:800}.ask-memory-grid button,.ask-actions button,.ask-main-btn{padding:9px 11px;border-radius:9px;background:#1e4530;border:1px solid #498160;color:#d7ffe3;cursor:pointer;font-weight:650;font-size:.78rem}.ask-memory-grid button:hover,.ask-actions button:hover:not(:disabled),.ask-main-btn:hover{background:#2b6242}.ask-actions button:disabled{opacity:.35;cursor:default}.ask-main-btn{margin:8px 0}.ask-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:7px;margin-top:17px}.ask-actions span{font-size:.78rem;color:#bad1c1}
.ask-asm-code{border:1px solid #375a40;background:#08150d;border-radius:12px;padding:10px;font:500 .9rem ui-monospace,Consolas,monospace}.ask-asm-code div{display:flex;align-items:center;gap:13px;padding:9px;border-radius:6px;color:#b1d5bc}.ask-asm-code div.on{background:#254732;color:#e3ffec}.ask-asm-code code{flex:1;color:inherit}.ask-asm-code span{color:#759b81}.ask-asm-code b{color:#9af0b2}
.ask-export{background:#0b130e;border:1px solid #315842;border-radius:15px;padding:18px;color:#eaf7ee}.ask-export *{box-sizing:border-box}.ask-export h3{margin:0 0 10px;color:#def9e4}.ask-export-actions{display:flex;flex-wrap:wrap;gap:10px;margin:10px 0}.ask-export-actions button,.ask-export-submit,.ask-export-mini{background:#173b25;border:1px solid #418256;color:#b7ffd1;padding:9px 13px;border-radius:9px;font-size:.82rem;font-weight:650;cursor:pointer}.ask-export-submit{background:#8eeab3;color:#06200f;border:0;font-size:.94rem}.ask-export-mini{display:inline-flex;gap:5px;align-items:center;margin:10px 0}.ask-export-columns{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;max-height:430px;overflow-y:auto;margin:13px 0}.ask-export-columns label{display:flex;gap:9px;align-items:flex-start;font-size:.82rem;line-height:1.35;background:#142119;padding:9px;border-radius:8px;color:#e2f1e7}.ask-export-columns input{accent-color:#84e9ac;margin-top:3px}.ask-export-message{color:#c1e0cb;font-size:.8rem;overflow-wrap:anywhere}.ask-export-theme{color:#d4e5da;font-size:.8rem}
@media(max-width:550px){.ask-stage-flow{grid-template-columns:repeat(2,1fr)}.ask-bit{min-width:30px}.ask-bit b{font-size:.94rem}.ask-memory-grid{grid-template-columns:1fr}.ask-live-label{display:none}.ask-weights span{font-size:.55rem}}
@media print{.ask-lab,.ask-nav,.ask-export-mini,.ask-export,.ask-eyebrow{display:none!important}.ask-equation--block{break-inside:avoid}}
</file>

<file path="src/styles/electronics.css">
/* StudyLab · Elektronika · BLACK Edition (only scoped classes) */
:root[data-theme='dark']{--elec-accent:#fbc389;--elec-contrast:#fff4e6}
.el-eyebrow{display:inline-flex;gap:.55rem;align-items:center;color:#ffc990;font:800 .72rem/1.4 'Segoe UI',sans-serif;letter-spacing:.13em;text-transform:uppercase;border:1px solid #503829;background:#160f08;border-radius:99px;padding:.35rem .8rem;margin:1rem 0 .8rem}
.el-lead{font-size:1.07rem;line-height:1.8;color:#d2dbe7;max-width:61ch}
.el-eq{display:inline-block;max-width:100%;vertical-align:middle}
.el-eq-block{display:block;overflow-x:auto;text-align:center;padding:1.2rem .7rem;margin:1rem 0 1.5rem;border-radius:14px;background:linear-gradient(135deg,#150f0b,#080808);border:1px solid #493626;box-shadow:inset 3px 0 #f3b979;color:#ffe5c7}
.el-eq-block .katex-display{margin:.35rem 0;overflow-x:auto;overflow-y:hidden}
.sl-markdown-content .el-eq{color:inherit}
.el-links{display:flex;flex-wrap:wrap;gap:.7rem;margin:2.3rem 0 1.5rem}
.el-links a{display:inline-flex;background:#100d0a;border:1px solid #544032;border-radius:12px;padding:.65rem 1rem;color:#f6c68b;text-decoration:none;font-weight:650;font-size:.9rem}
.el-links a:hover{background:#26190f;text-decoration:none}
.el-lab{background:radial-gradient(circle at top right,#231607,#080808 60%);border:1px solid #503a28;border-radius:22px;overflow:hidden;margin:2rem 0;color:#ecf1f7;box-shadow:0 22px 55px #0008}
.el-lab *{box-sizing:border-box}
.el-lab-head{display:flex;align-items:center;gap:13px;padding:19px 20px;border-bottom:1px solid #34291e}
.el-orb{width:38px;height:38px;border-radius:12px;background:#f9c27d1c;border:1px solid #fbc38965;display:grid;place-items:center;color:#ffc389;font-size:22px;flex:0 0 auto}
.el-lab-head>div{display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}
.el-lab-head strong{font-size:1.05rem;color:#fff;font-weight:800;letter-spacing:-.025em}
.el-lab-head small{color:#aeb6c6;font-size:.81rem;line-height:1.5}
.el-live{border:1px solid #496450;color:#a0f5b1;background:#0a1a0f;font:800 .63rem/1.2 'Segoe UI',sans-serif;border-radius:30px;padding:6px 10px;letter-spacing:.12em}
.el-lab-body{padding:20px;display:flex;flex-direction:column;gap:14px}
.el-control-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:12px}
.el-input,.el-slider{display:flex;flex-direction:column;gap:8px;min-width:0}
.el-input>span,.el-slider>span{font-size:.8rem;color:#bdc6d0;font-weight:600}
.el-input>div{display:flex;align-items:center;background:#14171e;border:1px solid #38404a;border-radius:10px;padding:0 9px}
.el-input input{min-width:0;max-width:100%;flex:1;border:0;background:transparent;color:#fff;padding:12px 4px;font:650 1rem 'Segoe UI',sans-serif}
.el-input b{color:#fbc389;font-size:.78rem;white-space:nowrap}
.el-input select{max-width:100%;width:100%;background:#14171e;color:#fff;border:1px solid #38404a;border-radius:10px;padding:12px 10px;font-size:.86rem}
.el-slider input{width:100%;accent-color:#f5ba77;cursor:pointer}
.el-slider strong{color:#f9c88e}
.el-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}
.el-result{display:flex;flex-direction:column;gap:6px;padding:16px;border:1px solid #403224;border-radius:12px;background:#18120d;min-width:0}
.el-result small{color:#abb8c8;font-size:.73rem;line-height:1.4}
.el-result strong{font-size:clamp(1rem,2vw,1.45rem);line-height:1.2;color:#ffcf92;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
.el-note{color:#bfc7d1;background:#121920;border-left:3px solid #e6ac68;border-radius:6px;padding:12px 15px;line-height:1.7;font-size:.88rem}
.el-viz{width:100%;max-height:205px;border:1px solid #2a323d;border-radius:12px;background:repeating-linear-gradient(0deg,transparent 0 26px,#ffffff05 27px),repeating-linear-gradient(90deg,transparent 0 26px,#ffffff05 27px),#0c1016}
.el-energy{height:12px;background:#29313c;border-radius:20px;overflow:hidden}
.el-energy>div{background:linear-gradient(90deg,#cf8547,#f7c07b);height:100%;border-radius:20px;transition:width .12s}
.el-export-button{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin:.8rem 0 1.35rem}
.el-export-button button,.el-toolbar button{cursor:pointer;color:#ffe4c0;background:#20150d;border:1px solid #67492d;border-radius:10px;padding:9px 13px;font:650 .86rem 'Segoe UI',sans-serif}
.el-export-button button:hover,.el-toolbar button:hover{background:#362312}
.el-export-button small{font-size:.8rem;color:#abb7c7}
.el-export-app{margin:2rem 0;padding:1.25rem;border:1px solid #65432a;border-radius:18px;background:#070707;color:#edf3ff}
.el-export-app *{box-sizing:border-box}
.el-toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:0 0 16px}
.el-toolbar span{color:#b5c0cd;font-size:.9rem}
.el-toolbar label{display:flex;align-items:center;gap:5px;color:#f4e6d5;font-size:.87rem}
.el-export-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;margin-bottom:22px}
.el-export-groups fieldset{padding:14px;border:1px solid #34291f;border-radius:12px;background:#101013;min-width:0}
.el-export-groups legend{font-weight:750;color:#f9ca91;font-size:.94rem;padding:0 6px}
.el-export-groups legend label{display:flex;gap:8px;align-items:center}
.el-export-option{display:flex;align-items:center;gap:10px;padding:8px 4px;min-width:0}
