.el-pdf-chapter pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:9pt}
.el-pdf-chapter table{width:100%;border-collapse:collapse;font-size:9pt}.el-pdf-chapter th,.el-pdf-chapter td{border-bottom:1px solid #59534f;padding:6px;text-align:left}
.el-pdf-eyebrow{color:#d6a678;letter-spacing:.11em;text-transform:uppercase;font-size:9pt;font-weight:700}
