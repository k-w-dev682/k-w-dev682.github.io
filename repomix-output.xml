.el-pdf-kicker{letter-spacing:.25em;text-transform:uppercase;color:#d7a36e;font-size:11pt;font-weight:700}
.el-pdf-title{font-size:58pt;letter-spacing:-.075em;line-height:1.05;font-weight:850}
