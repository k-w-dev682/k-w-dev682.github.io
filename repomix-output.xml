import React,{useEffect,useMemo,useRef,useState} from 'react';
import {SUBJECTS,TOPICS,QUESTIONS,FLASHCARDS,lessonHref,subjectById,topicLabel} from './bank.js';
import {emptyWorkshop,readWorkshop,writeWorkshop,validateWorkshop,WORKSHOP_KEY,topicProgress,numericAnswer,createGuidedProblem,GUIDED_KINDS,FORMULAS,formatNumber,formulaSubstitution} from './workshop-engine.mjs';
import './studycenter-workshop.css';

const BASE=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const toLink=s=>`${BASE}${String(s||'').replace(/^\/+/, '')}`;
const today=()=>new Date().toLocaleDateString('sv-SE');
const uid=()=>`${Date.now().toString(36)}-${Math.random().toString(36).slice(2,9)}`;
const SUBJECT_LINKS={cpp:['zmienne','petla-for','wejscie-wyjscie'],math1:['implikacja','wartosc-bezwzgledna','dziedzina-zasady'],math2:['silnia','regula-mnozenia','symbol-newtona'],ask:['dwojkowy-dziesietny','liczby-ze-znakiem','cykl-rozkazu'],physics:['ruch-jednostajny','druga-zasada','ped'],electronics:['ladunek','napiecie','kondensator']};
const REASONS=[['concept','Nie rozumiem pojęcia'],['formula','Nie wiedziałem, jaki wzór wybrać'],['substitution','Błąd podstawiania'],['calculation','Błąd rachunkowy'],['notation','Pomyliłem znak lub jednostkę'],['rush','Pośpiech lub nieuwaga']];
function Heading({eyebrow,title,children}){return <div className="sc-section-title"><div><span className="sc-eyebrow">{eyebrow}</span><h2>{title}</h2></div>{children}</div>}
function Notice({children}){return <p className="scw-hint">{children}</p>}
function SubjectChooser({value,onChange}){return <label className="sc-field"><span>Przedmiot</span><select value={value} onChange={e=>onChange(e.target.value)}>{SUBJECTS.map(x=><option key={x.id} value={x.id}>{x.name}</option>)}</select></label>}
function Meter({value}){return <div className="scw-meter"><span style={{width:`${Math.max(0,Math.min(100,value))}%`}}/></div>}
function Button({children,onClick,secondary=false,disabled=false}){return <button type="button" disabled={disabled} className={secondary?'sc-secondary':'sc-primary'} onClick={onClick}>{children}</button>}

function Paths({db,setSection}){
 const [subject,setSubject]=useState('math2');
 const topics=TOPICS[subject]||[];
 const ranked=topics.map(([id,name])=>({id,name,...topicProgress(db.attempts,subject,id)})).sort((a,b)=>a.score-b.score);
 const due=FLASHCARDS.filter(x=>x.subject===subject &&(!db.cards[x.id]||db.cards[x.id].due<=Date.now())).length;
 return <><Heading eyebrow="ŚCIEŻKI NAUKI" title="Czego uczyć się dalej?"/><section className="sc-panel"><SubjectChooser value={subject} onChange={setSubject}/><Notice>Wskaźnik jest szacunkiem na podstawie maksymalnie 12 ostatnich odpowiedzi w danym temacie oraz liczby prób. Nie oznacza zaliczenia przedmiotu ani nie zastępuje sprawdzianu.</Notice><div className="scw-topic-list">{ranked.map(t=><article key={t.id} className="scw-topic"><div className="sc-between"><div><strong>{t.name}</strong><small>{t.count?t.count+' prób · '+t.accuracy+'% ostatnich poprawnych':'Jeszcze niećwiczony temat'}</small></div><b>{t.score}/100</b></div><Meter value={t.score}/><div className="sc-actions"><Button secondary onClick={()=>setSection('tutor')}>Trenuj kroki</Button><a className="scw-inline-link" href={toLink(`centrum-nauki/?subject=${subject}&topic=${t.id}&mode=adaptive#adaptive`)}>Quiz adaptacyjny ↗</a></div></article>)}</div></section>
 <section className="sc-panel"><h3>Proponowana kolejność na dziś</h3><ol className="scw-ordered"><li><b>Powtórz fiszki</b> — {due} wymagających uwagi w tym przedmiocie.</li><li><b>Utrwal najsłabszy temat:</b> {ranked[0]?.name || 'Wybierz temat'}.</li><li><b>Rozwiąż krótki quiz</b> i zwróć uwagę na wyjaśnienia po odpowiedziach.</li></ol><p className="sc-muted">Plan zmienia się po wykonaniu kolejnych ćwiczeń. Kolejność nie wymaga żadnej usługi AI.</p></section>
 <section className="sc-panel"><h3>Mapa kursu — polecane lekcje</h3><div className="scw-chip-row">{(SUBJECT_LINKS[subject]||[]).map(slug=><a className="scw-chip" key={slug} href={toLink(lessonHref(subject,slug))}>{slug.replaceAll('-',' ')} ↗</a>)}</div></section></>;
}

function Tutor({onAttempt,workshop,mutate}){
 const [kind,setKind]=useState('linear'),[problem,setProblem]=useState(null),[step,setStep]=useState(0),[input,setInput]=useState(''),[message,setMessage]=useState(''),[hint,setHint]=useState(false),[wrong,setWrong]=useState(false),[done,setDone]=useState(false);
 function start(k=kind){setKind(k);setProblem(createGuidedProblem(k));setStep(0);setInput('');setMessage('');setHint(false);setWrong(false);setDone(false)}
 function check(){if(!problem||done)return;const item=problem.steps[step];const result=numericAnswer(input,item.answer);if(!result.valid){setMessage('Wpisz liczbę, np. 2 lub 3,5.');return}const attempt={id:`${problem.id}-step-${step}`,subject:problem.subject,topic:problem.topic,question:`${problem.question} — ${item.label}`,given:input,answer:String(item.answer),why:item.meaning+' '+item.formula,lesson:'',ok:result.ok,mode:'workshop-step',hints:hint?1:0,date:Date.now()};onAttempt(attempt);mutate(d=>({...d,stepSessions:[...d.stepSessions,{id:attempt.id,subject:attempt.subject,topic:attempt.topic,ok:result.ok,date:attempt.date,hints:attempt.hints}].slice(-1000)}));
 if(!result.ok){setWrong(true);setMessage('Jeszcze nie. Sprawdź działanie i jednostki — możesz zobaczyć wskazówkę.');return}
 setWrong(false);setMessage('Poprawnie! '+item.meaning);if(step===problem.steps.length-1)setDone(true);else{setStep(s=>s+1);setInput('');setHint(false)}
 }
 return <><Heading eyebrow="NAUCZYCIEL KROK PO KROKU" title="Liczymy bez zgadywania"/><section className="sc-panel"><p className="sc-muted">Rozbudowa trenera: każde zadanie wymaga wykonania konkretnych działań i pokazuje wzór, oznaczenia oraz podstawienie danych. System sprawdza wynik liczbowy, nie równoważność dowolnych zapisów algebraicznych.</p><div className="scw-toolbar"><label className="sc-field"><span>Rodzaj zadania</span><select value={kind} onChange={e=>start(e.target.value)}>{GUIDED_KINDS.map(([v,label])=><option key={v} value={v}>{label}</option>)}</select></label><Button onClick={()=>start()}>Nowe zadanie</Button></div>
 {problem?<div className="scw-card"><h3>{problem.title}</h3><p className="scw-question">{problem.question}</p><p className="sc-muted">Krok {step+1} z {problem.steps.length}</p><h4>{problem.steps[step].label}</h4><div className="scw-formula">{problem.steps[step].formula}</div><p>{problem.steps[step].question}</p><label className="sc-field"><span>Twój wynik</span><input type="text" inputMode="decimal" value={input} onChange={e=>setInput(e.target.value)} onKeyDown={e=>{if(e.key==='Enter')check()}} placeholder="Np. 12,5" disabled={done}/></label><div className="sc-actions"><Button disabled={done||!input.trim()} onClick={check}>Sprawdź krok</Button><Button secondary onClick={()=>setHint(v=>!v)}> {hint?'Ukryj':'Pokaż'} wyjaśnienie</Button></div>{hint&&<div className="scw-hint">{problem.steps[step].meaning} Oczekiwany wynik: {formatNumber(problem.steps[step].answer)}.</div>}{message&&<p role="status" className={wrong?'scw-bad':'scw-good'}>{message}</p>}{done&&<div className="scw-success"><strong>Zadanie ukończone.</strong><p>Możesz wylosować nowe dane i powtórzyć metodę.</p><Button onClick={()=>start()}>Kolejny wariant</Button></div>}</div>:<Notice>Wybierz „Nowe zadanie”, aby rozpocząć.</Notice>}</section></>;
}

function FormulaBook(){
 const [subject,setSubject]=useState('physics');const list=FORMULAS.filter(f=>f.subject===subject);const [id,setId]=useState('density');const current=list.find(x=>x.id===id)||list[0]||FORMULAS[0];const [values,setValues]=useState({});
 const parts=current.vars.map(([symbol,unit,initial])=>values[current.id+'-'+symbol]??String(initial));const numeric=parts.map(x=>Number(String(x).replace(',','.')));const valid=parts.every(x=>String(x).trim()!=='')&&numeric.every(Number.isFinite);const result=valid?current.calc(numeric):NaN;
 return <><Heading eyebrow="WZORY I PODSTAWIANIE" title="Interaktywna karta wzorów"/><section className="sc-panel"><SubjectChooser value={subject} onChange={v=>{setSubject(v);setId('')}}/><label className="sc-field"><span>Wzór</span><select value={current.id} onChange={e=>setId(e.target.value)}>{list.length?list.map(f=><option key={f.id} value={f.id}>{f.name}</option>):<option value={current.id}>Przykład podstawowy</option>}</select></label><div className="scw-formula scw-big">{current.expression}</div><h3>Znaczenie oznaczeń</h3><p>{current.symbols}</p><div className="scw-input-grid">{current.vars.map(([symbol,unit,initial])=><label key={symbol} className="sc-field"><span>{symbol} {unit?'['+unit+']':''}</span><input inputMode="decimal" value={values[current.id+'-'+symbol]??String(initial)} onChange={e=>setValues(v=>({...v,[current.id+'-'+symbol]:e.target.value}))}/></label>)}</div><div className="scw-calculation"><strong>Podstawienie:</strong><div>{formulaSubstitution(current,parts)}</div><strong>Wynik: {formatNumber(result)} {current.unit}</strong></div><Notice>{current.explain} Przelicz jednostki na podane w nawiasach przed wprowadzeniem liczb. Kalkulator podaje wynik orientacyjnie zgodny z przyjętymi jednostkami.</Notice></section></>;
}

function Labs(){
 const [lab,setLab]=useState('rlc');const [r,setR]=useState(100),[l,setL]=useState(100),[c,setC]=useState(10),[speed,setSpeed]=useState(5),[seconds,setSeconds]=useState(8),[num,setNum]=useState(23),[stack,setStack]=useState([2,4]),[heap,setHeap]=useState([]),[allocSize,setAllocSize]=useState(16),[setMode,setSetMode]=useState('intersection');
 const L=l/1000,C=c*1e-6,f0=1/(2*Math.PI*Math.sqrt(L*C)),band=r/(2*Math.PI*L),q=2*Math.PI*f0*L/r;
 const d=speed*seconds;
 return <><Heading eyebrow="WIZUALIZACJE NA ŻYWO" title="Laboratoria interaktywne"/><div className="scw-chip-row scw-tabs">{[['rlc','Obwód RLC'],['motion','Ruch'],['binary','Bity'],['stack','Stos'],['heap','Sterta (heap)'],['sets','Zbiory']].map(([k,n])=><button className={lab===k?'active':''} key={k} onClick={()=>setLab(k)}>{n}</button>)}</div>
 {lab==='rlc'&&<section className="sc-panel"><h3>Szeregowy obwód RLC</h3><p className="sc-muted">Model idealny RLC z rezystancją szeregową. Częstotliwość rezonansowa f₀, pasmo Δf i dobroć Q.</p><svg className="scw-circuit" viewBox="0 0 530 170" role="img" aria-label="Schemat szeregowego obwodu RLC: źródło napięcia, rezystor, cewka i kondensator"><g fill="none" stroke="currentColor" strokeWidth="2.5"><path d="M50 35 H105 M195 35 H253 M321 35 H379 M410 35 H480 V135 H50 V100 M50 65 V35"/><circle cx="50" cy="82" r="18"/><path d="M45 80 Q50 67 55 80 Q60 93 65 80"/><rect x="105" y="24" width="90" height="22" rx="3"/><path d="M253 35 q8 -25 17 0 q8 -25 17 0 q8 -25 17 0 q8 -25 17 0"/><path d="M379 17 V53 M409 17 V53"/></g><g fill="currentColor" fontSize="15"><text x="142" y="17">R</text><text x="276" y="17">L</text><text x="388" y="12">C</text><text x="23" y="116">~U</text></g></svg><div className="scw-slider"><label>Rezystancja R: <b>{r} Ω</b><input type="range" min="10" max="400" step="10" value={r} onChange={e=>setR(+e.target.value)}/></label><label>Indukcyjność L: <b>{l} mH</b><input type="range" min="10" max="500" step="10" value={l} onChange={e=>setL(+e.target.value)}/></label><label>Pojemność C: <b>{c} µF</b><input type="range" min="1" max="100" step="1" value={c} onChange={e=>setC(+e.target.value)}/></label></div><div className="scw-result-grid"><div><small>Częstotliwość rezonansowa</small><b>{formatNumber(f0)} Hz</b></div><div><small>Pasmo 3 dB</small><b>{formatNumber(band)} Hz</b></div><div><small>Dobroć</small><b>{formatNumber(q)}</b></div></div><div className="scw-formula">f₀ = 1 / (2π√(LC)) · Δf = R / (2πL) · Q = (2πf₀L)/R</div><h4>Charakterystyka amplitudowa prądu</h4><svg className="scw-response" viewBox="0 0 500 190" role="img" aria-label="Wykres względnego natężenia prądu w zależności od częstotliwości przy zasilaniu napięciem sinusoidalnym"><path d="M40 15 V160 H485" stroke="currentColor" strokeWidth="1.5" fill="none"/><path d={`M${Array.from({length:121},(_,i)=>{const f=f0*(0.1+i*0.0233);const omega=2*Math.PI*f;const impedance=Math.sqrt(r*r+(omega*L-1/(omega*C))**2);const intensity=r/impedance;return `${(40+i*3.65).toFixed(2)} ${(155-130*intensity).toFixed(2)}`}).join(' L')}`} fill="none" stroke="#88e2b2" strokeWidth="2.5" strokeLinejoin="round"/><text x="7" y="17" fontSize="10" fill="currentColor">I/Iₘₐₓ</text><text x="438" y="181" fontSize="11" fill="currentColor">f [Hz]</text><text x="210" y="181" fontSize="10" fill="currentColor">Rezonans ≈ {formatNumber(f0)} Hz</text></svg><Notice>Podstawienie: L = {l}/1000 = {formatNumber(L)} H, C = {c} · 10⁻⁶ = {formatNumber(C)} F. Wzory dotyczą idealnego szeregowego obwodu RLC.</Notice></section>}
 {lab==='motion'&&<section className="sc-panel"><h3>Ruch jednostajny</h3><div className="scw-slider"><label>Prędkość: {speed} m/s<input type="range" min="0" max="20" value={speed} onChange={e=>setSpeed(+e.target.value)}/></label><label>Czas: {seconds} s<input type="range" min="0" max="20" value={seconds} onChange={e=>setSeconds(+e.target.value)}/></label></div><div className="scw-track"><div style={{left:`${Math.min(96,d/4)}%`}} className="scw-car">🚗</div></div><div className="scw-formula">s = v · t = {speed} m/s · {seconds} s = {d} m</div><Notice>Pozycja samochodu jest przedstawiona na umownej osi 0–400 m. Animacja nie odtwarza upływu czasu, lecz pokazuje położenie wynikające z suwaków.</Notice></section>}
 {lab==='binary'&&<section className="sc-panel"><h3>Liczba dziesiętna → osiem bitów</h3><label className="sc-field"><span>Wartość od 0 do 255</span><input type="number" min="0" max="255" value={num} onChange={e=>setNum(Math.max(0,Math.min(255,Math.floor(Number(e.target.value)||0))))}/></label><div className="scw-bits">{Array.from({length:8},(_,i)=>{const power=7-i;const on=!!(num&(1<<power));return <div className={on?'active':''} key={power}><small>{2**power}</small><strong>{on?'1':'0'}</strong></div>})}</div><p>Wynik: <strong>{num}₁₀ = {num.toString(2).padStart(8,'0')}₂</strong></p><Notice>Podświetlone jedynki oznaczają wagi dodawane do liczby dziesiętnej. Zera pomijamy.</Notice></section>}

 {lab==='heap'&&<section className="sc-panel"><h3>Uproszczony przydział pamięci na stercie</h3><p>Cały model ma 128 bajtów. Każde naciśnięcie „Przydziel” zajmuje kolejną porcję pamięci. „Zwolnij” usuwa wskazany blok. Dla prostoty model nie symuluje fragmentacji ani rzeczywistego działania <code>malloc</code>.</p><div className="scw-heap">{heap.map(x=><div key={x.id} title={`${x.size} bajtów`} style={{width:`${x.size/128*100}%`}}>{x.size} B</div>)}<div className="free" style={{width:`${(128-heap.reduce((a,x)=>a+x.size,0))/128*100}%`}}>Wolne: {128-heap.reduce((a,x)=>a+x.size,0)} B</div></div><div className="scw-toolbar"><label className="sc-field"><span>Rozmiar bloku</span><select value={allocSize} onChange={e=>setAllocSize(+e.target.value)}>{[8,16,32,64].map(n=><option key={n} value={n}>{n} B</option>)}</select></label><Button disabled={heap.reduce((a,x)=>a+x.size,0)+allocSize>128} onClick={()=>setHeap(items=>[...items,{id:uid(),size:allocSize}])}>Przydziel blok</Button></div><div className="scw-chip-row">{heap.map((item,i)=><button key={item.id} onClick={()=>setHeap(s=>s.filter(x=>x.id!==item.id))}>Zwolnij #{i+1} · {item.size} B</button>)}</div><Notice>Rzeczywisty <code>heap</code> nie musi przechowywać bloków bezpośrednio obok siebie. Symulacja pokazuje ilość dostępnej pamięci i proces zwalniania zasobów.</Notice></section>}
 {lab==='sets'&&<section className="sc-panel"><h3>Wizualizacja działań na zbiorach</h3><div className="scw-chip-row">{[['union','A ∪ B — suma'],['intersection','A ∩ B — część wspólna'],['difference','A \ B — różnica']].map(([k,n])=><button key={k} className={setMode===k?'active':''} onClick={()=>setSetMode(k)}>{n}</button>)}</div><svg className="scw-circuit" viewBox="0 0 450 215" role="img" aria-label="Diagram zbiorów A i B, z wynikiem podświetlonym w zależności od wybranej operacji"><defs><clipPath id="scw-clip-b"><circle cx="266" cy="104" r="78"/></clipPath></defs><circle cx="184" cy="104" r="78" fill={setMode==='intersection'?'#1b342a':'#31795b'} stroke="#c3e6d1" strokeWidth="2"/><circle cx="266" cy="104" r="78" fill={setMode==='union'?'#31795b':'#1b342a'} stroke="#c3e6d1" strokeWidth="2"/>{setMode!=='difference'&&<circle cx="184" cy="104" r="78" clipPath="url(#scw-clip-b)" fill="#60c79a"/>}{setMode==='difference'&&<circle cx="266" cy="104" r="78" fill="#1b342a" stroke="#c3e6d1" strokeWidth="2"/>}<g fill="#f1fff5" fontSize="22"><text x="132" y="100">A</text><text x="301" y="100">B</text></g></svg><Notice>{setMode==='union'?'A ∪ B to elementy należące do A lub B (także do obu).':setMode==='intersection'?'A ∩ B to elementy należące jednocześnie do obu zbiorów.':'A \ B to elementy A, które nie należą do B.'}</Notice></section>}
 {lab==='stack'&&<section className="sc-panel"><h3>Stos (LIFO)</h3><p>Stos pokazuje zasadę <b>Last In, First Out</b>: ostatnio dodany element będzie pobrany jako pierwszy.</p><div className="scw-stack">{[...stack].reverse().map((v,i)=><div key={`${stack.length-i}-${v}`}><span>{v}</span>{i===0&&<small>← wierzchołek</small>}</div>)}</div><div className="sc-actions"><Button onClick={()=>setStack(s=>s.length<12?[...s,s.length?Math.max(...s)+1:1]:s)} disabled={stack.length>=12}>PUSH</Button><Button secondary onClick={()=>setStack(s=>s.slice(0,-1))} disabled={!stack.length}>POP</Button><Button secondary onClick={()=>setStack([])}>Wyczyść</Button></div><Notice>To model logiczny stosu danych (nie realistyczny przydział pamięci C++). Sterta (heap) to odrębny obszar, którego nie należy mylić ze strukturą „kopiec”.</Notice></section>}
 </>;
}

function Variants({onAttempt}){
 const [kind,setKind]=useState('motion'),[difficulty,setDifficulty]=useState('standard'),[question,setQuestion]=useState(()=>createGuidedProblem('motion')),[answer,setAnswer]=useState(''),[checked,setChecked]=useState(null);
 const last=question.steps.at(-1);
 function next(k=kind,d=difficulty){setKind(k);setDifficulty(d);setQuestion(createGuidedProblem(k,Math.random,d));setAnswer('');setChecked(null)}
 function check(){const res=numericAnswer(answer,last.answer);if(!res.valid){setChecked('format');return}setChecked(res.ok?'good':'bad');onAttempt({id:`variant:${question.id}`,subject:question.subject,topic:question.topic,question:question.question,given:answer,answer:String(last.answer),why:last.meaning+' '+last.formula,lesson:'',ok:res.ok,mode:'variant',hints:0,date:Date.now()})}
 return <><Heading eyebrow="ĆWICZENIE Z RÓŻNYMI DANYMI" title="Generator wariantów zadań"/><section className="sc-panel"><label className="sc-field"><span>Zakres</span><select value={kind} onChange={e=>next(e.target.value)}>{GUIDED_KINDS.map(([id,name])=><option value={id} key={id}>{name}</option>)}</select></label><label className="sc-field"><span>Poziom trudności</span><select value={difficulty} onChange={e=>next(kind,e.target.value)}><option value="easy">Łatwy</option><option value="standard">Średni</option><option value="hard">Trudny</option></select></label><div className="scw-card"><h3>{question.title}</h3><p className="scw-question">{question.question}</p><p className="sc-muted">Wpisz wynik ostatniego kroku rozwiązania; jeśli nie wiesz, skorzystaj z trenera krok po kroku.</p><label className="sc-field"><span>Odpowiedź liczbowa</span><input value={answer} inputMode="decimal" onChange={e=>setAnswer(e.target.value)}/></label><div className="sc-actions"><Button onClick={check} disabled={!answer.trim()}>Sprawdź</Button><Button secondary onClick={()=>next()}>Inny wariant</Button></div>{checked&&<div role="status" className={checked==='good'?'scw-good':'scw-bad'}>{checked==='good'?'Poprawnie!':checked==='format'?'Podaj liczbę, np. 2,5.':`Błędna odpowiedź. Wzór: ${last.formula}. ${last.meaning}`}</div>}</div></section></>;
}

function ErrorAnalysis({db,workshop,mutate,setSection,onAddCard}){
 const wrong=db.attempts.filter(x=>!x.ok).slice(-80).reverse(),reasonFor=x=>workshop.diagnoses[`${x.id}:${x.date}`];
 const counters=Object.fromEntries(REASONS.map(([k])=>[k,0]));wrong.forEach(x=>{let r=reasonFor(x)?.reason;if(counters[r]!==undefined)counters[r]++});
 function record(x,fields){mutate(d=>({...d,diagnoses:{...d.diagnoses,[`${x.id}:${x.date}`]:{...d.diagnoses[`${x.id}:${x.date}`],...fields}}}))}
 function card(x){onAddCard({id:`custom:workshop:${uid()}`,subject:SUBJECTS.some(s=>s.id===x.subject)?x.subject:'math1',topic:x.topic||'logic',front:x.question.slice(0,300),back:('Poprawnie: '+x.answer+'. '+x.why).slice(0,800),lesson:x.lesson||''})}
