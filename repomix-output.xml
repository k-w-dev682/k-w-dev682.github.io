import Eq from '../../../../components/MathEquation.astro';
import MathIPdfButton from '../../../../components/MathIPdf.jsx';
import { InverseLab } from '../../../../components/MathILabs.jsx';
import FunctionMachineGraphic from '../../../../components/visuals/FunctionMachineGraphic.astro';
