import React, {useState,useMemo} from 'react';
import {SUBJECTS,TOPICS} from './bank.js';
import './studycenter-plus.css';
import StudyCenterAdvanced from './StudyCenterAdvanced.jsx';
import StudyLabCppRunner from './StudyLabCppRunner.jsx';
const today=()=>new Date().toLocaleDateString('sv-SE');
const seed=()=>Math.floor(Math.random()*8)+2;
const datasets=[
 {id:'logic',s:'math2',name:'Logika i implikacja',prereq:[],brief:'Implikacja p ⇒ q jest fałszywa wyłącznie wtedy, gdy p=1, q=0.',terms:['implikacja','fałszywa','prawda'],challenge:()=>{const a=seed()%2,b=seed()%2;return {q:`Oblicz wartość logiczną (${a} ⇒ ${b}). Wpisz 0 lub 1.`,answer:+(!a||!!b),steps:['Sprawdź wartość poprzednika p.','Gdy p=1 i q=0, implikacja jest fałszywa.','W pozostałych przypadkach wynik wynosi 1.']}}},
 {id:'sets',s:'math2',name:'Zbiory i wartość bezwzględna',prereq:['logic'],brief:'|x−a|≤r oznacza x∈[a−r,a+r] dla r≥0.',terms:['wartość bezwzględna','przedział','odległość'],challenge:()=>{const a=seed(),r=seed();return {q:`Dla |x − ${a}| ≤ ${r} podaj LEWY koniec przedziału rozwiązań.`,answer:a-r,steps:[`|x−${a}|≤${r} oznacza −${r}≤x−${a}≤${r}.`,`Dodaj ${a} do każdej części nierówności.`,`Lewy koniec wynosi ${a-r}.`]}}},
 {id:'combinatorics',s:'math2',name:'Kombinatoryka',prereq:['sets'],brief:'Jeśli są m możliwości pierwszego wyboru i n drugiego, łącznie jest m·n możliwości.',terms:['mnożenia','możliwości','iloczyn'],challenge:()=>{const a=seed(),b=seed();return {q:`Masz ${a} koszulek i ${b} par spodni. Ile różnych zestawów możesz ułożyć?`,answer:a*b,steps:['Zastosuj regułę mnożenia.','Pomnóż liczbę koszulek przez liczbę par spodni.',`${a} × ${b} = ${a*b}.`]}}},
 {id:'induction',s:'math2',name:'Indukcja matematyczna',prereq:['logic'],brief:'Dowód indukcyjny obejmuje bazę i krok n→n+1.',terms:['baza','krok','założenie'],challenge:()=>{const n=seed();return {q:`Oblicz sumę 1+2+…+${n}, korzystając ze wzoru n(n+1)/2.`,answer:n*(n+1)/2,steps:['Podstaw n do wzoru n(n+1)/2.',`${n}(${n}+1)/2.`,`Wynik: ${n*(n+1)/2}.`]}}},
 {id:'ohm',s:'electronics',name:'Prawo Ohma',prereq:[],brief:'U=I·R; I=U/R; R=U/I.',terms:['napięcie','prąd','opór'],challenge:()=>{const i=seed(),r=seed();return {q:`Prąd ${i} A płynie przez opór ${r} Ω. Oblicz napięcie U w V.`,answer:i*r,steps:['Zapisz wzór U=I·R.',`Podstaw I=${i} A, R=${r} Ω.`,`U=${i*r} V.`]}}},
 {id:'binary',s:'ask',name:'System binarny',prereq:[],brief:'Cyfry liczby binarnej mają wagi 1,2,4,8… od prawej.',terms:['binarny','potęgi','dwójkowy'],challenge:()=>{const n=seed()*3;return {q:`Zamień liczbę binarną ${n.toString(2)} na dziesiętną.`,answer:n,steps:['Podpisz potęgi 2 pod kolejnymi bitami.','Dodaj wagi tylko tam, gdzie bit wynosi 1.',`Wynik: ${n}.`]}}},
 {id:'physics',s:'physics',name:'Droga i prędkość',prereq:[],brief:'Przy stałej prędkości s=v·t.',terms:['droga','prędkość','czas'],challenge:()=>{const v=seed(),t=seed();return {q:`Ciało porusza się ${v} m/s przez ${t} s. Oblicz drogę w metrach.`,answer:v*t,steps:['Wzór s=v·t.',`Podstaw ${v} m/s × ${t} s.`,`s=${v*t} m.`]}}},
 {id:'cpp',s:'cpp',name:'Podstawy C++',prereq:[],brief:'Zmienna int przechowuje liczby całkowite, a pętla for powtarza instrukcje.',terms:['zmienna','instrukcja','int'],challenge:()=>{const a=seed();return {q:`Ile razy wykona się pętla: for(int i=0; i<${a}; i++)?`,answer:a,steps:['Wartość i początkowo wynosi 0.',`Iteracje: i=0,1,…,${a-1}.`,`Liczba iteracji: ${a}.`]}}}
];
function Section({title,sub,children}){return <section className="scp-panel"><h3>{title}</h3>{sub&&<p className="scp-muted">{sub}</p>}{children}</section>}
function Action({children,onClick,secondary=false,disabled=false}){return <button className={secondary?'scp-button scp-secondary':'scp-button'} onClick={onClick} disabled={disabled}>{children}</button>}
function Tag({children}){return <span className="scp-tag">{children}</span>}
export default function StudyCenterPlus({db,onAttempt,onSession}){
 const [mode,setMode]=useState('trainer'),[topic,setTopic]=useState('logic'),[task,setTask]=useState(null),[answer,setAnswer]=useState(''),[result,setResult]=useState(null),[step,setStep]=useState(0),[hint,setHint]=useState(0);
 const [duration,setDuration]=useState(20),[deadline,setDeadline]=useState('');
 const [explanation,setExplanation]=useState(''),[explained,setExplained]=useState(null),[cloze,setCloze]=useState(''),[reveal,setReveal]=useState(false),[exerciseMode,setExerciseMode]=useState('random');
 const [sim,setSim]=useState({p:false,q:true,u:12,r:6,n:13}),[simMode,setSimMode]=useState('logic');
 const [level,setLevel]=useState(2);
 const stats=useMemo(()=>datasets.map(t=>{const rows=(db.attempts||[]).filter(a=>a.topic===`plus-${t.id}`);return {...t,attempts:rows.length,rate:rows.length?Math.round(rows.filter(a=>a.ok).length/rows.length*100):null}}),[db.attempts]);
 const current=datasets.find(t=>t.id===topic)||datasets[0];
 function pickTask(id=topic){const t=datasets.find(x=>x.id===id)||datasets[0];setTopic(t.id);setTask(t.challenge());setStep(0);setAnswer('');setResult(null);setHint(0)}
 function submit(){if(!task)return;const given=Number(answer.replace(',','.'));if(!answer.trim()||!Number.isFinite(given)){setResult('Wpisz liczbę.');return}const ok=Math.abs(given-task.answer)<1e-8;setResult(ok?'Dobrze! Odpowiedź jest poprawna.':`Jeszcze nie. Poprawna odpowiedź: ${task.answer}.`);onAttempt({id:`plus-${topic}-${Date.now()}`,subject:current.s,topic:`plus-${topic}`,question:task.q,given:answer,answer:String(task.answer),why:task.steps.join(' '),ok,mode:'plus-trainer',hints:hint,date:Date.now()})}
 const presets=['trainer','graph','plan','code','sim','explain','cloze','exam','rescue','mistakes','adv-steps','adv-sim'];
 const names=['Trener krok po kroku','Mapa wiedzy','Plan nauki','Laboratorium C++','Symulatory','Wyjaśnij własnymi słowami','Aktywne luki','Egzamin próbny','Tryb ratunkowy','Dziennik błędów','Matematyka 2.0','Symulatory 2.0'];
 const mistakes=(db.attempts||[]).filter(a=>!a.ok).slice(-120).reverse();
 const weak=[...stats].sort((a,b)=>(a.rate??-1)-(b.rate??-1));
 return <div className="scp-root"><div className="scp-intro"><Tag>STUDYLAB 5.3</Tag><h2>Laboratorium nauki</h2><p>Ćwicz rozumowanie, nie samo rozpoznawanie odpowiedzi. Wyniki trenera trafiają do statystyk Centrum Nauki.</p></div>
 <div className="scp-tabs">{presets.map((id,i)=><button className={mode===id?'scp-selected':''} onClick={()=>setMode(id)} key={id}>{names[i]}</button>)}</div>
 {mode==='adv-steps'&&<StudyCenterAdvanced kind="steps" onAttempt={onAttempt}/>}

 {mode==='adv-sim'&&<StudyCenterAdvanced kind="sim"/>}
 {mode==='trainer'&&<Section title="Trener rozwiązywania" sub="Nowe wartości przy każdym zadaniu; każda podpowiedź odsłania jeden krok rozwiązania."><div className="scp-row"><label>Temat<select value={topic} onChange={e=>{setTopic(e.target.value);setTask(null);setResult(null)}}>{datasets.map(t=><option value={t.id} key={t.id}>{t.name}</option>)}</select></label><Action onClick={()=>pickTask()}>Wylosuj zadanie</Action></div>{task&&<div className="scp-exercise"><strong>{task.q}</strong><label>Twoja odpowiedź<input inputMode="decimal" value={answer} onChange={e=>setAnswer(e.target.value)} placeholder="Wpisz wynik" onKeyDown={e=>e.key==='Enter'&&submit()}/></label><div className="scp-row"><Action onClick={submit} disabled={result?.startsWith('Dobrze')}>Sprawdź</Action><Action secondary onClick={()=>{setHint(v=>Math.min(v+1,task.steps.length));setStep(v=>Math.min(v+1,task.steps.length))}}>Podpowiedź {hint}/{task.steps.length}</Action><Action secondary onClick={()=>pickTask()}>Następne</Action></div>{task.steps.slice(0,step).map((s,i)=><p key={i} className="scp-hint">{i+1}. {s}</p>)}{result&&<p role="status" className="scp-feedback">{result}</p>}</div>}</Section>}
 {mode==='graph'&&<Section title="Mapa zależności tematów" sub="Szary = brak prób, zielony = ≥80% poprawnych odpowiedzi, bursztynowy = pozostałe. Łącza pokazują uproszczone wymagania wstępne."><div className="scp-graph">{stats.map(t=><button key={t.id} onClick={()=>{setMode('trainer');pickTask(t.id)}} className={`scp-node ${t.rate===null?'scp-unseen':t.rate>=80?'scp-good':'scp-learning'}`}><b>{t.name}</b><small>{t.rate===null?'Nieprzećwiczony':`${t.rate}% · ${t.attempts} prób`}</small>{t.prereq.length>0&&<small>Wcześniej: {t.prereq.map(id=>datasets.find(d=>d.id===id)?.name).join(', ')}</small>}</button>)}</div></Section>}
 {mode==='plan'&&<Section title="Plan nauki do kolokwium" sub="Plan bierze pod uwagę tematy z niską skutecznością i czas pozostały do terminu."><div className="scp-row"><label>Data kolokwium<input type="date" value={deadline} min={today()} onChange={e=>setDeadline(e.target.value)}/></label><label>Minut dziennie<input type="number" min="5" max="240" value={duration} onChange={e=>setDuration(Math.max(5,Math.min(240,Number(e.target.value)||20)))}/></label></div>{deadline&&<div className="scp-exercise"><strong>{Math.max(1,Math.ceil((new Date(deadline+'T12:00:00')-Date.now())/86400000))} dni na przygotowanie</strong><p>Każdego dnia: {Math.min(10,Math.round(duration/4))} min fiszek + reszta na praktykę i poprawę błędów.</p>{weak.slice(0,6).map((t,i)=><p key={t.id}><b>Dzień {i+1}:</b> {t.name} · {Math.max(5,duration-10)} min <Action secondary onClick={()=>{setMode('trainer');pickTask(t.id)}}>Ćwicz</Action></p>)}<small>Po ukończeniu sześciu tematów wróć do dziennika błędów i powtórek FSRS.</small></div>}</Section>}
 {mode==='code'&&<StudyLabCppRunner onAttempt={onAttempt}/>} 
 {mode==='sim'&&<Section title="Interaktywne symulacje" sub="Eksperymentuj z wartościami i obserwuj zmiany natychmiast."><div className="scp-row"><label>Symulator<select value={simMode} onChange={e=>setSimMode(e.target.value)}><option value="logic">Bramki logiczne</option><option value="ohm">Prawo Ohma</option><option value="binary">Bity i zapis binarny</option></select></label></div>{simMode==='logic'&&<div className="scp-exercise"><div className="scp-row"><label><input type="checkbox" checked={sim.p} onChange={e=>setSim({...sim,p:e.target.checked})}/> p = {Number(sim.p)}</label><label><input type="checkbox" checked={sim.q} onChange={e=>setSim({...sim,q:e.target.checked})}/> q = {Number(sim.q)}</label></div><div className="scp-result">AND: {Number(sim.p&&sim.q)} · OR: {Number(sim.p||sim.q)} · XOR: {Number(sim.p!==sim.q)} · p ⇒ q: {Number(!sim.p||sim.q)}</div></div>}{simMode==='ohm'&&<div className="scp-exercise"><label>Napięcie U: {sim.u} V<input type="range" min="1" max="36" value={sim.u} onChange={e=>setSim({...sim,u:Number(e.target.value)})}/></label><label>Opór R: {sim.r} Ω<input type="range" min="1" max="30" value={sim.r} onChange={e=>setSim({...sim,r:Number(e.target.value)})}/></label><div className="scp-result">I = U / R = {(sim.u/sim.r).toFixed(2)} A · P = U²/R = {(sim.u*sim.u/sim.r).toFixed(2)} W</div></div>}{simMode==='binary'&&<div className="scp-exercise"><label>Liczba dziesiętna: {sim.n}<input type="range" min="0" max="255" value={sim.n} onChange={e=>setSim({...sim,n:Number(e.target.value)})}/></label><div className="scp-result">{sim.n.toString(2).padStart(8,'0')}₂ = {sim.n}₁₀ = {sim.n.toString(16).toUpperCase()}₁₆</div></div>}</Section>}
 {mode==='explain'&&<Section title="Wyjaśnij własnymi słowami" sub="Ocena sprawdza obecność pojęć, a nie ich sens — to tylko wskazówka do samokontroli."><label>Temat<select value={topic} onChange={e=>{setTopic(e.target.value);setExplained(null);setExplanation('')}}>{datasets.map(t=><option key={t.id} value={t.id}>{t.name}</option>)}</select></label><p>Wytłumacz zagadnienie komuś, kto widzi je po raz pierwszy.</p><textarea rows={6} value={explanation} onChange={e=>setExplanation(e.target.value)} placeholder="Własne wyjaśnienie..."/><Action onClick={()=>{const words=current.terms.filter(w=>explanation.toLowerCase().includes(w.toLowerCase()));setExplained(words)}}>Sprawdź punkty kluczowe</Action>{explained&&<div className="scp-exercise"><b>Wykryte hasła: {explained.length}/{current.terms.length}</b><p>Warto uwzględnić: {current.terms.join(', ')}.</p><p><b>Wzorcowe minimum:</b> {current.brief}</p><p>Nie jest to automatyczne sprawdzenie merytorycznej poprawności. Porównaj sens własnego wyjaśnienia z opisem.</p></div>}</Section>}
 {mode==='cloze'&&<Section title="Notatki z aktywnymi lukami" sub="Odtwarzaj wzory z pamięci, zanim pokażesz prawidłową wersję."><label>Temat<select value={topic} onChange={e=>{setTopic(e.target.value);setReveal(false);setCloze('')}}>{datasets.map(t=><option key={t.id} value={t.id}>{t.name}</option>)}</select></label><div className="scp-exercise"><p>Bez podglądania zapisz definicję lub wzór dla: <b>{current.name}</b></p><textarea rows={4} value={cloze} onChange={e=>setCloze(e.target.value)} placeholder="Z pamięci..."/><Action onClick={()=>setReveal(!reveal)}>{reveal?'Ukryj wzór':'Odkryj odpowiedź'}</Action>{reveal&&<p className="scp-feedback">{current.brief}</p>}</div></Section>}
 {mode==='exam'&&<Section title="Mini-egzamin praktyczny" sub="Bez podpowiedzi podczas testu. Wynik trafia do historii odpowiedzi."><p>Rozwiąż pięć zadań liczbowych z różnych tematów. Możesz wylosować kolejną wersję.</p><Action onClick={()=>{setExerciseMode('exam');setLevel(0);pickTask(datasets[0].id);setMode('exam-running')}}>Rozpocznij egzamin</Action></Section>}
 {mode==='exam-running'&&<Section title={`Egzamin · zadanie ${level+1}/5`} sub="Odpowiedz, a następnie przejdź do kolejnego zadania."><strong>{task?.q}</strong><label>Wynik<input value={answer} onChange={e=>setAnswer(e.target.value)} onKeyDown={e=>e.key==='Enter'&&submit()}/></label><Action onClick={submit} disabled={!!result&&!result.startsWith('Wpisz')}>Zatwierdź</Action>{result&&<><p className="scp-feedback">{result}</p><Action onClick={()=>{if(level>=4){setMode('graph')}else{const next=level+1;setLevel(next);pickTask(datasets[next%datasets.length].id)}}}>{level>=4?'Zakończ egzamin':'Następne zadanie'}</Action></>}</Section>}
 {mode==='rescue'&&<Section title="Tryb ratunkowy przed kolokwium" sub="Najpierw najtrudniejsze lub jeszcze niećwiczone zagadnienia. Nie zastępuje pełnego przygotowania."><label>Ile minut masz?<input type="number" min="5" max="180" value={duration} onChange={e=>setDuration(Math.max(5,Number(e.target.value)||5))}/></label><div className="scp-exercise"><b>Plan na {duration} min:</b>{weak.slice(0,Math.max(1,Math.min(6,Math.floor(duration/7)))).map(t=><div key={t.id} className="scp-list"><span>{t.name} ({t.rate===null?'brak danych':`${t.rate}%`})</span><Action secondary onClick={()=>{setMode('trainer');pickTask(t.id)}}>Ćwicz</Action></div>)}</div></Section>}
 {mode==='mistakes'&&<Section title="Dziennik błędów i powtórki" sub="Automatycznie zestawione pomyłki z całego Centrum Nauki."><div className="scp-row"><Tag>{mistakes.length} błędnych odpowiedzi w ostatnich 120 próbach</Tag></div>{mistakes.length?mistakes.slice(0,25).map((a,i)=><div className="scp-mistake" key={`${a.id}-${i}`}><strong>{a.question||'Zadanie'}</strong><p>Twoja odpowiedź: {String(a.given??'—')} · Poprawnie: {String(a.answer??'—')}</p>{a.why&&<small>{a.why}</small>}</div>):<p>Brak zapisanych błędów — wykonaj zadania w trenerze.</p>}</Section>}
 <p className="scp-foot">Wersja 5.3 · dane wyników zapisywane przez istniejący mechanizm StudyLab · algorytmy sprawdzające mają ograniczenia i nie zastępują prowadzącego.</p></div>
}
