import React, {useMemo,useState} from 'react';
import '../styles/mathI.css';
const _parse=(s)=>[...new Set(String(s).split(/[,;\s]+/).map(v=>Number(v)).filter(v=>Number.isFinite(v)))].sort((a,b)=>a-b);
const _fmt=a=>a.length?`{ ${a.join(', ')} }`:'∅';
const _button=(v,set)=> <button type="button" className="mi-chip" aria-pressed={!!v} onClick={()=>set(v?0:1)}>{v}</button>;
function Wrap({label,desc,children}){return <section className="mi-lab not-content"><div className="mi-lab-head"><span className="mi-lab-icon">✧</span><div><strong>{label}</strong><p>{desc}</p></div><span className="mi-live">INTERAKTYWNE</span></div><div className="mi-lab-body">{children}</div></section>}
function Value({label,value,note}){return <div className="mi-value"><small>{label}</small><strong>{value}</strong>{note&&<small>{note}</small>}</div>}
export function LogicLab(){const[p,setP]=useState(1),[q,setQ]=useState(0);const and=p&q,or=p|q,impl=(!p||q)?1:0,eq=p===q?1:0;return <Wrap label="Laboratorium: dwa zdania logiczne" desc="Klikaj wartości 0 i 1. Wyniki wszystkich spójników zmieniają się od razu."><div className="mi-pair"><div className="mi-switchline"><span>Zdanie p</span>{_button(p,setP)}</div><div className="mi-switchline"><span>Zdanie q</span>{_button(q,setQ)}</div></div><div className="mi-grid mi-grid-5"><Value label="¬p" value={1-p}/><Value label="p ∧ q" value={and}/><Value label="p ∨ q" value={or}/><Value label="p ⇒ q" value={impl}/><Value label="p ⇔ q" value={eq}/></div><p className="mi-hint">Implikacja jest fałszywa tylko wtedy, gdy p=1 i q=0. Alternatywa pozostaje prawdziwa także dla p=1 i q=1.</p></Wrap>}
const FORMULAS=[{title:'De Morgan: ¬(p∧q) ⇔ (¬p∨¬q)',headers:['p','q','¬(p∧q)','¬p∨¬q','⇔'],make:(p,q)=>{const a=1-(p&q),b=(1-p)|(1-q);return [p,q,a,b,+(a===b)]}},{title:'Kontrapozycja: (p⇒q) ⇔ (¬q⇒¬p)',headers:['p','q','p⇒q','¬q⇒¬p','⇔'],make:(p,q)=>{const a=+(!p||q),b=+(!!q||!p);return [p,q,a,b,+(a===b)]}},{title:'Odwrócenie: (p⇒q) ⇔ (q⇒p)',headers:['p','q','p⇒q','q⇒p','⇔'],make:(p,q)=>{const a=+(!p||q),b=+(!q||p);return[p,q,a,b,+(a===b)]}}];
export function TruthTableLab(){const[k,setK]=useState(0),[hide,setHide]=useState(false);const f=FORMULAS[k];const rows=[[0,0],[0,1],[1,0],[1,1]].map(([p,q])=>f.make(p,q));const tautology=rows.every(r=>r[r.length-1]===1);return <Wrap label="Laboratorium: tabela prawdy" desc="Wybierz formułę i sprawdź, czy jest tautologią (same jedynki w ostatniej kolumnie)."><div className="mi-controls"><label>Wzór<select value={k} onChange={e=>setK(+e.target.value)}>{FORMULAS.map((f,i)=><option key={i} value={i}>{f.title}</option>)}</select></label><button type="button" onClick={()=>setHide(v=>!v)}>{hide?'Pokaż wynik':'Zakryj wynik'}</button></div><div className="mi-scroll"><table className="mi-table"><thead><tr>{f.headers.map((h,i)=><th key={i}>{h}</th>)}</tr></thead><tbody>{rows.map((r,i)=><tr key={i}>{r.map((v,j)=><td key={j} className={j===4?'mi-result-cell':''}>{j===4&&hide?'?':v}</td>)}</tr>)}</tbody></table></div><p className="mi-hint">{hide?'Odkryj końcową kolumnę, kiedy sam policzysz wartości.':tautology?'W ostatniej kolumnie są same 1 — formuła jest tautologią.':'Występuje przynajmniej jedno 0 — formuła NIE jest tautologią.'}</p></Wrap>}
export function SetsLab(){const[a,setA]=useState('1,2,3,5'),[b,setB]=useState('2,4,5');const A=_parse(a),B=_parse(b),union=[...new Set([...A,...B])].sort((x,y)=>x-y),intersection=A.filter(v=>B.includes(v)),aonly=A.filter(v=>!B.includes(v)),bonly=B.filter(v=>!A.includes(v));return <Wrap label="Laboratorium: działania na zbiorach" desc="Podawaj elementy oddzielone przecinkami. Obliczymy sumę, przecięcie i obie różnice."><div className="mi-controls"><label>Zbiór A<input value={a} onChange={e=>setA(e.target.value)}/></label><label>Zbiór B<input value={b} onChange={e=>setB(e.target.value)}/></label></div><div className="mi-venn" aria-label="Schemat Venna"><svg viewBox="0 0 460 200" role="img" aria-label="Dwa nachodzące na siebie koła A i B"><circle cx="184" cy="96" r="83" fill="#996dff20" stroke="#c5a7ff" strokeWidth="2"/><circle cx="276" cy="96" r="83" fill="#59d7d522" stroke="#63ddd1" strokeWidth="2"/><text x="130" y="90" fill="#e9ddff" textAnchor="middle" fontSize="15">{aonly.slice(0,4).join(', ')||'—'}</text><text x="230" y="97" fill="#fff" textAnchor="middle" fontWeight="700" fontSize="15">{intersection.slice(0,4).join(', ')||'—'}</text><text x="329" y="90" fill="#d6fff6" textAnchor="middle" fontSize="15">{bonly.slice(0,4).join(', ')||'—'}</text><text x="133" y="190" fill="#c5a7ff" fontSize="15">A</text><text x="322" y="190" fill="#63ddd1" fontSize="15">B</text></svg></div><div className="mi-grid mi-grid-2"><Value label="A ∪ B" value={_fmt(union)}/><Value label="A ∩ B" value={_fmt(intersection)}/><Value label="A ∖ B" value={_fmt(aonly)}/><Value label="B ∖ A" value={_fmt(bonly)}/></div></Wrap>}
export function AbsoluteLab(){const[center,setCenter]=useState(-3),[r,setR]=useState(2),[closed,setClosed]=useState(true);const a=center-r,b=center+r;const l=-12,R=12,coord=x=>30+(x-l)/(R-l)*440;return <Wrap label="Laboratorium: moduł i przedziały" desc="Przesuwaj środek i promień. Zobaczysz rozwiązanie |x−a| ≤ r lub |x−a| < r."><div className="mi-controls"><label>Środek a: <b>{center}</b><input type="range" min="-7" max="7" value={center} onChange={e=>setCenter(+e.target.value)}/></label><label>Promień r: <b>{r}</b><input type="range" min="1" max="5" value={r} onChange={e=>setR(+e.target.value)}/></label><label>Rodzaj nierówności<select value={closed?'closed':'open'} onChange={e=>setClosed(e.target.value==='closed')}><option value="closed">≤ — końce należą</option><option value="open">&lt; — końce nie należą</option></select></label></div><svg viewBox="0 0 500 128" width="100%" role="img" aria-label="Oś liczbowa z zaznaczonym przedziałem"><line x1="20" x2="480" y1="62" y2="62" stroke="#a5a5b7" strokeWidth="2"/><path d="M471 56L480 62 471 68" fill="none" stroke="#a5a5b7"/>{Array.from({length:13},(_,i)=>i*2-12).map(x=><g key={x}><line x1={coord(x)} x2={coord(x)} y1="56" y2="68" stroke="#737386"/><text x={coord(x)} y="88" fontSize="11" textAnchor="middle" fill="#a4a4b8">{x}</text></g>)}<line x1={coord(a)} x2={coord(b)} y1="62" y2="62" stroke="#ba9cff" strokeWidth="9" strokeLinecap="round"/><circle cx={coord(a)} cy="62" r="7" stroke="#d8caff" strokeWidth="3" fill={closed?'#ba9cff':'#09090e'}/><circle cx={coord(b)} cy="62" r="7" stroke="#d8caff" strokeWidth="3" fill={closed?'#ba9cff':'#09090e'}/><text x={coord(a)} y="35" fontSize="16" textAnchor="middle" fill="#e4d7ff">{a}</text><text x={coord(b)} y="35" fontSize="16" textAnchor="middle" fill="#e4d7ff">{b}</text></svg><div className="mi-grid mi-grid-2"><Value label="Nierówność" value={`|x${center>=0?'−'+center:'+'+(-center)}| ${closed?'≤':'<'} ${r}`}/><Value label="Przedział" value={`${closed?'[':'('}${a}, ${b}${closed?']':')'}`}/></div></Wrap>}
export function InverseLab(){const[mode,setMode]=useState('lin'),[x,setX]=useState(2);const modes={lin:{label:'f(x)=2x+3',f:v=>2*v+3,inv:y=>(y-3)/2,domain:'x ∈ ℝ'},cubic:{label:'f(x)=x³+5',f:v=>v**3+5,inv:y=>Math.cbrt(y-5),domain:'x ∈ ℝ'},square:{label:'f(x)=x²−2x, x≥1',f:v=>v*v-2*v,inv:y=>1+Math.sqrt(Math.max(0,y+1)),domain:'x ≥ 1'}};const cfg=modes[mode];const safeX=mode==='square'?Math.max(1,x):x,y=cfg.f(safeX),back=cfg.inv(y);return <Wrap label="Laboratorium: funkcja odwrotna" desc="Zobacz, jak argument przechodzi do wyniku, a funkcja odwrotna przywraca argument."><div className="mi-controls"><label>Wybierz funkcję<select value={mode} onChange={e=>setMode(e.target.value)}><option value="lin">f(x)=2x+3</option><option value="cubic">f(x)=x³+5</option><option value="square">f(x)=x²−2x, x≥1</option></select></label><label>Argument x: <b>{safeX}</b><input type="range" min={mode==='square'?1:-4} max="5" step="1" value={safeX} onChange={e=>setX(+e.target.value)}/></label></div><div className="mi-flow"><div><small>argument</small><strong>{safeX}</strong></div><span>f →</span><div><small>wartość</small><strong>{y}</strong></div><span>f⁻¹ →</span><div><small>z powrotem</small><strong>{Number(back.toFixed(5))}</strong></div></div><p className="mi-hint">Dla funkcji kwadratowej ograniczenie x≥1 jest niezbędne. Bez niego dwóm argumentom mogłaby odpowiadać ta sama wartość.</p></Wrap>}
const DOMAIN_MODES=[{name:'1/(x−2)',ok:x=>Math.abs(x-2)>1e-8,why:'Mianownik nie może być równy 0.'},{name:'√(x−3)',ok:x=>x>=3,why:'Wnętrze pierwiastka parzystego stopnia musi być ≥ 0.'},{name:'1/√(x²−1)',ok:x=>x*x>1,why:'Pierwiastek w mianowniku musi mieć zawartość > 0.'},{name:'log₃(x+2)',ok:x=>x>-2,why:'Argument logarytmu musi być > 0.'}];
export function DomainLab(){const[k,setK]=useState(0),[x,setX]=useState(0);const fn=DOMAIN_MODES[k],ok=fn.ok(x);return <Wrap label="Laboratorium: test dziedziny funkcji" desc="Wybierz wzór i sprawdź dowolny argument — zielony oznacza, że można go podstawić."><div className="mi-controls"><label>Funkcja<select value={k} onChange={e=>setK(+e.target.value)}>{DOMAIN_MODES.map((f,i)=><option key={i} value={i}>{f.name}</option>)}</select></label><label>Argument x = {x}<input type="range" min="-6" max="6" step="0.5" value={x} onChange={e=>setX(+e.target.value)}/></label></div><div className={`mi-verdict ${ok?'mi-verdict-ok':'mi-verdict-bad'}`}><strong>{ok?'✓ Można podstawić':'× Poza dziedziną'}</strong><span>{fn.why}</span></div><div className="mi-hint">Spróbuj wartości granicznej — np. dla pierwiastka sprawdź x=3, a dla logarytmu x=−2.</div></Wrap>}
