<file path="src/components/studycenter/studycenter-advanced.css">
.sca-root{max-width:1100px;color:var(--sl-color-text)}
.sca-panel{padding:clamp(1rem,3vw,1.7rem);border-radius:18px;background:var(--sl-color-bg-nav);border:1px solid var(--sl-color-gray-5)}
.sca-panel h3{font-size:1.35rem;margin:0 0 .5rem}.sca-panel h4{margin:1rem 0 .5rem;font-size:1rem}
.sca-muted{color:var(--sl-color-gray-3);line-height:1.6}.sca-stats,.sca-row{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;margin:1rem 0}
.sca-stats span{border:1px solid var(--sl-color-gray-5);border-radius:12px;padding:.6rem .9rem;font-size:.85rem}.sca-stats b{margin-left:.5rem;color:#4ade80}
.sca-root label{display:flex;flex-direction:column;gap:.45rem;flex:1;min-width:180px;font-size:.9rem;margin:.8rem 0}.sca-root label:has(input[type=checkbox]){flex-direction:row;align-items:center;min-width:80px;flex:0}
.sca-root input:not([type=range]):not([type=checkbox]),.sca-root select,.sca-root textarea{display:block;width:100%;max-width:100%;box-sizing:border-box;color:var(--sl-color-text);background:var(--sl-color-bg);border:1px solid var(--sl-color-gray-5);padding:.75rem .85rem;border-radius:10px;font:inherit}
.sca-root input[type=range]{width:100%;accent-color:#22c55e}.sca-root input[type=checkbox]{accent-color:#22c55e}
.sca-button{font:inherit;cursor:pointer;background:#15803d;color:#fff;border:1px solid #15803d;border-radius:10px;padding:.68rem .95rem;font-weight:650;line-height:1.4}.sca-button.sca-alt{background:transparent;color:var(--sl-color-text);border-color:var(--sl-color-gray-5)}.sca-button:hover{filter:brightness(1.1)}.sca-button:disabled{opacity:.55;cursor:not-allowed}
.sca-root button:focus-visible,.sca-root input:focus-visible,.sca-root textarea:focus-visible,.sca-root select:focus-visible{outline:2px solid #4ade80;outline-offset:2px}
.sca-task{margin-top:1rem;border:1px solid var(--sl-color-gray-5);border-radius:14px;padding:clamp(.9rem,2.5vw,1.4rem)}.sca-question span,.sca-current span{display:block;letter-spacing:.07em;text-transform:uppercase;font-size:.7rem;color:#4ade80;font-weight:800;margin-bottom:.4rem}.sca-question strong{font-size:1.08rem;line-height:1.55}
.sca-progress{display:flex;gap:.3rem;margin:1.2rem 0}.sca-progress span{height:7px;flex:1;border-radius:99px;background:var(--sl-color-gray-5)}.sca-progress .sca-active{background:#facc15}.sca-progress .sca-done{background:#22c55e}
.sca-history{margin:.5rem 0;padding:.55rem .75rem;background:rgba(34,197,94,.07);border-radius:10px;border:1px solid rgba(34,197,94,.16)}.sca-history span{color:#4ade80}.sca-history small{display:block;color:var(--sl-color-gray-3);margin-top:.2rem}
.sca-current{margin:.85rem 0}.sca-current h4{margin:0}.sca-hint,.sca-message,.sca-finished{padding:.85rem 1rem;border-radius:10px;margin:1rem 0;line-height:1.6}
.sca-hint{background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.27)}.sca-ok,.sca-finished{background:rgba(34,197,94,.07);border:1px solid rgba(34,197,94,.24)}.sca-error{background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.30)}
.sca-editor{font-family:Consolas,'Courier New',monospace!important;line-height:1.6!important;min-height:230px;resize:vertical;tab-size:4}
.sca-report{margin:1.2rem 0;border-top:1px solid var(--sl-color-gray-5);padding-top:.7rem}.sca-diagnostic{padding:.65rem .8rem;border-radius:8px;margin:.5rem 0}.sca-warn{background:rgba(245,158,11,.1)}.sca-error{background:rgba(239,68,68,.12)}.sca-info{background:rgba(59,130,246,.1)}
.sca-task ul{padding-left:1.4rem}.sca-task li{margin:.5rem 0}.sca-task details{margin-top:1rem;padding:.9rem;border:1px solid var(--sl-color-gray-5);border-radius:10px}.sca-task summary{cursor:pointer;font-weight:650}
.sca-value{margin:1.1rem 0;padding:1.1rem;border-radius:11px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.22);font-family:Consolas,monospace;font-size:clamp(.93rem,2.4vw,1.13rem);overflow-wrap:anywhere}
.sca-table{overflow-x:auto}.sca-table table{border-collapse:collapse;min-width:230px;width:100%;text-align:center}.sca-table td,.sca-table th{border-bottom:1px solid var(--sl-color-gray-5);padding:.65rem}.sca-table .sca-highlight{background:rgba(34,197,94,.16);font-weight:800}
.sca-meter{height:14px;border-radius:10px;background:var(--sl-color-gray-5);overflow:hidden}.sca-meter div{height:100%;background:#22c55e;transition:width .12s}
.sca-bits{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:clamp(.2rem,1vw,.65rem)}.sca-bit{min-height:70px;cursor:pointer;background:var(--sl-color-bg);color:var(--sl-color-text);border:1px solid var(--sl-color-gray-5);border-radius:9px;display:flex;flex-direction:column;gap:.4rem;align-items:center;justify-content:center}.sca-bit-on{border-color:#4ade80;background:rgba(34,197,94,.14)}.sca-bit small{font-size:.7rem}.sca-bit b{font-size:1.25rem}
@media(max-width:500px){.sca-panel{padding:.8rem}.sca-bits{gap:.15rem}.sca-bit{min-height:56px;border-radius:5px}.sca-bit small{font-size:.6rem}.sca-bit b{font-size:1rem}}
</file>

