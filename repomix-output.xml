 return <>
  <SectionTitle eyebrow="PRZEGLĄD" title="Twoja nauka"><SmallTag>{stats.streak>0?`${stats.streak} dni aktywności`:'Pierwsza sesja czeka'}</SmallTag></SectionTitle>
