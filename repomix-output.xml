.m2-chapter-divider span{display:inline-block;padding-bottom:11px;font-size:.74rem;letter-spacing:.12em;font-weight:820;color:#63e7d7}
.m2-selfcheck{background:#0b1c22;border:1px solid #336064;border-radius:12px;padding:14px 18px;margin:1.5rem 0;color:#cee3eb}
.m2-selfcheck summary{cursor:pointer;font-weight:730;color:#d5f9f3;line-height:1.6}
.m2-selfcheck summary:focus-visible{outline:2px solid #6feede;outline-offset:5px}
.m2-selfcheck[open] summary{margin-bottom:14px;color:#6feede}
.m2-selfcheck p{line-height:1.7}
@media(max-width:690px){.m2-learning-visual{border-radius:15px}.m2-learning-visual img{min-width:620px}.m2-study-path{padding:13px 15px;font-size:.85rem}.m2-learning-visual__scroll:after{content:'PRZESUŃ GRAFIKĘ W BOK →';display:block;background:#0a141c;color:#8cb8b7;text-align:center;font-size:.69rem;letter-spacing:.1em;padding:7px}}
@media print{.m2-learning-visual{box-shadow:none!important;break-inside:avoid}.m2-learning-visual__scroll{overflow:visible!important}.m2-learning-visual img{min-width:0!important;max-width:100%!important}.m2-selfcheck{break-inside:avoid}.m2-selfcheck:not([open]){display:none!important}}


/* StudyLab 10.0 BLACK Edition / Physics — educational diagrams, accessible memory practice */
.ph3-study-path,.ph3-figure,.ph3-divider,.ph3-selfcheck{box-sizing:border-box}
.ph3-study-path{display:grid;gap:9px;margin:17px 0;padding:17px 20px;border-radius:15px;background:linear-gradient(125deg,#092027,#070c13);border:1px solid #294e54;border-left:4px solid #5ce2d1;color:#b8d4dc;line-height:1.72;font-size:.9rem}
.ph3-study-path strong{font-size:.72rem;letter-spacing:.1em;color:#7df5e3;font-weight:810}
.ph3-figure{margin:1.4rem 0 2rem;background:linear-gradient(160deg,#0b1118,#05080c);border:1px solid #29414b;border-radius:19px;overflow:hidden;box-shadow:0 17px 37px #0005}
.ph3-figure__scroll{overflow-x:auto;scrollbar-color:#54d8c4 #15242c;overscroll-behavior-inline:contain}
.ph3-figure img{display:block;width:100%;min-width:650px;height:auto}
.ph3-figure figcaption{margin:0;padding:15px 20px 18px;border-top:1px solid #263a45;color:#b6cad3;line-height:1.65;font-size:.86rem}
.ph3-figure figcaption strong{color:#eafcf8}
.ph3-divider{margin:3rem 0 1.4rem;border-bottom:1px solid #2c444d}
.ph3-divider span{display:inline-block;padding-bottom:12px;font-size:.74rem;letter-spacing:.105em;font-weight:820;color:#6debdc}
.ph3-selfcheck{margin:1.5rem 0;background:#0b1c23;border:1px solid #356269;border-radius:13px;padding:15px 19px;color:#d0e6eb}
.ph3-selfcheck summary{cursor:pointer;color:#d8f9f3;font-size:.96rem;font-weight:730;line-height:1.65}
.ph3-selfcheck summary:focus-visible{outline:2px solid #69f1e0;outline-offset:5px}
.ph3-selfcheck[open] summary{color:#7aeee0;margin-bottom:12px}
.ph3-selfcheck p{line-height:1.76}
@media(max-width:710px){.ph3-figure{border-radius:15px}.ph3-figure img{min-width:650px}.ph3-study-path{padding:15px;font-size:.87rem}.ph3-figure__scroll:after{content:'PRZESUŃ SCHEMAT W BOK →';display:block;text-align:center;padding:7px;color:#9bc2c5;background:#0b1820;font-size:.7rem;letter-spacing:.1em}}
