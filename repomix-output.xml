/* StudyLab 7.2 — component-scoped, container-responsive BLACK Edition */
.scn-root{min-width:0;width:100%;color:#e9f5ef;display:grid;gap:18px;container-type:inline-size}
.scn-root *{box-sizing:border-box;min-width:0}
.scn-hero{background:radial-gradient(ellipse at 95% 0%,#20513f70,transparent 60%),#0c1613;border:1px solid #305445;border-radius:18px;padding:clamp(18px,3vw,30px)}
.scn-hero h2{margin:8px 0!important;font-weight:800;font-size:clamp(22px,3vw,34px)!important;color:#f3fff7;letter-spacing:-.045em}
.scn-hero p{color:#bad3c6!important;font-size:13px;line-height:1.6;margin:0}
.scn-tabs{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid #304a3f;padding-bottom:13px}
.scn-tabs button,.scn-editor-tools button{min-height:42px;padding:9px 13px;background:#182720;border:1px solid #365748;border-radius:9px;color:#d6eddf;font:600 12px/1.35 inherit;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;text-align:center}
.scn-tabs button.active,.scn-tabs button[aria-pressed=true]{color:#082319;background:#83e2b2;border-color:#b0f8d1}
.scn-root .sc-panel{margin:0;max-width:100%;overflow-wrap:anywhere}
.scn-section-header{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:10px}
.scn-section-header h2{margin:4px 0!important;font-size:clamp(18px,2.5vw,25px);color:#effdf5}
.scn-guide{border-left:3px solid #70be99;background:#14251c;border-radius:7px;padding:12px 14px;color:#bacdc1!important;font-size:12px!important;line-height:1.7;margin:0}
.scn-map{display:flex;flex-direction:column;align-items:stretch;max-width:700px;margin:20px auto}
.scn-node{display:grid;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:14px;width:100%;min-height:82px;padding:14px;text-align:left;cursor:pointer;color:#eaf8f0;border:1px solid #355b48;border-radius:12px;background:#12241b}
.scn-node.selected{border-color:#a2edc5;box-shadow:0 0 0 2px #8be9bb21;background:#173729}
.scn-node-index{height:38px;display:grid;place-items:center;background:#24573e;border-radius:10px;color:#b9f4d4;font-weight:750}
.scn-node strong,.scn-notes-list strong{display:block;font-size:14px;line-height:1.3}.scn-node small,.scn-notes-list small{display:block;color:#a7c6b5;font-size:11px;line-height:1.5;margin-top:4px}
.scn-edge{text-align:center;color:#6fb899;padding:4px;line-height:1.1;display:grid;justify-content:center}.scn-edge small{font-size:10px;color:#93aa9d}
.scn-level{white-space:nowrap;font-size:11px;font-weight:750;border:1px solid #7e6759;border-radius:40px;padding:6px 9px;background:#423021;color:#ffd4aa}
.scn-level.good{background:#174331;border-color:#468a67;color:#adf6ce}.scn-level.mid{background:#3f3520;border-color:#887444;color:#f4dfa5}.scn-level.low{background:#382522;border-color:#844b42;color:#f0b4a9}
.scn-action-link,.scn-file{display:inline-flex;min-height:40px;align-items:center;justify-content:center;text-align:center;background:#194d38;color:#d1ffe8;border:1px solid #4c9770;border-radius:9px;padding:10px 14px;text-decoration:none!important;font-size:12px;font-weight:750;cursor:pointer}
.scn-file input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.scn-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px 0}
.scn-metrics>div{min-width:0;border:1px solid #32513f;border-radius:11px;padding:15px 11px;display:flex;flex-direction:column;gap:7px;background:#15271e}
.scn-metrics strong{font-size:clamp(19px,3vw,27px);line-height:1.2;overflow-wrap:anywhere;color:#b2f3cf}.scn-metrics span{color:#bad1c2;font-size:11px;line-height:1.4}
.scn-review-list{display:grid;gap:10px;margin:16px 0}.scn-review-list article{display:flex;gap:10px;justify-content:space-between;align-items:center;padding:15px;border:1px solid #365041;border-radius:10px;background:#12231a}
.scn-review-list h3{font-size:15px!important;margin:4px 0!important}.scn-review-list p{font-size:12px!important;color:#b9ccc0!important;margin:0}.scn-review-list small{color:#7cbd9f}.scn-review-side{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.scn-editor-grid{display:grid;grid-template-columns:minmax(145px,195px) minmax(0,1fr);gap:14px;margin-top:16px}
.scn-notes-list{display:grid;align-content:start;gap:7px;max-height:600px;overflow:auto;padding:2px}
.scn-notes-list button{background:#0e1e16;border:1px solid #325443;color:#e7faef;text-align:left;border-radius:8px;padding:12px;cursor:pointer;min-height:61px}
.scn-notes-list button.selected{background:#224935;border-color:#a0e5bd}.scn-note-main{display:grid;gap:12px}
.scn-fields{display:grid;grid-template-columns:minmax(0,2fr) minmax(145px,1fr);gap:10px}
.scn-root .sc-field input,.scn-root .sc-field select,.scn-root .sc-field textarea{max-width:100%;width:100%;min-width:0}
.scn-editor-tools{display:flex;flex-wrap:wrap;gap:6px}.scn-editor-tools button{min-height:36px;padding:8px 11px}
.scn-note-main textarea{font-family:Consolas,'Cascadia Code',monospace;font-size:12px!important;line-height:1.6;resize:vertical;white-space:pre-wrap;tab-size:2}
.scn-note-main .sc-actions{align-items:center;gap:7px}
.scn-delete{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 12px;border:1px solid #914e4e;background:#391f24;color:#ffd4d4;border-radius:9px;cursor:pointer}
.scn-preview{overflow:hidden;border:1px solid #365b46;border-radius:11px;background:#0c1811;padding:20px;min-height:150px}
.scn-print-title{font-size:23px!important;color:#edfff5!important;margin:0 0 18px!important}.scn-preview-content{line-height:1.7;color:#e2eee7;overflow-wrap:anywhere}.scn-preview-content h2,.scn-preview-content h3,.scn-preview-content h4{color:#dcffeb!important;margin:12px 0 8px!important;line-height:1.35}.scn-preview-content p{margin:4px 0!important;font-size:13px!important}.scn-preview-content blockquote{border-left:3px solid #61bb8a;margin:9px 0;padding:8px 13px;color:#c4d9cd;background:#153021}.scn-preview-content pre{background:#060e0b;color:#d4f7e2;overflow:auto;padding:13px;border-radius:8px;font-size:12px}
.scn-preview-content .scn-tableline{display:flex;flex-wrap:wrap;gap:0;margin:5px 0}.scn-tableline>span{border:1px solid #40614f;flex:1 1 100px;padding:7px;font-size:12px}.scn-img{max-width:100%;max-height:500px;object-fit:contain;border-radius:8px;display:block;margin:12px 0}.scn-emptyline{height:8px}.scn-listline{padding-left:14px;font-size:13px}
.scn-math{max-width:100%;display:inline-block;vertical-align:middle;overflow-x:auto}
.scn-empty-state{border:1px dashed #456b50;border-radius:9px;padding:24px;text-align:center;color:#b5d1bf;margin-top:16px}
.scn-bars{height:142px;display:grid;grid-template-columns:repeat(28,minmax(0,1fr));gap:5px;padding:10px 3px;border-bottom:1px solid #46634d;align-items:end}
.scn-bar-slot{height:100%;display:flex;align-items:end;min-width:0}.scn-bar-slot>span{display:block;width:100%;background:linear-gradient(0deg,#2b865b,#8ce8b2);border-radius:4px 4px 0 0;min-height:3px}
.scn-topic-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin:12px 0 18px}.scn-topic-stats>div{border:1px solid #334c3f;padding:12px;border-radius:9px;background:#102018;display:grid;gap:7px;font-size:12px}.scn-topic-stats small{color:#b3caba;font-size:11px}
