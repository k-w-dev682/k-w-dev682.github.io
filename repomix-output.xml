CARD_DETAILS.v2cf02=['Gdy oba operandy mają typ int, C++ wykonuje dzielenie całkowitoliczbowe i odrzuca część ułamkową wyniku w kierunku zera.','int — typ liczby całkowitej; / — operator dzielenia.','7 / 3 daje 2; −7 / 3 daje −2.'];
CARD_DETAILS.v2af01=['Aby otrzymać −5 w czterobitowym U2, zapisz +5 jako 0101, odwróć bity i dodaj 1.','U2 — uzupełnienia do dwóch; 4 bity — ustalona długość zapisu.','0101 → 1010 → +1 = 1011, czyli −5.'];
