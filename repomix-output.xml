import React,{useState} from 'react';
import '../styles/electronics.css';
const n=(x,lo=-Infinity,hi=Infinity)=>Math.min(hi,Math.max(lo,Number(x)||0));
const fmt=(x,d=3)=>!Number.isFinite(x)?'—':new Intl.NumberFormat('pl-PL',{maximumFractionDigits:d}).format(x);
function Wrap({title,description,children}){return <section className="el-lab not-content"><header className="el-lab-head"><span className="el-orb">✦</span><div><strong>{title}</strong><small>{description}</small></div><span className="el-live">NA ŻYWO</span></header><div className="el-lab-body">{children}</div></section>}
function NumberField({label,value,onChange,min,max,step=1,unit=''}){return <label className="el-input"><span>{label}</span><div><input type="number" value={value} min={min} max={max} step={step} onChange={e=>onChange(Number(e.target.value))}/><b>{unit}</b></div></label>}
function Slider({label,value,set,min,max,step=1,unit=''}){return <label className="el-slider"><span>{label} <strong>{fmt(value,3)} {unit}</strong></span><input type="range" min={min} max={max} step={step} value={value} onChange={e=>set(Number(e.target.value))}/></label>}
function Result({label,value,detail}){return <div className="el-result"><small>{label}</small><strong>{value}</strong>{detail&&<small>{detail}</small>}</div>}
function Note({children}){return <div className="el-note">{children}</div>}
const EPS=8.8541878128e-12, K=8.9875517923e9;
function Arrows({reverse=false,both=false}){let angles=Array.from({length:8},(_,i)=>i*Math.PI/4);return <svg className="el-viz" viewBox="0 0 480 210" role="img" aria-label="Kierunki linii pola elektrycznego od ładunku"><defs><marker id="elArrow" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6" fill="none" stroke="#fbbf75" strokeWidth="1.5"/></marker></defs><circle cx="240" cy="104" r="22" fill={reverse?'#18233d':'#4b271a'} stroke={reverse?'#7db2fc':'#ffc078'} strokeWidth="2"/><text x="240" y="113" textAnchor="middle" fontSize="28" fill="white" fontWeight="700">{reverse?'−':'+'}</text>{angles.map((a,i)=>{let r1=37,r2=86;let x1=240+Math.cos(a)*(reverse?r2:r1),y1=104+Math.sin(a)*(reverse?r2:r1),x2=240+Math.cos(a)*(reverse?r1:r2),y2=104+Math.sin(a)*(reverse?r1:r2);return <line key={i} x1={x1} y1={y1} x2={x2} y2={y2} stroke="#fbbf75" strokeWidth="2" markerEnd="url(#elArrow)"/>})}</svg>}
export function ChargeLab(){let[I,setI]=useState(200),[t,setT]=useState(5);let q=n(I)*1e-3*n(t);return <Wrap title="Ładunek a prąd" description="Podstaw do Q = I × t i zobacz, jak rośnie przepływający ładunek."><div className="el-control-grid"><NumberField label="Stały prąd" unit="mA" value={I} onChange={setI} min={0} step={50}/><NumberField label="Czas" unit="s" value={t} onChange={setT} min={0} step={1}/></div><div className="el-results"><Result label="Ładunek Q" value={`${fmt(q,6)} C`}/><Result label="To samo w mC" value={`${fmt(q*1e3,3)} mC`}/></div><Note><b>Podstawienie:</b> Q = ({fmt(I)} × 0,001 A) × {fmt(t)} s = {fmt(q,6)} C. Jednostka ładunku to A·s.</Note></Wrap>}
export function CoulombLab(){let[a,setA]=useState(2),[b,setB]=useState(-3),[r,setR]=useState(30);const x=n(r,1)*0.01,force=K*Math.abs(a*b)*1e-12/(x*x);return <Wrap title="Siła Coulomba" description="Zmieniaj oba ładunki i odległość — kierunek siły zależy od znaków."><div className="el-control-grid"><NumberField label="Ładunek q₁" unit="µC" value={a} onChange={setA} step={1}/><NumberField label="Ładunek q₂" unit="µC" value={b} onChange={setB} step={1}/><Slider label="Odległość" value={r} set={setR} min={5} max={100} unit="cm"/></div><svg viewBox="0 0 500 145" className="el-viz" role="img" aria-label="Dwa ładunki na linii z opisem przyciągania lub odpychania"><line x1="100" y1="75" x2="400" y2="75" stroke="#566272" strokeDasharray="6 6" strokeWidth="2"/><circle cx="110" cy="75" r="28" fill="#39271b" stroke="#fec084" strokeWidth="2"/><circle cx="390" cy="75" r="28" fill="#39271b" stroke="#fec084" strokeWidth="2"/><text x="110" y="84" textAnchor="middle" fontSize="24" fill="#fff">{a>=0?'+':'−'}</text><text x="390" y="84" textAnchor="middle" fontSize="24" fill="#fff">{b>=0?'+':'−'}</text><text x="250" y="34" textAnchor="middle" fontSize="17" fill="#f3d1a3">{a*b<0?'Przyciąganie':a*b>0?'Odpychanie':'Brak siły przy zerowym ładunku'}</text><text x="250" y="124" textAnchor="middle" fontSize="14" fill="#a5b5c9">r = {r} cm</text></svg><div className="el-results"><Result label="Wartość siły" value={`${fmt(force,6)} N`}/><Result label="Zmiana odległości" value="F ∝ 1/r²"/></div><Note>Do wzoru na wartość siły podstawiamy moduł iloczynu ładunków. Znaki służą do ustalenia, czy jest przyciąganie, czy odpychanie.</Note></Wrap>}
export function SuperpositionLab(){let[a,setA]=useState(4),[b,setB]=useState(-7),[c,setC]=useState(1),sum=a+b+c;return <Wrap title="Superpozycja sił na jednej osi" description="Dodatnia siła działa w prawo, ujemna w lewo."><div className="el-control-grid"><NumberField label="Siła F₁" value={a} onChange={setA} unit="N"/><NumberField label="Siła F₂" value={b} onChange={setB} unit="N"/><NumberField label="Siła F₃" value={c} onChange={setC} unit="N"/></div><div className="el-results"><Result label="Suma ze znakiem" value={`${fmt(sum)} N`}/><Result label="Siła wypadkowa" value={`${fmt(Math.abs(sum))} N`} detail={sum>0?'w prawo':sum<0?'w lewo':'równowaga'}/></div><Note>F = ({a}) + ({b}) + ({c}) = {sum} N. Kierunek odczytujemy ze znaku wyniku.</Note></Wrap>}
export function FieldLab(){let[q,setQ]=useState(2),[r,setR]=useState(30);let mag=K*Math.abs(q)*1e-6/Math.pow(n(r,1)*.01,2);return <Wrap title="Pole dodatniego i ujemnego ładunku" description="Sprawdź kierunek linii pola i wartość natężenia."><div className="el-control-grid"><NumberField label="Ładunek źródłowy" value={q} onChange={setQ} unit="µC"/><Slider label="Odległość od ładunku" value={r} set={setR} min={5} max={100} unit="cm"/></div><Arrows reverse={q<0}/><div className="el-results"><Result label="Natężenie E" value={`${fmt(mag,1)} N/C`}/><Result label="Kierunek" value={q>0?'Na zewnątrz':q<0?'Do ładunku':'Brak pola'}/></div><Note>Natężenie maleje z kwadratem odległości. Dla ładunku ujemnego linie wskazują **do środka**.</Note></Wrap>}
export function FluxLab(){let[E,setE]=useState(200),[S,setS]=useState(.5),[angle,setAngle]=useState(60);let phi=E*S*Math.cos(angle*Math.PI/180),normalx=250+65*Math.cos(angle*Math.PI/180),normaly=95-65*Math.sin(angle*Math.PI/180);return <Wrap title="Strumień przez powierzchnię" description="Kąt α mierzymy od wektora normalnego do powierzchni."><div className="el-control-grid"><NumberField label="Natężenie pola E" value={E} onChange={setE} unit="N/C"/><NumberField label="Powierzchnia S" value={S} onChange={setS} unit="m²" step={.1}/><Slider label="Kąt α" value={angle} set={setAngle} min={0} max={180} unit="°"/></div><svg className="el-viz" viewBox="0 0 500 185" role="img" aria-label="Kąt między polem E a normalną do powierzchni"><path d="M110 95 H400" stroke="#80bffa" strokeWidth="4"/><path d="M389 86 L403 95 L389 104" fill="none" stroke="#80bffa" strokeWidth="3"/><text x="405" y="87" fill="#80bffa" fontSize="16">E</text><line x1="250" y1="95" x2={normalx} y2={normaly} stroke="#f9c17e" strokeWidth="4"/><circle cx="250" cy="95" r="6" fill="#f9c17e"/><text x={normalx+7} y={normaly-6} fill="#f9c17e" fontSize="15">n</text><text x="250" y="165" textAnchor="middle" fill="#b0beca" fontSize="13">Pole E — niebieskie; normalna n — bursztynowa</text></svg><div className="el-results"><Result label="Strumień Φ" value={`${fmt(phi,4)} N·m²/C`}/><Result label="cos α" value={fmt(Math.cos(angle*Math.PI/180),4)}/></div><Note>Φ = {fmt(E)} × {fmt(S)} × cos({fmt(angle)}°) = {fmt(phi,4)}. Gdy α=90°, strumień wynosi zero.</Note></Wrap>}
export function GaussLab(){let[q,setQ]=useState(3);let phi=q*1e-9/EPS;return <Wrap title="Prawo Gaussa: ładunek zamknięty" description="Zmiana ładunku wewnątrz powierzchni zmienia strumień całkowity."><Slider label="Ładunek wewnętrzny" value={q} set={setQ} min={-6} max={6} unit="nC"/><svg className="el-viz" viewBox="0 0 500 190" role="img" aria-label="Zamknięta powierzchnia Gaussa i ładunek w jej środku"><circle cx="250" cy="91" r="70" stroke="#82bdff" strokeWidth="2" strokeDasharray="6 8" fill="#85acff0b"/><circle cx="250" cy="91" r="22" fill="#372015" stroke="#f8b975" strokeWidth="2"/><text x="250" y="99" textAnchor="middle" fontSize="23" fill="white">{q>0?'+':q<0?'−':'0'}</text><text x="250" y="184" fill="#a3b2c5" textAnchor="middle" fontSize="13">Przerywana linia = powierzchnia Gaussa</text></svg><div className="el-results"><Result label="Strumień Φ" value={`${fmt(phi,2)} N·m²/C`}/><Result label="Znak" value={q>0?'Dodatni':q<0?'Ujemny':'Zero'}/></div><Note>Φ = Qwew / ε₀. Jeśli Qwew = 0, nie oznacza to, że E jest wszędzie równe zero.</Note></Wrap>}
export function PotentialLab(){let[q,setQ]=useState(1),[r,setR]=useState(10);let v=K*q*1e-9/(n(r,1)*0.01);return <Wrap title="Potencjał wokół punktowego ładunku" description="Ładunek dodatni daje dodatni potencjał (przy V=0 w nieskończoności)."><div className="el-control-grid"><NumberField label="Ładunek źródłowy Q" value={q} onChange={setQ} unit="nC"/><Slider label="Odległość r" value={r} set={setR} min={2} max={100} unit="cm"/></div><div className="el-results"><Result label="Potencjał V" value={`${fmt(v,3)} V`}/><Result label="Wzór" value="V = kQ / r"/></div><Note>W odróżnieniu od wartości natężenia, potencjał może mieć znak minus. Dwa razy większa odległość → dwa razy mniejszy potencjał punktowego ładunku.</Note></Wrap>}
export function CapacitorLab(){let[s,setS]=useState(100),[d,setD]=useState(1),[er,setEr]=useState(2);const cap=EPS*n(er,1)*n(s,1e-5)*1e-4/(n(d,.01)*1e-3);return <Wrap title="Projektant kondensatora płaskiego" description="Zobacz, które parametry zwiększają pojemność."><div className="el-control-grid"><Slider label="Powierzchnia S" value={s} set={setS} min={10} max={200} step={5} unit="cm²"/><Slider label="Odległość d" value={d} set={setD} min={.2} max={5} step={.1} unit="mm"/><Slider label="Przenikalność εᵣ" value={er} set={setEr} min={1} max={10} step={.5}/></div><svg className="el-viz" viewBox="0 0 500 165" role="img" aria-label="Dwie okładki kondensatora rozdzielone dielektrykiem"><rect x="130" y="24" width="14" height="110" rx="2" fill="#f9c278"/><rect x={365+Math.min(d*5,30)} y="24" width="14" height="110" rx="2" fill="#f9c278"/><rect x="149" y="27" width={211+Math.min(d*5,30)} height="104" rx="4" fill="#d8a2ff15" stroke="#bda1f5" strokeDasharray="5 5"/><text x="250" y="89" textAnchor="middle" fontSize="17" fill="#d8c4ff">εᵣ = {fmt(er,1)}</text><text x="250" y="150" textAnchor="middle" fontSize="14" fill="#9dadbd">Dielektryk pomiędzy okładkami</text></svg><div className="el-results"><Result label="Pojemność" value={`${fmt(cap*1e12,2)} pF`}/><Result label="W faradach" value={`${cap.toExponential(3)} F`}/></div><Note>C = ε₀ · εᵣ · S / d. Przy podstawianiu zamieniamy cm² na m² oraz mm na m.</Note></Wrap>}
export function DielectricLab(){let[er,setEr]=useState(3),[mode,setMode]=useState('free');const c0=1,initialVoltage=10,q0=c0*initialVoltage,c1=c0*er,u1=mode==='free'?initialVoltage/er:initialVoltage,q1=mode==='free'?q0:c1*initialVoltage;return <Wrap title="Dielektryk: odłączony czy podłączony?" description="To dwie różne sytuacje fizyczne — wybierz jedną."><div className="el-control-grid"><label className="el-input"><span>Stan kondensatora</span><select value={mode} onChange={e=>setMode(e.target.value)}><option value="free">Odłączony od baterii (Q stałe)</option><option value="battery">Podłączony do baterii (U stałe)</option></select></label><Slider label="Przenikalność εᵣ" value={er} set={setEr} min={1} max={8} step={.5}/></div><div className="el-results"><Result label="Pojemność po zmianie" value={`${fmt(c1,1)} µF`}/><Result label="Napięcie U" value={`${fmt(u1,3)} V`}/><Result label="Ładunek Q" value={`${fmt(q1,3)} µC`}/></div><Note>Początek: 1 µF, 10 V, 10 µC. {mode==='free'?'Po odłączeniu baterii ładunek zostaje stały — napięcie maleje.':'Gdy bateria jest podłączona, napięcie pozostaje stałe — dopływa ładunek.'}</Note></Wrap>}
export function CurrentLab(){let[c,setC]=useState(10),[dU,setDU]=useState(5),[dt,setDt]=useState(.1);let curr=c*1e-6*dU/n(dt,.001)*1e3;return <Wrap title="Prąd przy zmianie napięcia" description="Model idealnego kondensatora o stałej pojemności."><div className="el-control-grid"><NumberField label="Pojemność" value={c} onChange={setC} unit="µF" min={0}/><NumberField label="Zmiana napięcia" value={dU} onChange={setDU} unit="V"/><NumberField label="Czas zmiany" value={dt} onChange={setDt} unit="s" min={.001} step={.05}/></div><div className="el-results"><Result label="Średni prąd przy liniowej zmianie" value={`${fmt(curr,5)} mA`}/><Result label="Podstawienie" value="i = C × ΔU / Δt"/></div><Note>Jeżeli napięcie jest stałe (ΔU = 0), idealny kondensator nie przewodzi prądu ustalonego.</Note></Wrap>}
export function NetworkLab(){let[a,setA]=useState(3),[b,setB]=useState(6),[c,setC]=useState(9),[mode,setMode]=useState('parallel');let A=n(a,.001),B=n(b,.001),C=n(c,.001),sum=mode==='parallel'?A+B+C:1/(1/A+1/B+1/C);return <Wrap title="Kondensatory — szeregowo lub równolegle" description="Zobacz schemat i przelicz pojemność zastępczą."><div className="el-control-grid"><NumberField label="C₁" value={a} onChange={setA} unit="µF" min={.001}/><NumberField label="C₂" value={b} onChange={setB} unit="µF" min={.001}/><NumberField label="C₃" value={c} onChange={setC} unit="µF" min={.001}/><label className="el-input"><span>Rodzaj połączenia</span><select value={mode} onChange={e=>setMode(e.target.value)}><option value="parallel">Równolegle</option><option value="series">Szeregowo</option></select></label></div><svg className="el-viz" viewBox="0 0 500 200" role="img" aria-label={mode==='parallel'?'Trzy kondensatory równolegle':'Trzy kondensatory szeregowo'}>{mode==='series'?<><path d="M32 98H110 M150 98H218 M258 98H327 M367 98H463" fill="none" stroke="#98b9da" strokeWidth="3"/>{[110,218,327].map((x,i)=><g key={x}><path d={`M${x} 75 V122 M${x+40} 75 V122`} stroke="#f9c27d" strokeWidth="5"/><text x={x+20} y="58" fill="#e8f0ff" fontSize="15" textAnchor="middle">C{i+1}</text></g>)}</>:<><path d="M32 100H100 V26H400V176H100V100 M400 100H465" stroke="#98b9da" strokeWidth="3" fill="none"/>{[52,100,148].map((y,i)=><g key={y}><path d={`M100 ${y}H220 M246 ${y}H400`} stroke="#98b9da" strokeWidth="3"/><path d={`M220 ${y-18}V${y+18} M246 ${y-18}V${y+18}`} stroke="#f9c27d" strokeWidth="5"/><text x="273" y={y-10} fill="#e8f0ff" fontSize="14">C{i+1}</text></g>)}</>}</svg><div className="el-results"><Result label="Pojemność zastępcza" value={`${fmt(sum,5)} µF`}/><Result label="Zasada" value={mode==='parallel'?'Dodaj C₁+C₂+C₃':'Dodaj 1/C₁+1/C₂+1/C₃'}/></div><Note>{mode==='parallel'?'Równolegle: te same napięcia na okładkach, sumują się ładunki.':'Szeregowo: takie same moduły ładunków na każdej parze okładek, sumują się napięcia.'}</Note></Wrap>}
export function EnergyLab(){let[c,setC]=useState(100),[u,setU]=useState(12);let e=.5*n(c)*1e-6*u*u;return <Wrap title="Energia zgromadzona w kondensatorze" description="Energia rośnie z kwadratem napięcia."><div className="el-control-grid"><Slider label="Pojemność C" value={c} set={setC} min={10} max={500} step={10} unit="µF"/><Slider label="Napięcie U" value={u} set={setU} min={0} max={24} step={1} unit="V"/></div><div className="el-results"><Result label="Energia" value={`${fmt(e*1e3,4)} mJ`}/><Result label="W dżulach" value={`${fmt(e,6)} J`}/></div><div className="el-energy"><div style={{width:`${Math.min(100,e/(.5*500e-6*24*24)*100)}%`}}/></div><Note>W = ½ × C × U². Dwa razy większe napięcie oznacza cztery razy większą energię.</Note></Wrap>}
export function MeterLab(){let[range,setRange]=useState(10),[cls,setCls]=useState(5),[reading,setReading]=useState(2);const er=n(range)*n(cls)*.01;return <Wrap title="Klasa miernika analogowego" description="Sprawdź różnicę między błędem względem zakresu a błędem względem wskazania."><div className="el-control-grid"><NumberField label="Górna granica zakresu" value={range} onChange={setRange} unit="V" min={.01}/><NumberField label="Klasa" value={cls} onChange={setCls} unit="%" min={0} step={.5}/><NumberField label="Wskazanie" value={reading} onChange={setReading} unit="V"/></div><div className="el-results"><Result label="Graniczny błąd podstawowy" value={`±${fmt(er,4)} V`}/><Result label="Przedział z tego błędu" value={`${fmt(reading-er,3)} … ${fmt(reading+er,3)} V`}/></div><Note>W wielu miernikach analogowych klasa odnosi się do umownej wartości zakresu, a nie do wskazania. Szczegóły zależą od normy i konstrukcji danego miernika.</Note></Wrap>}
