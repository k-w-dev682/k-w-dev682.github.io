.sc-step-correct{color:#92e5c6;}.sc-step-wrong{color:#f0b5a6;}


/* StudyLab 7.1 — dostosowanie do faktycznej szerokosci panelu (a nie tylko viewportu). */
.sc-root {container-type:inline-size;}
.sc-root :is(.sc-header,.sc-layout,.sc-main,.sc-panel,.sc-stats-grid,.sc-stat,.sc-two-col,.sc-tile-grid,.sc-header-meta) {min-width:0;max-width:100%;}
.sc-root :is(.sc-header-meta,.sc-actions,.sc-info-line,.sc-between,.sc-section-title) {flex-wrap:wrap;}
.sc-root .sc-header-meta > span {flex:1 1 86px;min-width:0;}
.sc-root .sc-panel :is(h3,p,strong,span) {overflow-wrap:break-word;}
.sc-root .sc-navigation > button {min-height:42px;align-items:center;white-space:normal;overflow-wrap:anywhere;}
.sc-root .sc-navigation > button > span {flex:0 0 23px;}
.sc-root .sc-actions > :is(button,a),.sc-root :is(.sc-primary,.sc-secondary),.sc-root .sc-lesson-actions > :is(a,button) {
  min-height:40px;min-width:0;max-width:100%;align-items:center;justify-content:center;vertical-align:middle;text-align:center;
  line-height:1.4;white-space:normal;overflow-wrap:break-word;
}
.sc-root .sc-action-fix {align-self:center;}
.sc-root .sc-tile {min-width:0;max-width:100%;overflow-wrap:anywhere;}
.sc-root .sc-tile > :is(small,strong) {min-width:0;overflow-wrap:anywhere;}
.sc-root :is(.sc-stat,.sc-weak,.sc-between,.sc-question-meta) {min-width:0;}

@container (max-width: 990px) {
  .sc-header {flex-direction:column;align-items:stretch;gap:16px;}
  .sc-header-meta {align-self:stretch;}
  .sc-layout {grid-template-columns:minmax(0,1fr);gap:16px;}
  .sc-navigation {position:static;display:flex;flex-direction:row;gap:7px;overflow-x:auto;scrollbar-width:thin;padding:0 0 9px;max-width:100%;}
  .sc-navigation > button {flex:0 0 auto;width:auto;padding:10px 12px;white-space:nowrap;}
  .sc-side-note {display:none;}
  .sc-two-col {grid-template-columns:minmax(0,1fr);}
}
@container (max-width: 620px) {
  .sc-stats-grid {grid-template-columns:repeat(2,minmax(0,1fr));}
  .sc-header-meta > span {flex:1 1 74px;padding:9px 5px;white-space:normal;}
  .sc-header-meta b {font-size:19px;}
  .sc-form-grid,.sc-tile-grid {grid-template-columns:minmax(0,1fr);}
  .sc-root .sc-actions {align-items:stretch;}
  .sc-root .sc-actions > :is(button,a) {flex:1 1 140px;}
  .sc-section-title {align-items:flex-start;}
}
@container (max-width: 390px) {
  .sc-stats-grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
  .sc-stat {padding:11px 9px;}
  .sc-stat strong {font-size:21px;}
  .sc-header h1 {font-size:clamp(22px,8cqi,28px);}
  .sc-panel {padding:12px;}
  .sc-header-meta > span {min-width:0;}
}
/* Centrum pozostaje jedną kolumną podczas skupienia także przy szerokim ekranie. */
body:is(.scl7-focus,.studylab-focus) .sc-root .sc-layout {grid-template-columns:minmax(0,1fr)!important;}
body:is(.scl7-focus,.studylab-focus) .sc-root .sc-navigation {display:none!important;}
