import React, {useState} from 'react';
import '../styles/ask.css';

const bound=(x,min,max)=>Math.max(min,Math.min(max,x));
const fmt=n=>Number.isFinite(n)?new Intl.NumberFormat('pl-PL',{maximumFractionDigits:5}).format(n):'—';
function Field({label,value,onChange,min=0,max=100000,step=1,unit=''}){return <label className="ask-input"><span>{label}</span><div><input type="number" value={value} min={min} max={max} step={step} onChange={e=>{let n=Number(e.target.value);if(Number.isFinite(n))onChange(bound(n,min,max))}}/><small>{unit}</small></div></label>}
function Shell({name,desc,children}){return <section className="ask-lab not-content" aria-label={name}><div className="ask-lab-head"><span className="ask-lab-dot"/><div><h3>{name}</h3><p>{desc}</p></div><span className="ask-live-label">INTERAKTYWNE</span></div><div className="ask-lab-body">{children}</div></section>}
function Value({name,value,note}){return <div className="ask-result"><span>{name}</span><strong>{String(value)}</strong>{note&&<small>{note}</small>}</div>}
function Bits({bits,onToggle,highlightSign=false}){return <div className="ask-bits">{bits.split('').map((x,i)=><button type="button" key={i} disabled={!onToggle} aria-label={`Bit ${bits.length-1-i}: ${x}`} onClick={()=>onToggle?.(i)} className={'ask-bit '+(highlightSign&&i===0?'ask-bit-sign':'') }><b>{x}</b><small>{bits.length-1-i}</small></button>)}</div>}
function Actions({step,total,onNext,onPrev,onReset}){return <div className="ask-actions"><button type="button" disabled={step===0} onClick={onPrev}>← Cofnij</button><span>Krok {step} / {total}</span><button type="button" disabled={step===total} onClick={onNext}>Dalej →</button><button type="button" onClick={onReset}>↺ Reset</button></div>}
function integerBits(n,width=8){return (n>>>0).toString(2).padStart(width,'0').slice(-width)}
const binary=(n,bits=8)=>integerBits(n,bits);
const fromDigits=(str,base)=>parseInt(str,base);

export function BitLab(){const [n,setN]=useState(77);const b=binary(n);const weights=b.split('').map((x,i)=>(x==='1'?2**(7-i):0));return <Shell name="Przełączaj pojedyncze bity" desc="Kliknij dowolny kwadrat 0/1 i zobacz, jak zmieni się liczba."><Bits bits={b} onToggle={i=>setN(v=>v^(1<<(7-i)))}/><div className="ask-results"><Value name="Dziesiętnie" value={n}/><Value name="Szesnastkowo" value={n.toString(16).toUpperCase().padStart(2,'0')}/></div><p className="ask-note">Suma wag ustawionych bitów: {weights.filter(Boolean).join(' + ')||'0'} = <b>{n}</b>. Bity zera mają wagę 0.</p></Shell>}
export function PositionLab(){const [n,setN]=useState(55);const bits=binary(n);return <Shell name="Pozycje i wagi bitów" desc="Każdy ustawiony bit dodaje swoją wagę do wyniku."><div className="ask-controls"><Field label="Liczba dziesiętna" value={n} onChange={setN} min={0} max={255}/></div><Bits bits={bits}/><div className="ask-weights">{bits.split('').map((b,i)=><div key={i} className={b==='1'?'active':''}><span>2^{7-i}</span><b>{b==='1'?2**(7-i):0}</b></div>)}</div><div className="ask-results"><Value name="Binarna" value={bits}/><Value name="Dziesiętna" value={n}/></div></Shell>}
export function BaseConverterLab(){const [number,setNumber]=useState(55);const [to,setTo]=useState(2);const digits=number.toString(to).toUpperCase();let n=number;const divisions=[];while(n>0&&divisions.length<24){const q=Math.floor(n/to);const r=n%to;divisions.push([n,q,r.toString(to).toUpperCase()]);n=q}if(!divisions.length)divisions.push([0,0,'0']);return <Shell name="Konwerter — dzielenie z resztą" desc="Podaj liczbę dziesiętną. Obserwuj kolejne dzielenia przez 2 albo 16."><div className="ask-controls"><Field label="Liczba w systemie 10" min={0} max={1000000} value={number} onChange={v=>setNumber(Math.floor(v))}/><label className="ask-input"><span>System docelowy</span><select value={to} onChange={e=>setTo(Number(e.target.value))}><option value={2}>Dwójkowy (2)</option><option value={16}>Szesnastkowy (16)</option></select></label></div><table className="ask-mini-table"><thead><tr><th>Liczba</th><th>Iloraz</th><th>Reszta</th></tr></thead><tbody>{divisions.map(([a,b,c],i)=><tr key={i}><td>{fmt(a)}</td><td>{fmt(b)}</td><td className="ask-accent">{c}</td></tr>)}</tbody></table><div className="ask-results"><Value name={`Wynik w systemie ${to}`} value={digits}/></div><p className="ask-note">Czytaj reszty <strong>od dołu do góry</strong>. Dla 16 reszta 10 to A, 11 to B, aż do 15 = F.</p></Shell>}
export function HexGroupLab(){const [hex,setHex]=useState('3EA');const clean=hex.toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,6);const groups=[...clean].map(c=>[c,parseInt(c,16).toString(2).padStart(4,'0')]);const num=clean?parseInt(clean,16):0;return <Shell name="1 cyfra hex ↔ 4 bity" desc="Zmieniaj zapis hex i obserwuj dokładne grupowanie bitów."><label className="ask-input"><span>Liczba szesnastkowa (do 6 cyfr)</span><input value={hex} onChange={e=>setHex(e.target.value.replace(/[^0-9a-fA-F]/g,'').toUpperCase().slice(0,6))}/></label><div className="ask-hex-groups">{groups.length?groups.map(([c,b],i)=><div key={i}><strong>{c}</strong><code>{b}</code></div>):<span>Wpisz cyfrę od 0 do F</span>}</div><div className="ask-results"><Value name="Dwójkowo (z grupami)" value={groups.map(g=>g[1]).join(' ')||'—'}/><Value name="Dziesiętnie" value={num}/></div><p className="ask-note">Wynik bez zer wiodących: {num.toString(2)}₂.</p></Shell>}
export function UnitsLab(){const [value,setValue]=useState(2048);return <Shell name="kB kontra KiB" desc="To samo urządzenie, inne jednostki — różna liczba."><div className="ask-controls"><Field label="Rozmiar w bajtach" value={value} onChange={setValue} min={0} max={1000000000}/></div><div className="ask-results"><Value name="Kilobajty (1000 B)" value={`${fmt(value/1000)} kB`}/><Value name="Kibibajty (1024 B)" value={`${fmt(value/1024)} KiB`}/><Value name="Megabajty" value={`${fmt(value/1e6)} MB`}/><Value name="Mebibajty" value={`${fmt(value/1048576)} MiB`}/></div></Shell>}
const encode=(n,bits,mode)=>{const max=(1<<(bits-1))-1;if(n>max||n<-(mode==='U2'?max+1:max))return null;const mask=(1<<bits)-1;let v=n>=0?n:mode==='ZM'?1<<(bits-1)|(-n):mode==='U1'?(~(-n))&mask:(1<<bits)+n;return binary(v,bits)};
const decode=(bits,mode)=>{const value=parseInt(bits,2),width=bits.length,top=2**(width-1),mask=2**width-1;if(value<top)return `${value}`;const mag=mode==='ZM'?value&(top-1):mode==='U1'?(~value)&mask:0;return mode==='U2'?`${value-2**width}`:mag===0?'-0':`${-mag}`};
export function SignedLab(){const [n,setN]=useState(-5),[width,setWidth]=useState(4);const modes=['ZM','U1','U2'];return <Shell name="Trzy zapisy jednej liczby" desc="Zobacz różnicę między znakiem-modułem, U1 i U2."><div className="ask-controls"><Field label="Liczba (dziesiętnie)" value={n} onChange={v=>setN(Math.trunc(v))} min={-128} max={127}/><label className="ask-input"><span>Liczba bitów</span><select value={width} onChange={e=>setWidth(Number(e.target.value))}><option value="4">4 bity</option><option value="8">8 bitów</option></select></label></div>{modes.map(mode=>{const bits=encode(n,width,mode);return <div className="ask-signed-row" key={mode}><div className="ask-signed-title"><b>{mode}</b><small>{bits?`odczyt: ${decode(bits,mode)}`:'poza zakresem tego zapisu'}</small></div>{bits?<Bits bits={bits} highlightSign/>:<div className="ask-out-of-range">Tej wartości nie da się zapisać na {width} bitach w {mode}.</div>}</div>})}<p className="ask-note">Pomarańczowy kwadrat = najstarszy bit. Liczba bitów wpływa na zakres. ZM i U1 mają dwa kody zera, U2 jeden.</p></Shell>}
export function ALULab(){const [a,setA]=useState(7),[b,setB]=useState(-2);const sum=a+b;const out=((sum%256)+256)%256;const signed=out>=128?out-256:out;const overflow=sum>127||sum< -128;return <Shell name="Dodawanie 8-bitowe w U2" desc="Komputer zachowuje 8 młodszych bitów. Zobacz, kiedy pojawia się przepełnienie."><div className="ask-controls"><Field label="Pierwszy składnik" value={a} onChange={setA} min={-128} max={127}/><Field label="Drugi składnik" value={b} onChange={setB} min={-128} max={127}/></div><div className="ask-code-diagram"><div><span>A</span><code>{binary(a)}</code></div><div><span>+</span><code>{binary(b)}</code></div><hr/><div><span>8 bitów</span><code>{binary(out)}</code></div></div><div className="ask-results"><Value name="Wynik matematyczny" value={sum}/><Value name="Wynik zapisany w U2" value={signed}/><Value name="Przepełnienie" value={overflow?'TAK':'NIE'}/></div><p className="ask-note">Przykład: 7 + (−2) = 5 bez przepełnienia. 127 + 1 daje zapis −128, bo +128 wykracza poza zakres 8-bitowego U2.</p></Shell>}
export function CpuLab(){const [step,setStep]=useState(0);const stages=['Początek','FETCH · pobierz','DECODE · rozpoznaj','EXECUTE · oblicz','Zapis wyniku'];return <Shell name="Cykl rozkazu CPU" desc="Schemat uproszczony: rozkaz ADD R0, 3 przy początkowym R0 = 4."><div className="ask-stage-flow">{stages.slice(1).map((s,i)=><div key={s} className={step===i+1?'current':step>i+1?'done':''}><span>{String(i+1).padStart(2,'0')}</span><strong>{s.split(' · ')[0]}</strong><small>{s.split(' · ')[1]}</small></div>)}</div><div className="ask-results"><Value name="Instrukcja" value={step>=1?'ADD R0, 3':'—'}/><Value name="R0" value={step>=3?'7':'4'}/><Value name="Status" value={stages[step]}/></div><p className="ask-note">{['Rozpocznij, aby zobaczyć pracę CPU.','CPU otrzymał bajty reprezentujące następną instrukcję.','Rozpoznano operację dodawania i argument 3.','Jednostka wykonawcza oblicza 4 + 3 = 7.','Rejestr R0 zawiera 7; CPU przechodzi do kolejnej instrukcji.'][step]}</p><Actions step={step} total={4} onNext={()=>setStep(s=>Math.min(4,s+1))} onPrev={()=>setStep(s=>Math.max(0,s-1))} onReset={()=>setStep(0)}/></Shell>}
export function MemoryLab(){const [vals,setVals]=useState({10:7,11:5,12:0}),[reg,setReg]=useState(0),[info,setInfo]=useState('Wartość pod adresem 10 to 7. Adres nie jest wartością.');function load(id){setReg(vals[id]);setInfo(`LOAD: R0 ← pamięć[${id}] = ${vals[id]}`)}function store(){setVals(x=>({...x,12:reg}));setInfo(`STORE: pamięć[12] ← R0 = ${reg}`)}return <Shell name="Pamięć RAM i rejestr R0" desc="Zmień wartości w pamięci, potem odczytaj je do rejestru."><div className="ask-memory-grid">{[10,11,12].map(addr=><div key={addr}><span>Adres {addr}</span><input type="number" value={vals[addr]} min={-999} max={999} onChange={e=>setVals(s=>({...s,[addr]:bound(Number(e.target.value)||0,-999,999)}))}/><button type="button" onClick={()=>load(addr)}>Odczytaj → R0</button></div>)}</div><div className="ask-results"><Value name="Rejestr R0" value={reg}/></div><button type="button" className="ask-main-btn" onClick={store}>Zapisz R0 pod adresem 12</button><p className="ask-note">{info}</p></Shell>}
export function AssemblerLab(){const [x,setX]=useState(7),[y,setY]=useState(5),[step,setStep]=useState(0);const r0=step>=1?x:0,r1=step>=2?y:0,sum=step>=3?x+y:r0,mem12=step>=4?sum:0;const code=['LOAD R0, [10]','LOAD R1, [11]','ADD  R0, R1','STORE [12], R0'];return <Shell name="Pseudomaszyna — krok po kroku" desc="Cztery dydaktyczne rozkazy, nie kod konkretnej architektury."><div className="ask-controls"><Field label="Pamięć[10]" value={x} onChange={v=>{setX(v);setStep(0)}} min={-50} max={50}/><Field label="Pamięć[11]" value={y} onChange={v=>{setY(v);setStep(0)}} min={-50} max={50}/></div><div className="ask-asm-code">{code.map((line,i)=><div key={i} className={step===i+1?'on':''}><span>{i+1}</span><code>{line}</code>{step>i&&<b>✓</b>}</div>)}</div><div className="ask-results"><Value name="R0" value={sum}/><Value name="R1" value={r1}/><Value name="Pamięć[12]" value={mem12}/></div><p className="ask-note">{['Start: oba rejestry są zerowe.','R0 otrzymuje wartość z komórki 10.','R1 otrzymuje wartość z komórki 11.','ALU dodaje R1 do R0.','Wynik z R0 trafia do pamięci pod adresem 12.'][step]}</p><Actions step={step} total={4} onNext={()=>setStep(s=>Math.min(4,s+1))} onPrev={()=>setStep(s=>Math.max(0,s-1))} onReset={()=>setStep(0)}/></Shell>}
</file>

<file path="src/components/AskPdf.jsx">
import React,{useState} from 'react';
import {ASK_LESSONS} from '../data/askLessons.js';
import '../styles/ask.css';
import 'katex/dist/katex.min.css';

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const root=()=>{
  const m=window.location.pathname.match(/^(.*?\/ask\/)/);
  if(m)return window.location.origin+m[1];
  const base=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
  return window.location.origin+base+'ask/';
};
let printStyle=null;
function cleanPrint(){document.getElementById('ask-print-root')?.remove();printStyle?.remove();printStyle=null;}
function buildPrintCss(theme){const light=theme==='light';const bg=light?'#fff':'#000';const ink=light?'#152018':'#eff9f1';const panel=light?'#f3f8f4':'#102018';return `#ask-print-root{display:none}@media print{@page{size:A4;margin:14mm}html,body{margin:0!important;padding:0!important;background:${bg}!important}body>*:not(#ask-print-root){display:none!important}#ask-print-root{display:block!important;color:${ink}!important;background:${bg}!important;print-color-adjust:exact;-webkit-print-color-adjust:exact;font:10.5pt/1.62 Georgia,'Times New Roman',serif}#ask-print-root *{box-sizing:border-box}#ask-print-root .ask-cover{min-height:240mm;display:flex;flex-direction:column;justify-content:center;break-after:page;padding:15mm 8mm}#ask-print-root .ask-cover .ask-overline{font:800 10pt Arial,sans-serif;letter-spacing:.19em;color:#48a871}#ask-print-root .ask-cover h1{font:800 40pt/1.07 Arial,sans-serif;letter-spacing:-.05em;margin:12mm 0;color:${ink}}#ask-print-root .ask-cover em{font-style:normal;color:#47b176}#ask-print-root .ask-cover p{font:13pt/1.7 Arial,sans-serif;color:${ink}}#ask-print-root .ask-toc{break-after:page;padding:15mm 3mm}#ask-print-root .ask-toc li{margin:3mm 0;color:${ink}}#ask-print-root .ask-chapter{break-before:page;color:${ink}}#ask-print-root .ask-chapter h1{font:800 25pt Arial,sans-serif;letter-spacing:-.02em;color:${ink}!important}#ask-print-root h2,#ask-print-root h3{color:${ink}!important;break-after:avoid}#ask-print-root p,#ask-print-root li,#ask-print-root td,#ask-print-root th{color:${ink}!important}#ask-print-root .sl-markdown-content{max-width:100%;color:${ink}!important;font-size:10.5pt}#ask-print-root a{color:${ink}!important;text-decoration:none}#ask-print-root .ask-equation--block{background:${panel}!important;color:${ink}!important;border-color:#396949;max-width:100%}#ask-print-root .katex{color:${ink}!important}#ask-print-root pre{background:${panel}!important;color:${ink}!important;white-space:pre-wrap;overflow-wrap:anywhere;break-inside:avoid}#ask-print-root pre *{color:${ink}!important}#ask-print-root table{width:100%;border-collapse:collapse}#ask-print-root td,#ask-print-root th{border:1px solid #777;padding:2mm}#ask-print-root td,#ask-print-root th,#ask-print-root pre{font-size:9pt}#ask-print-root .ask-lab,#ask-print-root .ask-nav,#ask-print-root .ask-export-mini,#ask-print-root .ask-eyebrow,#ask-print-root .sl-anchor-link,#ask-print-root .ask-export{display:none!important}#ask-print-root details{display:block!important}#ask-print-root details>summary{display:none}#ask-print-root details>*{display:block!important}#ask-print-root blockquote{background:${panel}!important;color:${ink}!important}#ask-print-root .ask-print-label{font:800 8pt Arial,sans-serif;color:#4caf75;letter-spacing:.13em}#ask-print-root img,#ask-print-root svg{max-width:100%}#ask-print-root .ask-bit-groups{background:${panel}!important}#ask-print-root .ask-bit-groups span{color:${ink}!important;background:${panel}!important}}`}
async function runExport(pages,theme,status){if(!pages.length)throw Error('Wybierz przynajmniej jeden temat.');cleanPrint();const segments=[];
for(let i=0;i<pages.length;i++){
  const p=pages[i];const url=root()+encodeURIComponent(p.slug)+'/';status(`Przygotowywanie ${i+1}/${pages.length}: ${p.title}`);
  const res=await fetch(url,{credentials:'same-origin'});if(!res.ok)throw Error(`Nie znaleziono „${p.title}” (HTTP ${res.status}). Sprawdź: ${url}`);
  const parsed=new DOMParser().parseFromString(await res.text(),'text/html');const el=parsed.querySelector('.sl-markdown-content');if(!el)throw Error(`Nie znaleziono artykułu na stronie: ${url}`);
  const content=el.cloneNode(true);content.querySelectorAll('script,button,input,select,textarea,iframe,.ask-lab,.ask-nav,.ask-export-mini,.ask-export,.sl-anchor-link').forEach(x=>x.remove());
  content.querySelectorAll('details').forEach(x=>{x.open=true});
  segments.push(`<article class="ask-chapter"><p class="ask-print-label">${esc(p.section)}</p><h1>${esc(p.title)}</h1><div class="sl-markdown-content">${content.innerHTML}</div></article>`);
}
  const wrapper=document.createElement('div');wrapper.id='ask-print-root';wrapper.innerHTML=`<section class="ask-cover"><span class="ask-overline">STUDYLAB / ARCHITEKTURA SYSTEMÓW KOMPUTEROWYCH</span><h1>Komputer<br/>od <em>środka.</em></h1><p>BLACK Edition · ${pages.length} tematów<br/>Bity · systemy liczbowe · ZM / U1 / U2 · CPU i asembler</p></section><section class="ask-toc"><h1>Spis treści</h1><ol>${pages.map(p=>`<li>${esc(p.title)}</li>`).join('')}</ol></section>${segments.join('')}`;document.body.appendChild(wrapper);
  printStyle=document.createElement('style');printStyle.textContent=buildPrintCss(theme);document.head.appendChild(printStyle);
  status('Gotowe. Wybierz w oknie drukowania „Zapisz jako PDF”.');
  if(document.fonts?.ready)await document.fonts.ready;
  await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
  window.print();
}
export default function AskPdfButton({slug,title,section}){const [busy,setBusy]=useState(false),[msg,setMsg]=useState('');return <div className="not-content"><button className="ask-export-mini" type="button" disabled={busy} onClick={async()=>{setBusy(true);try{await runExport([{slug,title,section}], 'dark',setMsg)}catch(e){setMsg('Błąd: '+e.message)}finally{setBusy(false)}}}>↓ Zapisz ten temat jako PDF</button>{msg&&<p className="ask-export-message">{msg}</p>}</div>}
export function AskPdfCollection(){const [selected,setSelected]=useState(ASK_LESSONS.map(l=>l.slug)),[theme,setTheme]=useState('dark'),[busy,setBusy]=useState(false),[msg,setMsg]=useState('');const groups=[...new Set(ASK_LESSONS.map(l=>l.section))];const toggle=(slug,on)=>setSelected(a=>on?[...new Set([...a,slug])]:a.filter(s=>s!==slug));return <div className="ask-export not-content"><h3>Wybierz zakres notatek</h3><div className="ask-export-actions"><button type="button" onClick={()=>setSelected(ASK_LESSONS.map(x=>x.slug))}>Wszystko</button><button type="button" onClick={()=>setSelected([])}>Wyczyść</button><button type="button" onClick={()=>setSelected(ASK_LESSONS.filter(x=>x.source!=='extra').map(x=>x.slug))}>Tylko materiał laboratoryjny</button><button type="button" onClick={()=>setSelected(ASK_LESSONS.filter(x=>x.exercise).map(x=>x.slug))}>Same zadania</button></div>{groups.map(group=><section key={group}><h4>{group}</h4><div className="ask-export-columns">{ASK_LESSONS.filter(x=>x.section===group).map(l=><label key={l.slug}><input type="checkbox" checked={selected.includes(l.slug)} onChange={e=>toggle(l.slug,e.target.checked)}/>{l.title}</label>)}</div></section>)}<p className="ask-export-theme">Motyw wydruku: <label><input type="radio" checked={theme==='dark'} onChange={()=>setTheme('dark')}/> Czarny</label> · <label><input type="radio" checked={theme==='light'} onChange={()=>setTheme('light')}/> Jasny</label></p><button type="button" disabled={busy||selected.length===0} className="ask-export-submit" onClick={async()=>{setBusy(true);try{await runExport(ASK_LESSONS.filter(x=>selected.includes(x.slug)),theme,setMsg)}catch(e){setMsg('Błąd: '+e.message)}finally{setBusy(false)}}}>↓ Przygotuj {selected.length} tematów do PDF</button><p role="status" className="ask-export-message">{msg||'Druk uruchomi się z przeglądarki — wybierz „Zapisz jako PDF”.'}</p></div>}
</file>

<file path="src/components/CppLabs.jsx">
import React, { useMemo, useState } from 'react';

const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
const readInt = (value, fallback, min, max) => {
  const result = Number(value);
  return Number.isFinite(result) ? clamp(Math.trunc(result), min, max) : fallback;
};

function Lab({ number, title, subtitle, children }) {
  return (
    <section className="not-content lab" aria-label={title}>
      <div className="lab__head">
        <span className="lab__eyebrow"><span className="lab__live" /> SYMULATOR {number}</span>
        <h3>{title}</h3>
        <p>{subtitle}</p>
      </div>
      <div className="lab__body">{children}</div>
    </section>
  );
}

function Controls({ step, max, onPrevious, onNext, onReset, previousLabel = 'Wstecz', nextLabel = 'Następny krok' }) {
  return (
    <div className="lab__controls">
      <button type="button" className="lab__button lab__button--subtle" onClick={onReset}>↺ Reset</button>
      <button type="button" className="lab__button lab__button--subtle" onClick={onPrevious} disabled={step <= 0}>{previousLabel}</button>
      <button type="button" className="lab__button lab__button--primary" onClick={onNext} disabled={step >= max}>{step >= max ? 'Zakończono ✓' : nextLabel + ' →'}</button>
      <span className="lab__progress">{step} / {max}</span>
    </div>
  );
}

function StepBar({ step, max }) {
  return <div className="lab__stepbar" aria-label={`Krok ${step} z ${max}`}>
    {Array.from({ length: max + 1 }, (_, i) => <span key={i} className={i <= step ? 'is-active' : ''} />)}
  </div>;
}

function Stat({ label, value, highlight = false }) {
  return <div className={'lab__stat' + (highlight ? ' lab__stat--accent' : '')}><span>{label}</span><strong>{value}</strong></div>;
}

export function BuildLab() {
  const [step, setStep] = useState(0);
  const [broken, setBroken] = useState(false);
  const stages = [
    ['Plik źródłowy', 'Piszesz kod w pliku main.cpp. Komputer jeszcze go nie wykonuje.'],
    ['Kompilacja', broken ? 'Kompilator znalazł brakujący średnik. Proces jest zatrzymany.' : 'Kompilator tłumaczy kod C++ do kodu obiektowego.'],
    ['Linkowanie', 'Linker dołącza potrzebne elementy i tworzy program wykonywalny.'],
    ['Uruchomienie', 'System uruchamia program, a instrukcje są wykonywane.'],
    ['Wynik', 'Na ekranie pojawia się napis: Witaj, StudyLab!'],
  ];
  const failed = broken && step === 1;
  const actualMax = broken ? 1 : 4;
  return <Lab number="01" title="Od .cpp do uruchomionego programu" subtitle="Sprawdź, co robi kompilator, linker i co się stanie, gdy w kodzie jest błąd.">
    <label className="lab__toggle"><input type="checkbox" checked={broken} onChange={e => { setBroken(e.target.checked); setStep(0); }} /> Symuluj brak średnika w kodzie</label>
    <div className="lab__stages">
      {stages.map(([label], i) => <div key={label} className={'lab__stage' + (step === i ? ' is-current' : '') + (i < step ? ' is-done' : '') + (failed && i === 1 ? ' is-error' : '')}>
        <small>0{i + 1}</small><span>{label}</span>
      </div>)}
    </div>
    <div className={'lab__notice' + (failed ? ' lab__notice--error' : '')} aria-live="polite"><strong>{stages[step][0]}</strong><p>{stages[step][1]}</p></div>
    <StepBar step={step} max={actualMax} />
    <Controls step={step} max={actualMax} onPrevious={() => setStep(s => s - 1)} onNext={() => setStep(s => s + 1)} onReset={() => setStep(0)} />
    <p className="lab__hint">To uproszczony model budowania zwykłej aplikacji C++. Prawdziwy proces może mieć więcej etapów.</p>
  </Lab>;
}

export function WhileLab() {
  const [source, setSource] = useState('4 7 -2 0 9');
  const [step, setStep] = useState(0);
  const parsed = useMemo(() => source.trim().split(/[\s,;]+/).filter(Boolean), [source]);
  const valid = parsed.length > 0 && parsed.length <= 14 && parsed.every(n => /^[-+]?\d+$/.test(n) && Number.isSafeInteger(Number(n)));
  const numbers = valid ? parsed.map(Number) : [];
  const stopAt = numbers.indexOf(0);
  const max = stopAt >= 0 ? stopAt + 1 : numbers.length;
  const consumed = numbers.slice(0, step);
  const total = consumed.reduce((sum, value) => sum + value, 0);
  const ended = consumed.includes(0);
  return <Lab number="02" title="Pętla while — sumowanie do zera" subtitle="Zmieniaj dane wejściowe i wykonuj kolejne obroty pętli.">
    <label className="lab__label" htmlFor="while-values">Liczby oddzielone spacją (0 kończy wczytywanie)</label>
    <input id="while-values" className="lab__input" type="text" value={source} onChange={e => { setSource(e.target.value); setStep(0); }} />
    {!valid ? <p className="lab__error">Podaj od 1 do 14 poprawnych liczb całkowitych.</p> : <>
      <div className="lab__tokens">{numbers.map((v, i) => <span key={i} className={(i < step ? 'is-read' : '') + (i === step ? ' is-next' : '') + (v === 0 ? ' is-sentinel' : '')}>{v}</span>)}</div>
      <div className="lab__stats"><Stat label="Wczytane liczby" value={step} /><Stat label="Suma" value={total} highlight /></div>
      <div className="lab__notice" aria-live="polite">{ended ? 'Wczytano 0 — pętla kończy pracę. Zero nie zmienia sumy.' : step === max ? 'Koniec danych — w tym przykładzie warto dodać 0, aby zakończyć wczytywanie.' : step === 0 ? 'Naciśnij „Następny krok”, aby wczytać pierwszą liczbę.' : `Po wczytaniu ${consumed[step - 1]} suma wynosi ${total}.`}</div>
      <StepBar step={step} max={max} />
      <Controls step={step} max={max} onPrevious={() => setStep(s => s - 1)} onNext={() => setStep(s => s + 1)} onReset={() => setStep(0)} />
    </>}
  </Lab>;
}

export function ForLab() {
  const [x, setX] = useState(3);
  const [y, setY] = useState(4);
  const [step, setStep] = useState(0);
  const count = Math.abs(x);
  const added = x >= 0 ? y : -y;
  const result = Array.from({ length: step }, () => added).reduce((a, b) => a + b, 0);
  return <Lab number="03" title="Mnożenie bez operatora *" subtitle="Zobacz, jak pętla for oblicza iloczyn przez wielokrotne dodawanie lub odejmowanie.">
    <div className="lab__fields">
      <label>Wartość x (liczba powtórzeń)<input className="lab__input" type="number" min="-10" max="10" value={x} onChange={e => { setX(readInt(e.target.value, 0, -10, 10)); setStep(0); }} /></label>
      <label>Wartość y<input className="lab__input" type="number" min="-50" max="50" value={y} onChange={e => { setY(readInt(e.target.value, 0, -50, 50)); setStep(0); }} /></label>
    </div>
    <div className="lab__formula">iloczyn = iloczyn {x < 0 ? '−' : '+'} ({y})</div>
    <div className="lab__stats"><Stat label="Iteracja" value={`${step} / ${count}`} /><Stat label="iloczyn" value={result} highlight /><Stat label="Wynik docelowy" value={x * y} /></div>
    <div className="lab__notice" aria-live="polite">{count === 0 ? 'Zero powtórzeń, więc wynik jest równy 0.' : step === 0 ? `Zaczynamy od iloczyn = 0. Wykonamy ${count} powtórzeń.` : `Po ${step} ${step === 1 ? 'powtórzeniu' : 'powtórzeniach'} mamy ${result}.`}</div>
    <StepBar step={step} max={count} />
    <Controls step={step} max={count} onPrevious={() => setStep(s => s - 1)} onNext={() => setStep(s => s + 1)} onReset={() => setStep(0)} />
    <p className="lab__hint">Dla ujemnego x odejmujemy y odpowiednią liczbę razy. To dydaktyczna wersja algorytmu, ograniczona do małych danych.</p>
  </Lab>;
}

export function DebugLab() {
  const [maxN, setMaxN] = useState(4);
  const [step, setStep] = useState(0);
  const trace = useMemo(() => {
    const states = [{ line: 1, i: '—', sum: 0, note: 'Utworzono zmienną suma i ustawiono ją na 0.' }];
    for (let i = 1; i <= maxN; i++) {
      states.push({ line: 2, i, sum: (i - 1) * i / 2, note: `Sprawdzamy warunek: ${i} <= ${maxN} (prawda).` });
      states.push({ line: 3, i, sum: i * (i + 1) / 2, note: `Dodajemy ${i} do zmiennej suma.` });
    }
    states.push({ line: 2, i: maxN + 1, sum: maxN * (maxN + 1) / 2, note: `Warunek ${maxN + 1} <= ${maxN} jest fałszywy. Koniec pętli.` });
    states.push({ line: 5, i: 'poza zakresem', sum: maxN * (maxN + 1) / 2, note: 'Program wypisuje wynik.' });
    return states;
  }, [maxN]);
  const now = trace[step];
  const lines = [
    `int suma = 0;`,
    `for (int i = 1; i <= ${maxN}; i++) {`,
    `    suma += i;`,
    `}`,
    `std::cout << suma;`,
  ];
  return <Lab number="04" title="Debugger — wykonuj instrukcje krok po kroku" subtitle="Aktywna linia jest podświetlona; obok widać aktualny stan zmiennych.">
    <label className="lab__label" htmlFor="debug-n">Górna granica pętli: {maxN}</label>
    <input id="debug-n" className="lab__range" type="range" min="2" max="7" value={maxN} onChange={e => { setMaxN(Number(e.target.value)); setStep(0); }} />
    <div className="lab__split"><div className="lab__code" aria-label="Kod z wyróżnioną linią">{lines.map((line, index) => <div key={index} className={'lab__code-line' + (now.line === index + 1 ? ' is-current' : '')}><span>{index + 1}</span><code>{line}</code></div>)}</div>
      <div className="lab__watch"><strong>WATCH · zmienne</strong><Stat label="i" value={now.i} /><Stat label="suma" value={now.sum} highlight /></div>
    </div>
    <div className="lab__notice" aria-live="polite">{now.note}</div>
    <StepBar step={step} max={trace.length - 1} />
    <Controls step={step} max={trace.length - 1} onPrevious={() => setStep(s => s - 1)} onNext={() => setStep(s => s + 1)} onReset={() => setStep(0)} />
    <p className="lab__hint">Wyświetlany kod to fragment wnętrza funkcji main. Zmienna i jest lokalna dla pętli for, więc po pętli wychodzi poza zakres. To model śledzenia, nie prawdziwy debugger.</p>
  </Lab>;
}

export function FloatLab() {
  const [source, setSource] = useState('0.1');
  const typed = Number(source);
  const valid = source.trim() !== '' && Number.isFinite(typed);
  const data = useMemo(() => {
    if (!valid) return null;
    const buf = new ArrayBuffer(4);
    const view = new DataView(buf);
    view.setFloat32(0, typed, false);
    const bits = view.getUint32(0, false).toString(2).padStart(32, '0');
    const actual = view.getFloat32(0, false);
    return { sign: bits.slice(0, 1), exponent: bits.slice(1, 9), mantissa: bits.slice(9), actual, bits };
  }, [typed, valid]);
  return <Lab number="05" title="IEEE 754 — co komputer przechowuje w float?" subtitle="Wpisz liczbę i zobacz jej rzeczywiste 32-bitowe kodowanie.">
    <div className="lab__fields lab__fields--single"><label>Wartość dziesiętna<input className="lab__input" value={source} onChange={e => setSource(e.target.value)} inputMode="decimal" placeholder="Np. 0.1" /></label></div>
    <div className="lab__chips">{['0.1', '0.3', '0.5', '1.5', '-2.75'].map(v => <button key={v} type="button" className={'lab__chip' + (source === v ? ' is-active' : '')} onClick={() => setSource(v)}>{v}</button>)}</div>
    {!valid ? <p className="lab__error">Wpisz poprawną, skończoną liczbę. Do oddzielania części dziesiętnej użyj kropki.</p> : <>
      <div className="lab__bits" role="group" aria-label="32 bity liczby float">
        <div><small>Znak · 1 bit</small><code className="lab__bit lab__bit--sign">{data.sign}</code></div>
        <div><small>Wykładnik · 8 bitów</small><code className="lab__bit lab__bit--exp">{data.exponent}</code></div>
        <div><small>Ułamek · 23 bity</small><code className="lab__bit lab__bit--mantissa">{data.mantissa}</code></div>
      </div>
      <div className="lab__stats"><Stat label="Wpisano" value={source} /><Stat label="Wartość po zaokrągleniu do float" value={Number.isFinite(data.actual) ? data.actual.toPrecision(9) : String(data.actual)} highlight /></div>
      <div className="lab__notice">{!Number.isFinite(data.actual) ? 'Przekroczono zakres float32: wynik jest nieskończonością.' : Object.is(data.actual, typed) ? 'Liczba ma dokładną reprezentację w formacie float32 (dla podanego wejścia).' : 'Wystąpiło zaokrąglenie: liczba nie jest dokładnie zapisana w 32 bitach.'}</div>
    </>}
    <p className="lab__hint">Korzystamy z JavaScript DataView i formatu IEEE 754 binary32. Zapis ułamka nie jest tu mantysą w potocznym znaczeniu — to 23-bitowe pole ułamkowe.</p>
  </Lab>;
}

export function AsciiLab() {
  const [char, setChar] = useState('A');
  const code = char.length ? char.charCodeAt(0) : null;
  const ascii = code !== null && code >= 0 && code <= 127;
  return <Lab number="06" title="ASCII — litera jako liczba" subtitle="Zobacz, jak pojedynczy znak odpowiada kodowi liczbowemu.">
    <div className="lab__fields lab__fields--single"><label>Pojedynczy znak<input className="lab__input" value={char} maxLength={1} onChange={e => setChar(e.target.value)} /></label></div>
    <div className="lab__chips">{['A', 'B', 'a', '0', '9', '?'].map(ch => <button key={ch} type="button" className="lab__chip" onClick={() => setChar(ch)}>{ch}</button>)}</div>
    <div className="lab__stats"><Stat label="Znak" value={char ? `'${char}'` : '—'} /><Stat label="Kod dziesiętny" value={code === null ? '—' : code} highlight /><Stat label="Kod binarny" value={ascii ? code.toString(2).padStart(8, '0') : '—'} /></div>
    <div className="lab__notice">{code === null ? 'Wprowadź jeden znak.' : ascii ? `Znak ${char} ma kod ASCII ${code}.` : `Znak ${char} nie należy do podstawowego ASCII (0–127). Pokazany kod to jednostka UTF-16, a nie kod ASCII.`}</div>
    <p className="lab__hint">W C++ znak zapisujemy w apostrofach, np. <code>'A'</code>, a napis w cudzysłowach, np. <code>"A"</code>.</p>
  </Lab>;
}

export function StringLab() {
  const [source, setSource] = useState('STUDYLAB');
  const [selected, setSelected] = useState(2);
  const valid = /^[\x20-\x7E]*$/.test(source) && source.length <= 22;
  const index = Math.min(selected, Math.max(0, source.length - 1));
  return <Lab number="07" title="string — indeksowanie znaków" subtitle="Kliknij dowolną literę i odczytaj jej indeks oraz wartość.">
    <label className="lab__label" htmlFor="string-text">Napis (maks. 22 znaki podstawowego ASCII)</label>
    <input id="string-text" className="lab__input" value={source} onChange={e => { setSource(e.target.value); setSelected(0); }} />
    {!valid ? <p className="lab__error">Podaj tekst do 22 znaków ASCII; w tym demonstratorze pomijamy problem kodowania polskich liter.</p> : <>
      <div className="lab__string">{source.length ? [...source].map((ch, i) => <button type="button" onClick={() => setSelected(i)} key={i} className={'lab__character' + (i === index ? ' is-selected' : '')} aria-label={`Indeks ${i}: ${ch === ' ' ? 'spacja' : ch}`} aria-pressed={i === index}><strong>{ch === ' ' ? '␣' : ch}</strong><span>[{i}]</span></button>) : <span className="lab__muted">Pusty napis.</span>}</div>
      <div className="lab__stats"><Stat label="napis.size()" value={source.length} /><Stat label="Wybrany indeks" value={source.length ? index : '—'} /><Stat label="napis[indeks]" value={source.length ? (source[index] === ' ' ? 'spacja' : `'${source[index]}'`) : '—'} highlight /></div>
      <div className="lab__notice">{source.length ? `Dostępne indeksy: od 0 do ${source.length - 1}. Odczyt poza zakresem za pomocą operatora [] jest niebezpieczny.` : 'Napis pusty ma długość 0 i nie ma żadnego poprawnego indeksu.'}</div>
    </>}
    <p className="lab__hint">Uwaga: w C++ <code>std::string::size()</code> liczy bajty, nie zawsze znaki Unicode. Dlatego w tej symulacji ograniczyliśmy się do ASCII.</p>
  </Lab>;
}
