import React, {useState} from 'react';
import '../styles/physics.css';
const fmt=(x,d=2)=>Number.isFinite(x)?new Intl.NumberFormat('pl-PL',{maximumFractionDigits:d}).format(x):'—';
function Shell({name,desc,children}){return <section className="ph-lab not-content"><header><span className="ph-lab-icon">✳</span><div><b>{name}</b><small>{desc}</small></div><span className="ph-lab-status">INTERAKTYWNE</span></header><div className="ph-lab-inner">{children}</div></section>}
function Num({name,value,set,min=0,max=100,step=1,unit=''}){return <label className="ph-num"><span>{name}</span><div><input type="number" aria-label={name} min={min} max={max} step={step} value={value} onChange={e=>set(Math.max(min,Math.min(max,Number(e.target.value)||0)))}/><small>{unit}</small></div></label>}
function Slider({name,value,set,min=0,max=100,step=1,unit=''}){return <label className="ph-range"><span>{name} <strong>{fmt(value)} {unit}</strong></span><input type="range" aria-label={name} min={min} max={max} step={step} value={value} onChange={e=>set(+e.target.value)}/></label>}
function Result({name,value,info}){return <div className="ph-result"><small>{name}</small><strong>{value}</strong>{info&&<small>{info}</small>}</div>}
export function MotionLab(){const [x0,sx]=useState(0),[v0,sv]=useState(4),[a,sa]=useState(2),[t,st]=useState(3);const v=v0+a*t,x=x0+v0*t+.5*a*t*t, pts=Array.from({length:51},(_,i)=>x0+v0*(i/5)+.5*a*(i/5)**2),lo=Math.min(0,...pts),hi=Math.max(1,...pts),line=pts.map((p,i)=>`${i?'L':'M'}${30+8.8*i} ${165-(p-lo)/(hi-lo)*135}`).join(' ');return <Shell name="Położenie i prędkość" desc="Wykonuj ruch ze stałym przyspieszeniem."><div className="ph-controls"><Num name="Początkowe x" value={x0} set={sx} min={-100} unit="m"/><Num name="Początkowe v" value={v0} set={sv} min={-30} max={30} unit="m/s"/><Num name="Przyspieszenie" value={a} set={sa} min={-12} max={12} unit="m/s²"/><Slider name="Czas" value={t} set={st} max={10} step={.2} unit="s"/></div><div className="ph-results"><Result name="v(t) = v₀ + at" value={`${fmt(v)} m/s`}/><Result name="x(t) = x₀ + v₀t + at²/2" value={`${fmt(x)} m`}/></div><svg viewBox="0 0 500 192" className="ph-figure" aria-label="Wykres położenia w czasie" role="img"><path d="M30 12 V165 H477" stroke="#6b7b89" fill="none"/><path d={line} stroke="#8ed3fc" strokeWidth="3" fill="none"/><circle cx={30+t*44} cy={165-(x-lo)/(hi-lo)*135} r="6" fill="#ffd08b"/><text x="430" y="184" fontSize="12" fill="#bdcbd7">czas (s)</text></svg><p className="ph-hint">Wykres przedstawia położenie, nie sumaryczną drogę. Dla ujemnych prędkości ciało może poruszać się w przeciwnym kierunku.</p></Shell>}
export function ProjectileLab(){const [v0,sv]=useState(20),[angle,sa]=useState(35),[h,sh]=useState(0),[g,sg]=useState(9.81);const r=angle*Math.PI/180,vx=v0*Math.cos(r),vy=v0*Math.sin(r),T=(vy+Math.sqrt(vy*vy+2*g*h))/g,R=vx*T,H=h+vy*vy/(2*g),pts=Array.from({length:81},(_,i)=>{const t=T*i/80;return [vx*t,h+vy*t-.5*g*t*t]});const path=pts.map((p,i)=>`${i?'L':'M'}${35+(R? p[0]/R:0)*430} ${195-p[1]/Math.max(1,H)*160}`).join(' ');return <Shell name="Rzut ukośny" desc="Zmiana kąta, prędkości i wysokości startu."><div className="ph-controls"><Slider name="Prędkość początkowa" value={v0} set={sv} min={1} max={50} unit="m/s"/><Slider name="Kąt do poziomu" value={angle} set={sa} min={0} max={89} unit="°"/><Num name="Wysokość początkowa" value={h} set={sh} max={100} unit="m"/><Num name="g" value={g} set={sg} min={1} max={20} step={.01} unit="m/s²"/></div><svg className="ph-figure" viewBox="0 0 500 220" role="img" aria-label="Paraboliczny tor rzutu ukośnego"><path d="M25 195 H480 M35 15 V205" stroke="#657586" fill="none"/><path d={path} stroke="#8ccfff" strokeWidth="3.5" fill="none"/><circle cx="35" cy={195-h/Math.max(1,H)*160} r="6" fill="#ffd08b"/><circle cx="465" cy="195" r="6" fill="#a9f2bc"/><text x="433" y="211" fill="#c4ced9" fontSize="12">x</text></svg><div className="ph-results"><Result name="Czas lotu" value={`${fmt(T)} s`}/><Result name="Zasięg" value={`${fmt(R)} m`}/><Result name="Wysokość maksymalna" value={`${fmt(H)} m`}/></div><p className="ph-hint">Zakładamy brak oporu powietrza, oś pionową skierowaną w górę i lądowanie na poziomie y = 0.</p></Shell>}
export function CircleLab(){const [v,sv]=useState(5),[r,sr]=useState(3),[m,sm]=useState(2),[theta,st]=useState(45);const q=theta*Math.PI/180,x=250+76*Math.cos(q),y=108-76*Math.sin(q);return <Shell name="Ruch po okręgu" desc="Styczna prędkość i dośrodkowe przyspieszenie."><div className="ph-controls"><Slider name="Szybkość" value={v} set={sv} min={.5} max={15} step={.5} unit="m/s"/><Slider name="Promień" value={r} set={sr} min={.5} max={10} step={.5} unit="m"/><Num name="Masa" value={m} set={sm} min={.1} max={100} step={.5} unit="kg"/><Slider name="Pozycja" value={theta} set={st} max={360} step={10} unit="°"/></div><svg className="ph-figure" viewBox="0 0 500 220" role="img" aria-label="Prędkość styczna i przyspieszenie dośrodkowe"><circle cx="250" cy="108" r="76" stroke="#617b8a" fill="none" strokeWidth="2"/><circle cx="250" cy="108" r="4" fill="#dfebf5"/><line x1={x} y1={y} x2={x-56*Math.cos(q)} y2={y+56*Math.sin(q)} stroke="#ffb08c" strokeWidth="4"/><line x1={x} y1={y} x2={x-56*Math.sin(q)} y2={y-56*Math.cos(q)} stroke="#93dcff" strokeWidth="4"/><circle cx={x} cy={y} r="10" fill="#ccf6d9"/><text x="12" y="210" fontSize="12" fill="#c8d5dd">Pomarańczowy: przyspieszenie · Błękitny: prędkość</text></svg><div className="ph-results"><Result name="a = v²/R" value={`${fmt(v*v/r)} m/s²`}/><Result name="F = mv²/R" value={`${fmt(m*v*v/r)} N`}/><Result name="ω = v/R" value={`${fmt(v/r)} rad/s`}/></div></Shell>}
export function ForceLab(){const [m,sm]=useState(4),[F1,s1]=useState(20),[F2,s2]=useState(8);return <Shell name="II zasada Newtona" desc="Dodatni zwrot osi x w prawo."><div className="ph-controls"><Num name="Masa" value={m} set={sm} min={.1} max={1000} unit="kg"/><Num name="Siła w prawo" value={F1} set={s1} max={300} unit="N"/><Num name="Siła w lewo" value={F2} set={s2} max={300} unit="N"/></div><svg className="ph-figure" viewBox="0 0 500 155" role="img" aria-label="Klocek z dwiema siłami przeciwnie skierowanymi"><rect x="213" y="42" width="74" height="65" rx="11" fill="#1d3e50" stroke="#75c8fe"/><text x="250" y="79" fill="white" textAnchor="middle">m</text><path d={`M213 77 H${213-Math.min(F2*1.7,170)} M287 77 H${287+Math.min(F1*1.7,170)}`} stroke="#ffca85" strokeWidth="4"/><text x="24" y="139" fontSize="14" fill="#ffca85">← {fmt(F2)} N</text><text x="372" y="139" fontSize="14" fill="#ffca85">{fmt(F1)} N →</text></svg><div className="ph-results"><Result name="Wypadkowa" value={`${fmt(F1-F2)} N`}/><Result name="Przyspieszenie" value={`${fmt((F1-F2)/m)} m/s²`} info="Wartość ze znakiem określa zwrot"/></div></Shell>}
export function Newton3Lab(){const [F,sF]=useState(40);return <Shell name="III zasada Newtona" desc="Dwie siły działają na różne ciała."><Slider name="Siła kontaktu" value={F} set={sF} max={150} step={5} unit="N"/><svg className="ph-figure" viewBox="0 0 500 155" aria-label="Dwa ciała i siły akcji i reakcji" role="img"><rect x="105" y="48" width="91" height="63" rx="10" fill="#29485f" stroke="#93d9fc"/><rect x="304" y="48" width="91" height="63" rx="10" fill="#3b503d" stroke="#b4e6c1"/><text x="150" y="84" textAnchor="middle" fill="white">A</text><text x="350" y="84" textAnchor="middle" fill="white">B</text><path d={`M197 58 H${197+F*.53} M303 103 H${303-F*.53}`} stroke="#ffb980" strokeWidth="4"/><text x="210" y="145" fontSize="13" fill="#d3dce9">Przeciwne zwroty</text></svg><div className="ph-results"><Result name="A działa na B" value={`${fmt(F)} N →`}/><Result name="B działa na A" value={`← ${fmt(F)} N`}/></div></Shell>}
export function MomentumLab(){const [m1,sm1]=useState(2),[m2,sm2]=useState(1),[v1,sv1]=useState(3),[v2,sv2]=useState(0);const p=m1*v1+m2*v2,v=p/(m1+m2),E0=.5*m1*v1*v1+.5*m2*v2*v2,E1=.5*(m1+m2)*v*v;return <Shell name="Zachowanie pędu" desc="Dwa wózki zderzają się i łączą, bez siły zewnętrznej."><div className="ph-controls"><Num name="Masa 1" value={m1} set={sm1} min={.1} max={100} step={.5} unit="kg"/><Num name="Prędkość 1" value={v1} set={sv1} min={-20} max={20} step={.5} unit="m/s"/><Num name="Masa 2" value={m2} set={sm2} min={.1} max={100} step={.5} unit="kg"/><Num name="Prędkość 2" value={v2} set={sv2} min={-20} max={20} step={.5} unit="m/s"/></div><div className="ph-results"><Result name="Pęd całkowity" value={`${fmt(p)} kg·m/s`}/><Result name="Prędkość po złączeniu" value={`${fmt(v)} m/s`}/><Result name="Zmiana energii kinetycznej" value={`${fmt(E1-E0)} J`}/></div><p className="ph-hint">Zderzenie całkowicie nieelastyczne: pęd układu jest zachowany, energia kinetyczna na ogół nie.</p></Shell>}
export function AngularLab(){const [m,sm]=useState(2),[r,sr]=useState(3),[v,sv]=useState(4),[a,sa]=useState(90);return <Shell name="Moment pędu" desc="Jak odległość i kąt wpływają na wynik."><div className="ph-controls"><Num name="Masa" value={m} set={sm} min={.1} max={100} step={.5} unit="kg"/><Num name="Odległość od osi" value={r} set={sr} min={.1} max={20} step={.5} unit="m"/><Num name="Szybkość" value={v} set={sv} max={100} step={.5} unit="m/s"/><Slider name="Kąt r–v" value={a} set={sa} max={180} step={5} unit="°"/></div><div className="ph-results"><Result name="|L| = rmv sin θ" value={`${fmt(m*r*v*Math.sin(a*Math.PI/180))} kg·m²/s`}/><Result name="I = mr²" value={`${fmt(m*r*r)} kg·m²`}/></div></Shell>}
export function FrictionLab(){const [m,sm]=useState(5),[muS,ss]=useState(.4),[muK,sk]=useState(.2),[F,sF]=useState(10);const N=m*9.81,lim=muS*N,move=F>lim,acc=move?(F-muK*N)/m:0;return <Shell name="Tarcie statyczne i kinetyczne" desc="Ciało startuje ze spoczynku na poziomym stole."><div className="ph-controls"><Num name="Masa" value={m} set={sm} min={.1} max={100} unit="kg"/><Num name="Współczynnik μs" value={muS} set={ss} min={0} max={2} step={.05}/><Num name="Współczynnik μk" value={muK} set={sk} min={0} max={2} step={.05}/><Slider name="Siła pozioma" value={F} set={sF} max={100} unit="N"/></div><div className="ph-results"><Result name="Maksymalne tarcie statyczne" value={`${fmt(lim)} N`}/><Result name="Stan" value={move?'Poślizg':'Spoczynek'}/><Result name="Przyspieszenie w modelu" value={`${fmt(acc)} m/s²`}/></div><p className="ph-hint">Założenia uproszczone: μk ≤ μs, ruch wyłącznie poziomy, brak innych sił. Gdy F ≤ μsN, tarcie statyczne równoważy F (nie musi osiągnąć μsN).</p></Shell>}
export function ThreeBlocksLab(){const [m,sm]=useState(2),[F,sF]=useState(60),[mu,sMu]=useState(.15);const M=6*m,fr=mu*M*9.81;return <Shell name="Trzy klocki — ODRĘBNY przykład" desc="Poglądowy model, nie odtworzenie niekompletnego zadania ze zdjęcia 9."><div className="ph-controls"><Num name="Masa podstawowa m" value={m} set={sm} min={.1} max={100} unit="kg"/><Num name="Siła ciągnąca F" value={F} set={sF} max={500} unit="N"/><Num name="μk przy poślizgu" value={mu} set={sMu} max={1} step={.05}/></div><svg className="ph-figure" viewBox="0 0 500 160" role="img" aria-label="Trzy klocki m, 2m i 3m połączone na poziomej powierzchni"><line x1="25" y1="127" x2="478" y2="127" stroke="#617482"/><rect x="60" y="66" width="85" height="61" rx="8" fill="#204053" stroke="#91d6ff"/><rect x="185" y="66" width="85" height="61" rx="8" fill="#204d46" stroke="#9ee5cd"/><rect x="310" y="66" width="85" height="61" rx="8" fill="#3a3656" stroke="#ceb8ff"/><path d="M145 96 H185 M270 96 H310 M395 96 H472" stroke="#f4be88" strokeWidth="3"/><text x="103" y="101" textAnchor="middle" fill="#fff">m</text><text x="228" y="101" textAnchor="middle" fill="#fff">2m</text><text x="353" y="101" textAnchor="middle" fill="#fff">3m</text></svg><div className="ph-results"><Result name="Łączna masa" value={`${fmt(M)} kg`}/><Result name="Tarcie przy poślizgu" value={`${fmt(fr)} N`}/><Result name="a przy wspólnym ruchu" value={`${fmt((F-fr)/M)} m/s²`}/></div><p className="ph-hint">Wszystkie bloki już ślizgają się w prawo, a ich przyspieszenia są jednakowe. Wynik ujemny oznacza hamowanie. Aby sprawdzić ruszanie ze spoczynku, trzeba znać μs.</p></Shell>}
